<label class="<%= wrapper_classes %>">
  <span class="<%= cn(track_classes, checked_track_classes) %>">
    <%= @form.check_box @method, input_options, @on_value, @off_value %>
    <span aria-hidden="true" class="<%= track_background_classes %>"></span>
    <span class="<%= knob_classes %>">
      <span aria-hidden="true" class="ui-toggle-icon-off absolute inset-0 flex items-center justify-center">
        <%= helpers.icon "x", class: "#{knob_icon_classes}" %>
      </span>
      <span aria-hidden="true" class="ui-toggle-icon-on absolute inset-0 flex items-center justify-center">
        <%= helpers.icon "check", class: "#{knob_icon_classes}" %>
      </span>
    </span>
  </span>
  <span class="space-y-1">
    <span class="<%= label_classes %>"><%= @label %></span>
    <% if @description.present? %>
      <span class="<%= description_classes %>"><%= @description %></span>
    <% end %>
  </span>
</label>
