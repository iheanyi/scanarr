<label class="<%= wrapper_classes %>">
  <span class="<%= cn(track_classes, checked_track_classes) %>">
    <span class="<%= knob_classes %>"></span>
    <%= @form.check_box @method, input_options, @on_value, @off_value %>
  </span>
  <span class="space-y-1">
    <span class="block text-sm text-foreground"><%= @label %></span>
    <% if @description.present? %>
      <span class="block text-xs text-muted-2 text-pretty"><%= @description %></span>
    <% end %>
  </span>
</label>
