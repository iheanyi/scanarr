<div class="<%= flash_classes %>"
     role="<%= aria_role %>"
     aria-live="<%= aria_live %>"
     <% if dismissible? %>data-controller="flash-dismiss"<% end %>>
  <div class="flex items-center justify-between gap-2">
    <div>
      <% if content.present? %>
        <%= content %>
      <% else %>
        <%= message %>
      <% end %>
    </div>
    <% if dismissible? %>
      <button type="button"
              data-action="flash-dismiss#dismiss"
              class="shrink-0 rounded-md p-1 opacity-70 hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-current"
              aria-label="Dismiss">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    <% end %>
  </div>
</div>
