<div class="<%= @label.present? || @hint.present? ? "space-y-1" : "" %>">
  <% if @label.present? %>
    <%= @form.label @method, @label, class: "text-sm text-muted" %>
  <% end %>
  <div class="<%= has_leading_icon? ? "grid grid-cols-1" : "relative #{@full_width ? "" : "inline-block"}" %>">
    <%= @form.select @method,
                     options_for_select(@options, @selected),
                     select_options,
                     select_attributes %>
    <% if has_leading_icon? %>
      <%= helpers.icon leading_icon_name, class: "pointer-events-none col-start-1 row-start-1 z-10 self-center text-muted #{leading_icon_classes}" %>
    <% end %>
    <svg xmlns="http://www.w3.org/2000/svg" class="pointer-events-none <%= has_leading_icon? ? chevron_icon_classes : "absolute top-1/2 -translate-y-1/2 text-muted #{icon_classes}" %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
  <% if @hint.present? %>
    <p class="text-xs text-muted-2 text-pretty"><%= @hint %></p>
  <% end %>
</div>
