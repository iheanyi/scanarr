<div class="<%= wrapper_classes %>"
     data-controller="multi-select"
     data-multi-select-all-label-value="<%= @all_label %>"
     data-multi-select-none-label-value="<%= none_label %>"
     data-multi-select-max-chips-value="<%= @max_chips %>">
  <% if @label.present? %>
    <span class="block text-xs font-medium text-muted-2"><%= @label %></span>
  <% end %>

  <div class="relative w-full max-w-full sm:inline-flex sm:w-auto">
    <button type="button"
            class="inline-flex w-full min-w-0 items-center justify-between gap-2 rounded-md border border-border bg-surface-2 px-3 py-1.5 text-xs font-semibold text-foreground hover:border-border-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-background sm:min-w-44 sm:w-auto"
            aria-haspopup="listbox"
            aria-controls="<%= panel_id %>"
            aria-expanded="false"
            data-action="click->multi-select#toggle"
            data-multi-select-target="trigger">
      <span class="flex min-w-0 items-center gap-1.5">
        <span class="truncate" data-multi-select-target="summary"><%= trigger_label %></span>
        <span class="<%= secondary_label.present? ? "" : "hidden " %>text-[10px] font-medium text-muted-2" data-multi-select-target="count"><%= secondary_label %></span>
      </span>
      <span class="shrink-0 text-muted-2" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </span>
    </button>

    <div id="<%= panel_id %>"
         class="absolute right-0 z-10 mt-2 w-full min-w-[14rem] rounded-md border border-border bg-surface shadow-lg hidden sm:w-[min(22rem,calc(100vw-2rem))]"
         data-multi-select-target="panel"
         role="listbox"
         aria-multiselectable="true">
      <div class="border-b border-border p-2.5">
        <input type="text"
               placeholder="<%= @filter_placeholder %>"
               class="w-full rounded-md border border-border bg-surface-2 px-3 py-2 text-sm text-foreground placeholder:text-muted-2 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/30"
               data-multi-select-target="filter"
               data-action="input->multi-select#filter">
      </div>
      <div class="max-h-64 overflow-y-auto py-1">
        <% @options.each do |label, value| %>
          <label class="flex w-full items-center gap-2 px-3 py-2 text-left text-xs text-foreground hover:bg-surface-2"
                 data-multi-select-target="option"
                 data-option-label="<%= label.to_s.downcase %>"
                 role="option"
                 aria-selected="<%= @selected.include?(value.to_s) %>">
            <%= check_box_tag checkbox_name,
                              value,
                              @selected.include?(value.to_s),
                              class: "rounded border-border bg-surface-2 text-accent focus:ring-accent",
                              data: {
                                multi_select_target: "checkbox",
                                action: "change->multi-select#changed",
                                label: label
                              } %>
            <span class="truncate"><%= label %></span>
          </label>
        <% end %>
      </div>
    </div>
  </div>

  <% if @hint.present? %>
    <p class="text-xs text-muted-2 text-pretty"><%= @hint %></p>
  <% end %>
</div>
