<div class="<%= wrapper_classes %>"
     data-controller="multi-select"
     data-multi-select-all-label-value="<%= @all_label %>"
     data-multi-select-max-chips-value="<%= @max_chips %>">
  <div class="flex items-center justify-between">
    <% if @label.present? %>
      <span class="text-sm text-zinc-300"><%= @label %></span>
    <% end %>
    <span class="text-xs text-zinc-500" data-multi-select-target="count"><%= count_label %></span>
  </div>

  <div class="relative">
    <button type="button"
            class="flex w-full items-center justify-between gap-3 rounded-md border border-zinc-800 bg-zinc-950 px-3 py-2 text-left text-sm text-zinc-100"
            aria-controls="<%= panel_id %>"
            aria-expanded="false"
            data-action="click->multi-select#toggle"
            data-multi-select-target="trigger">
      <div class="flex flex-wrap items-center gap-1.5" data-multi-select-target="chips"></div>
      <span class="text-xs text-zinc-500" data-multi-select-target="empty">Select sources</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <div id="<%= panel_id %>"
         class="absolute z-10 mt-2 w-full rounded-md border border-zinc-800 bg-zinc-950 p-3 shadow-lg hidden"
         data-multi-select-target="panel">
      <input type="text"
             placeholder="<%= @filter_placeholder %>"
             class="w-full rounded-md border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100 placeholder:text-zinc-600"
             data-multi-select-target="filter"
             data-action="input->multi-select#filter" />

      <div class="mt-3 max-h-56 overflow-y-auto space-y-2">
        <% @options.each do |label, value| %>
          <label class="flex items-center gap-2 rounded-md border border-zinc-800/80 bg-zinc-900/40 px-3 py-2 text-sm text-zinc-300"
                 data-multi-select-target="option"
                 data-option-label="<%= label.to_s.downcase %>">
            <%= check_box_tag checkbox_name,
                              value,
                              @selected.include?(value.to_s),
                              class: "rounded border-zinc-700 bg-zinc-950 text-emerald-500 focus:ring-emerald-500 focus:ring-offset-zinc-950",
                              data: {
                                multi_select_target: "checkbox",
                                action: "change->multi-select#update",
                                label: label
                              } %>
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
    </div>
  </div>

  <% if @hint.present? %>
    <p class="text-xs text-zinc-500 text-pretty"><%= @hint %></p>
  <% end %>
</div>
