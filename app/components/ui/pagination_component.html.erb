<nav class="mt-10 flex items-center justify-between border-t border-border pb-8 pt-4">
  <%# Left: Previous button %>
  <div class="w-28">
    <% if @collection.first_page? %>
      <span class="inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm text-muted-2 cursor-not-allowed">
        <%= helpers.icon "chevron-left", class: "h-4 w-4" %>
        Previous
      </span>
    <% else %>
      <%= link_to page_url(@collection.prev_page), class: "inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm text-muted hover:text-foreground hover:bg-surface-2 transition-colors", data: { turbo_action: "advance" } do %>
        <%= helpers.icon "chevron-left", class: "h-4 w-4" %>
        Previous
      <% end %>
    <% end %>
  </div>

  <%# Center: Page numbers %>
  <div class="flex items-center gap-0.5">
    <% page_numbers.each do |item| %>
      <% if item == :gap %>
        <span class="px-1.5 py-2 text-sm text-muted-2">&hellip;</span>
      <% elsif item == current_page %>
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-accent text-sm font-medium text-accent-foreground"><%= item %></span>
      <% else %>
        <%= link_to item, page_url(item), class: "inline-flex h-8 w-8 items-center justify-center rounded-md text-sm text-muted hover:text-foreground hover:bg-surface-2 transition-colors", data: { turbo_action: "advance" } %>
      <% end %>
    <% end %>
  </div>

  <%# Right: Next button %>
  <div class="w-28 text-right">
    <% if @collection.last_page? %>
      <span class="inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm text-muted-2 cursor-not-allowed">
        Next
        <%= helpers.icon "chevron-right", class: "h-4 w-4" %>
      </span>
    <% else %>
      <%= link_to page_url(@collection.next_page), class: "inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm text-muted hover:text-foreground hover:bg-surface-2 transition-colors", data: { turbo_action: "advance" } do %>
        Next
        <%= helpers.icon "chevron-right", class: "h-4 w-4" %>
      <% end %>
    <% end %>
  </div>
</nav>
