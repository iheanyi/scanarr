<div>
  <% if label.present? %>
    <label class="text-sm font-medium text-foreground" for="<%= input_id %>">
      <%= label %>
      <% if required %>
        <span class="text-error">*</span>
      <% end %>
    </label>
  <% end %>

  <% if use_form_helper? %>
    <%= form.text_field(method, **input_attributes) %>
  <% else %>
    <input <%= tag.attributes(input_attributes) %>>
  <% end %>

  <% if hint.present? && error.blank? %>
    <p id="<%= hint_id %>" class="mt-1.5 text-xs text-muted-2"><%= hint %></p>
  <% end %>

  <% if error.present? %>
    <p id="<%= error_id %>" class="mt-1.5 text-xs text-error" role="alert"><%= error %></p>
  <% end %>
</div>
