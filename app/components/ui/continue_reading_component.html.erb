<%= link_to reader_path, class: "group flex min-w-0 items-center gap-4 rounded-xl border border-border bg-surface p-3 transition-colors hover:border-accent/50 focus-visible:outline-2 focus-visible:outline-accent", aria: { label: "Continue #{series.canonical_title}, chapter #{chapter.chapter_number}" } do %>
  <%= render UI::SeriesCoverComponent.new(
    url: series.cover_image_url,
    fallback_url: series.cover_fallback_url,
    alt: "",
    size: :sm,
    rounded: :md,
    class: "shrink-0"
  ) %>
  <div class="min-w-0 flex-1 space-y-2">
    <h3 class="line-clamp-2 text-sm font-semibold leading-snug group-hover:text-accent"><%= series.canonical_title %></h3>
    <p class="text-sm text-muted">Chapter <%= chapter.chapter_number %></p>
    <% if progress.page_count.positive? %>
      <p class="text-xs text-muted tabular-nums">Page <%= current_page %> of <%= progress.page_count %></p>
      <%= render UI::ProgressBarComponent.new(value: current_page, max: progress.page_count, color: :info, size: :xs) %>
    <% end %>
  </div>
  <%= helpers.icon "chevron-right", class: "h-4 w-4 shrink-0 text-muted", aria: { hidden: true } %>
<% end %>
