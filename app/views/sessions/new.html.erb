<div class="flex min-h-screen items-center justify-center px-4">
  <div class="w-full max-w-sm space-y-8">
    <div class="text-center">
      <h1 class="text-3xl font-semibold text-foreground">Scanarr</h1>
      <p class="mt-2 text-sm text-muted">Sign in to continue</p>
    </div>

    <%= render UI::FlashMessageComponent.new(variant: :danger, message: flash[:alert]) %>

    <%= form_with url: login_path, method: :post, class: "space-y-6" do |f| %>
      <div class="space-y-4">
        <%= render UI::InputComponent.new(
          name: "username",
          label: "Username",
          required: true,
          autocomplete: "username",
          autofocus: true,
          class: "mt-1 rounded-lg px-4"
        ) %>

        <%= render UI::InputComponent.new(
          name: "password",
          type: "password",
          label: "Password",
          required: true,
          autocomplete: "current-password",
          class: "mt-1 rounded-lg px-4"
        ) %>
      </div>

      <%= render UI::ButtonComponent.new(variant: :primary, type: "submit", size: :lg, class: "w-full") do %>
        Sign in
      <% end %>
    <% end %>

    <% if SiteSetting.registration_enabled? %>
      <p class="text-center text-sm text-muted">
        Don't have an account?
        <%= link_to "Sign up", register_path, class: "text-accent hover:text-accent/80" %>
      </p>
    <% end %>
  </div>
</div>
