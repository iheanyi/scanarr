<div class="flex min-h-screen items-center justify-center px-4">
  <div class="w-full max-w-sm space-y-8">
    <div class="text-center">
      <h1 class="text-3xl font-semibold text-foreground">Scanarr</h1>
      <p class="mt-2 text-sm text-muted">Sign in to continue</p>
    </div>

    <%= render UI::FlashMessageComponent.new(variant: :danger, message: flash[:alert]) %>

    <%= form_with url: login_path, method: :post, class: "space-y-6" do |f| %>
      <div class="space-y-4">
        <div>
          <label for="username" class="block text-sm font-medium text-muted">Username</label>
          <input type="text"
                 name="username"
                 id="username"
                 autocomplete="username"
                 required
                 autofocus
                 class="mt-1 block w-full rounded-lg border border-border bg-surface-2 px-4 py-2.5 text-foreground placeholder:text-muted-2 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent">
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-muted">Password</label>
          <input type="password"
                 name="password"
                 id="password"
                 autocomplete="current-password"
                 required
                 class="mt-1 block w-full rounded-lg border border-border bg-surface-2 px-4 py-2.5 text-foreground placeholder:text-muted-2 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent">
        </div>
      </div>

      <%= render UI::ButtonComponent.new(variant: :primary, type: "submit", size: :lg, class: "w-full") do %>
        Sign in
      <% end %>
    <% end %>

    <% if SiteSetting.registration_enabled? %>
      <p class="text-center text-sm text-muted">
        Don't have an account?
        <%= link_to "Sign up", register_path, class: "text-accent hover:text-accent/80" %>
      </p>
    <% end %>
  </div>
</div>
