<div class="space-y-8">
  <section class="scanarr-hero-panel rounded-[2rem] p-5 md:p-6">
    <%= render UI::PageHeaderComponent.new(title: "Library") do |header| %>
      <% header.with_description_content do %>
        <div class="flex flex-wrap items-center gap-2 text-sm text-muted tabular-nums">
          <span class="scanarr-stat-chip inline-flex items-center gap-1 rounded-full px-3 py-1.5">
            <span class="font-semibold text-foreground"><%= number_with_delimiter(@total_series) %></span>
            <span class="text-muted-2">series</span>
          </span>
          <span class="scanarr-stat-chip inline-flex items-center gap-1 rounded-full px-3 py-1.5">
            <span class="font-semibold text-foreground"><%= number_with_delimiter(@total_chapters) %></span>
            <span class="text-muted-2">chapters</span>
          </span>
          <span class="scanarr-stat-chip inline-flex items-center gap-1 rounded-full px-3 py-1.5">
            <span class="font-semibold text-foreground"><%= number_with_delimiter(@downloaded_chapters) %></span>
            <span class="text-muted-2">downloaded</span>
          </span>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="scanarr-subtle-panel rounded-[2rem] p-4 md:p-5">
    <%= form_with url: library_path,
                  method: :get,
                  class: "space-y-3",
                  data: { turbo_frame: "library-content" } do |f| %>
    <div class="flex items-center gap-3 overflow-x-auto pb-1">
      <div class="shrink-0" data-controller="auto-submit">
        <%= render UI::SelectComponent.new(
          form: f,
          method: :status,
          options: @status_options,
          selected: @status,
          full_width: false,
          class: "h-9 w-40",
          aria: { label: "Filter status" },
          data: { action: "change->auto-submit#submit" }
        ) %>
      </div>

      <div class="shrink-0" data-controller="auto-submit">
        <%= render UI::SelectComponent.new(
          form: f,
          method: :sort_by,
          options: @sort_options.map { |key, label| [ label, key ] },
          selected: @sort_by,
          full_width: false,
          class: "h-9 w-44",
          aria: { label: "Sort series" },
          data: { action: "change->auto-submit#submit" }
        ) %>
      </div>

      <div class="min-w-72 flex-1" data-controller="auto-submit" data-auto-submit-delay-value="200">
        <%= render UI::SearchInputComponent.new(
          form: f,
          name: :q,
          value: params[:q],
          placeholder: "Filter series...",
          class: "h-9",
          data: { action: "input->auto-submit#submitDebounced" }
        ) %>
      </div>

      <div class="shrink-0 ml-auto">
        <%= render UI::ButtonComponent.new(
          variant: :ghost,
          href: library_random_path(
            status: @status.presence,
            q: params[:q],
            sort_by: @sort_by,
            source_ids: @source_ids.presence,
            genres: @genres.presence
          )
        ) do %>
          <%= icon "shuffle", class: "h-4 w-4" %>
          Random
        <% end %>
      </div>
    </div>

    <% advanced_filters_active = @source_ids.present? || @genres.present? %>
    <details class="rounded-[1.25rem] border border-border/70 bg-background/60 p-3" <%= "open" if advanced_filters_active %>>
      <summary class="cursor-pointer select-none text-sm font-medium text-muted hover:text-foreground">
        Advanced filters
      </summary>
      <div class="mt-3 grid gap-3 md:grid-cols-3">
        <div data-controller="auto-submit" data-auto-submit-delay-value="150" data-action="change->auto-submit#submitDebounced">
          <%= render UI::MultiSelectComponent.new(
            name: :source_ids,
            options: @source_options,
            selected: @source_ids,
            label: "Sources",
            filter_placeholder: "Filter sources",
            all_label: "All sources",
            max_chips: 2
          ) %>
        </div>

        <div data-controller="auto-submit" data-auto-submit-delay-value="150" data-action="change->auto-submit#submitDebounced">
          <%= render UI::MultiSelectComponent.new(
            name: :genres,
            options: @genre_options.map { |genre| [ genre.tr("_-", "  ").squish.titleize, genre ] },
            selected: @genres,
            label: "Genres",
            filter_placeholder: "Filter genres",
            all_label: "All genres",
            max_chips: 2
          ) %>
        </div>

        <div class="flex items-end">
          <%= link_to "Clear advanced filters",
                      library_path(status: @status.presence, q: params[:q], sort_by: @sort_by),
                      class: "inline-flex h-9 items-center rounded-md border border-border px-3 text-sm text-muted hover:text-foreground hover:border-muted" %>
        </div>
      </div>
    </details>
    <% end %>
  </section>

  <%= turbo_frame_tag "library-content", class: "has-loading-overlay", autoscroll: true, data: { autoscroll_block: "start" } do %>
    <div class="space-y-4">
    <% if @series.empty? %>
      <% has_filters = params[:q].present? || @status.present? || @source_ids.present? || @genres.present? %>
      <%= render UI::EmptyStateComponent.new(
        title: has_filters ? "No series match your filters" : "Your library is empty",
        description: has_filters ? nil : "Import series from a source to get started."
      ) do |empty| %>
        <% empty.with_icon do %>
          <%= icon "book-open", class: "h-6 w-6" %>
        <% end %>
        <% empty.with_action do %>
          <% if has_filters %>
            <%= link_to "Clear filters", library_path, class: "text-sm text-info hover:text-info" %>
          <% else %>
            <%= link_to "Browse sources", root_path, class: "text-sm text-info hover:text-info" %>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <!-- Grid of series -->
      <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
        <% @series.each do |series| %>
          <% progress = series.download_progress %>
          <% source = series.primary_source %>
          <% series_path = source ? library_series_path(series_slug: series.to_param) : "#" %>
          <% followed = @followed_library_series_ids.include?(series.library_series_id) %>
          <% unread = @status == "following" ? @unread_counts&.dig(series.library_series_id).to_i : 0 %>

          <% cache [ series, series.cover_image_url, progress[:downloaded], progress[:total], progress[:downloading], source&.slug, followed, unread, @status ] do %>
          <%= link_to series_path, class: "group/series flex min-w-0 flex-col", data: { turbo_frame: "_top" } do %>
            <%# Cover zone %>
            <div class="scanarr-cover-tile transition-all duration-200 group-hover/series:-translate-y-1 group-hover/series:border-accent/30">
              <%= render UI::SeriesCoverComponent.new(
                url: series.cover_image_url,
                alt: series.canonical_title,
                size: :full,
                aspect: "2/3",
                rounded: :lg,
                framed: false,
                image_class: "transition duration-300 group-hover/series:scale-105",
                class: "scanarr-cover-tile-media h-full w-full bg-transparent"
              ) do |cover| %>
                <% cover.with_fallback do %>
                  <div class="flex h-full w-full items-center justify-center bg-surface-2/70">
                    <%= icon "book-open", class: "h-12 w-12 text-muted-2", stroke_width: "1.5" %>
                  </div>
                <% end %>
                <% cover.with_overlay do %>
                  <%# Hover overlay with title and description %>
                  <div class="pointer-events-none absolute inset-0 flex flex-col justify-end bg-background/88 p-3 opacity-0 transition-opacity duration-200 group-hover/series:opacity-100">
                    <h3 class="text-sm font-semibold leading-tight text-white line-clamp-2">
                      <%= series.canonical_title %>
                    </h3>
                    <% if series.display_author.present? %>
                      <p class="mt-0.5 truncate text-xs text-white/70"><%= series.display_author %></p>
                    <% end %>
                    <% if series.description.present? %>
                      <p class="mt-1 line-clamp-3 text-xs leading-snug text-white/60"><%= strip_tags(series.description) %></p>
                    <% end %>
                  </div>

                  <%# Progress bar (always visible when applicable) %>
                  <% if progress[:total] > 0 %>
                    <div class="absolute inset-x-0 bottom-0 bg-background/90 p-2 transition-opacity duration-200 group-hover/series:opacity-0">
                      <div class="flex items-center justify-between text-xs">
                        <span class="<%= progress[:downloaded] == progress[:total] ? "text-success" : "text-muted" %>">
                          <%= progress[:downloaded] %>/<%= progress[:total] %>
                        </span>
                        <% if progress[:downloading] > 0 %>
                          <span class="flex items-center gap-1 text-warning">
                            <%= render UI::SpinnerComponent.new(size: :xs, class: "text-warning") %>
                            <%= progress[:downloading] %>
                          </span>
                        <% end %>
                      </div>
                      <div class="mt-1">
                        <%= render UI::ProgressBarComponent.new(
                          value: progress[:downloaded],
                          max: progress[:total],
                          color: progress[:downloaded] == progress[:total] ? :success : :info,
                          size: :xs
                        ) %>
                      </div>
                    </div>
                  <% end %>

                  <%# Top badges (always visible) %>
                  <div class="absolute right-2 top-2 flex items-center gap-1">
                    <% if @status == "following" && unread > 0 %>
                      <span class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-accent px-1 text-[10px] font-bold text-accent-foreground">
                        <%= unread > 9 ? "9+" : unread %>
                      </span>
                    <% end %>
                    <% if followed %>
                      <span class="rounded bg-accent/80 px-1.5 py-0.5 text-[10px] font-medium text-accent-foreground backdrop-blur-sm" title="Following">
                        <%= icon "eye", class: "inline h-3 w-3" %>
                      </span>
                    <% end %>
                    <% if source %>
                      <span class="rounded bg-background/70 px-1.5 py-0.5 text-[10px] font-medium text-muted backdrop-blur-sm">
                        <%= source.name %>
                      </span>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>

            <%# Meta zone %>
            <div class="mt-3 min-w-0 space-y-1.5 px-1">
              <h3 class="truncate text-sm font-medium text-foreground transition-colors group-hover/series:text-accent">
                <%= series.canonical_title %>
              </h3>
              <% if series.display_author.present? %>
                <p class="truncate text-xs text-muted-2"><%= series.display_author %></p>
              <% end %>
              <% if @status == "following" && @last_checked&.dig(series.id) %>
                <p class="truncate text-xs text-muted-2">
                  Checked <%= time_ago_in_words(@last_checked[series.id]) %> ago
                </p>
              <% end %>
            </div>
          <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% unless @series.empty? %>
      <%= render UI::PaginationComponent.new(
        collection: @series,
        base_path: library_path,
        params: { status: @status.presence, q: params[:q], sort_by: @sort_by, source_ids: @source_ids.presence, genres: @genres.presence },
        turbo_frame: "library-content"
      ) %>
    <% end %>
    </div>
  <% end %>
</div>
