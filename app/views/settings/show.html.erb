<div class="space-y-8 max-w-3xl">
  <%= render UI::PageHeaderComponent.new(
    title: "Settings",
    description: "Configure global defaults and manage sources."
  ) %>

  <%# Account %>
  <section class="rounded-lg border border-border bg-surface p-6 space-y-6">
    <div>
      <h2 class="text-lg font-semibold">Account</h2>
      <p class="text-sm text-muted mt-1">Manage your password and API key.</p>
    </div>

    <%# Password Change %>
    <div class="space-y-4">
      <h3 class="text-sm font-semibold text-foreground">Change Password</h3>
      <%= form_with url: settings_password_path, method: :patch, class: "space-y-3", data: { turbo_submits_with: "Saving..." } do |f| %>
        <div>
          <label for="current_password" class="block text-sm text-muted">Current Password</label>
          <input type="password" name="current_password" id="current_password" required
                 autocomplete="current-password"
                 class="mt-1 block w-full rounded-md border border-border bg-surface-2 px-3 py-2 text-sm text-foreground focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/30">
        </div>
        <div>
          <label for="new_password" class="block text-sm text-muted">New Password</label>
          <input type="password" name="new_password" id="new_password" required minlength="8"
                 autocomplete="new-password"
                 class="mt-1 block w-full rounded-md border border-border bg-surface-2 px-3 py-2 text-sm text-foreground focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/30">
        </div>
        <div>
          <label for="new_password_confirmation" class="block text-sm text-muted">Confirm New Password</label>
          <input type="password" name="new_password_confirmation" id="new_password_confirmation" required
                 autocomplete="new-password"
                 class="mt-1 block w-full rounded-md border border-border bg-surface-2 px-3 py-2 text-sm text-foreground focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/30">
        </div>
        <div>
          <%= render UI::ButtonComponent.new(label: "Update Password", variant: :primary, size: :sm, type: "submit") %>
        </div>
      <% end %>
    </div>

    <hr class="border-border">

    <%# API Key %>
    <div class="space-y-3">
      <h3 class="text-sm font-semibold text-foreground">API Key</h3>
      <p class="text-xs text-muted">Use this key to authenticate API requests via the <code class="text-muted">X-Api-Key</code> header.</p>

      <div id="api-key-display">
        <%= render "settings/api_key", user: @user %>
      </div>

      <%= button_to settings_regenerate_api_key_path,
            method: :post,
            class: "inline-flex items-center gap-1.5 text-sm text-danger hover:text-danger/80",
            data: { turbo_confirm: "Regenerate API key? The old key will stop working immediately." } do %>
        Regenerate Key
      <% end %>
    </div>
  </section>

  <%# Reading Preferences %>
  <section class="rounded-lg border border-border bg-surface p-6 space-y-4">
    <div>
      <h2 class="text-lg font-semibold">Reading Preferences</h2>
      <p class="text-sm text-muted mt-1">Set your default reading style and language.</p>
    </div>

    <%= form_with model: @user, url: settings_path, method: :patch, class: "space-y-4", data: { turbo_submits_with: "Saving..." } do |f| %>
      <%= render UI::AutoSelectComponent.new(
        form: f,
        method: :default_reading_style,
        options: User::READING_STYLE_OPTIONS,
        selected: @user.default_reading_style,
        label: "Default Reading Style",
        hint: "Used when a series has no reading style set."
      ) %>
    <% end %>

    <%= form_with model: @user, url: settings_path, method: :patch, data: { turbo_submits_with: "Saving..." } do |f| %>
      <%= render UI::AutoSelectComponent.new(
        form: f,
        method: :default_language,
        options: User::LANGUAGE_OPTIONS,
        selected: @user.default_language,
        label: "Preferred Language",
        hint: "Preferred language for chapter translations."
      ) %>
    <% end %>
  </section>

  <%# Download Defaults %>
  <section class="rounded-lg border border-border bg-surface p-6 space-y-4">
    <div>
      <h2 class="text-lg font-semibold">Download Defaults</h2>
      <p class="text-sm text-muted mt-1">Default settings applied to new series follows.</p>
    </div>

    <%= form_with model: @user, url: settings_path, method: :patch, data: { turbo_submits_with: "Saving..." } do |f| %>
      <%= render UI::AutoSelectComponent.new(
        form: f,
        method: :default_download_policy,
        options: User::DOWNLOAD_POLICY_OPTIONS,
        selected: @user.default_download_policy,
        label: "Download Policy",
        hint: "Whether to automatically download new chapters or just notify."
      ) %>
    <% end %>

    <%= form_with model: @user, url: settings_path, method: :patch, data: { turbo_submits_with: "Saving..." } do |f| %>
      <% interval_options = UserSeriesFollow::INTERVAL_OPTIONS.reject { |_, v| v.nil? } %>
      <%= render UI::AutoSelectComponent.new(
        form: f,
        method: :default_check_interval_minutes,
        options: interval_options,
        selected: @user.default_check_interval_minutes,
        label: "Default Check Interval",
        hint: "How often to check followed series for new chapters."
      ) %>
    <% end %>
  </section>

  <%# Source Priority %>
  <section class="rounded-lg border border-border bg-surface p-6 space-y-4">
    <div>
      <h2 class="text-lg font-semibold">Source Priority</h2>
      <p class="text-sm text-muted mt-1">
        Drag to reorder which sources are preferred for downloads and chapter checks.
        Higher sources are tried first.
      </p>
    </div>

    <% priority = Array(current_user.default_source_priority) %>
    <% enabled_sources = @sources.select(&:enabled) %>

    <% ordered_sources = if priority.any? %>
      <%# Sort by priority order, then append any sources not in the priority list %>
      <% prioritized = priority.filter_map { |key| enabled_sources.find { |s| s.key == key } } %>
      <% remaining = enabled_sources.reject { |s| priority.include?(s.key) } %>
      <% prioritized + remaining %>
    <% else %>
      <% enabled_sources %>
    <% end %>

    <%= form_with url: settings_source_priority_path, method: :patch, data: { controller: "sortable-list" } do |f| %>
      <input type="hidden" name="source_priority" data-sortable-list-target="input"
             value="<%= ordered_sources.map(&:key).to_json %>">

      <div class="divide-y divide-border">
        <% ordered_sources.each_with_index do |source, i| %>
          <div class="flex items-center gap-3 py-2 cursor-grab active:cursor-grabbing"
               data-sortable-list-target="item"
               data-source-key="<%= source.key %>">
            <span class="text-xs text-muted-2 w-5 text-right"><%= i + 1 %></span>
            <span class="flex-1 text-sm font-medium text-foreground"><%= source.name %></span>
            <div class="flex gap-1">
              <button type="button" data-action="click->sortable-list#moveUp"
                      class="p-1 text-muted hover:text-foreground" title="Move up">
                <%= icon "chevron-up", class: "h-4 w-4" %>
              </button>
              <button type="button" data-action="click->sortable-list#moveDown"
                      class="p-1 text-muted hover:text-foreground" title="Move down">
                <%= icon "chevron-down", class: "h-4 w-4" %>
              </button>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

  <%# Notifications %>
  <section class="rounded-lg border border-border bg-surface p-6 space-y-4">
    <div>
      <h2 class="text-lg font-semibold">Notifications</h2>
      <p class="text-sm text-muted mt-1">Control how and when you receive notifications.</p>
    </div>

    <%= form_with model: @user, url: settings_path, method: :patch, data: { turbo_submits_with: "Saving..." } do |f| %>
      <%= render UI::ToggleSwitchComponent.new(
        form: f,
        method: :notifications_enabled,
        label: "Enable Notifications",
        description: "Receive notifications for new chapters in followed series.",
        auto_submit: true,
        on_value: "true",
        off_value: "false"
      ) %>
    <% end %>

    <%= form_with model: @user, url: settings_path, method: :patch, data: { turbo_submits_with: "Saving..." } do |f| %>
      <%= render UI::AutoSelectComponent.new(
        form: f,
        method: :notification_auto_cleanup_days,
        options: User::CLEANUP_DAYS_OPTIONS,
        selected: @user.notification_auto_cleanup_days,
        label: "Auto-cleanup Read Notifications",
        hint: "Automatically delete read notifications after this period."
      ) %>
    <% end %>
  </section>

  <%# Sources %>
  <section class="rounded-lg border border-border bg-surface p-6 space-y-4">
    <div>
      <h2 class="text-lg font-semibold">Sources</h2>
      <p class="text-sm text-muted mt-1">Manage which sources are active for searching and fetching chapters.</p>
    </div>

    <div class="divide-y divide-border">
      <% @sources.each do |source| %>
        <div class="flex items-center justify-between gap-4 py-3">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium text-foreground"><%= source.name %></span>
              <% if source.rate_limited? %>
                <%= render UI::BadgeComponent.new(label: "Rate Limited", variant: :warning) %>
              <% end %>
            </div>
            <% if source.base_url.present? %>
              <p class="text-xs text-muted-2 truncate"><%= source.base_url %></p>
            <% end %>
          </div>

          <%= form_with model: source, url: settings_source_path(source_id: source.id), method: :patch, data: { turbo_submits_with: "Saving..." } do |f| %>
            <%= render UI::ToggleSwitchComponent.new(
              form: f,
              method: :enabled,
              label: "",
              on_value: "1",
              off_value: "0",
              auto_submit: true
            ) %>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <%# Administration (admin-only) %>
  <% if current_user&.admin? %>
    <section class="rounded-lg border border-border bg-surface p-6 space-y-4">
      <div>
        <h2 class="text-lg font-semibold">Administration</h2>
        <p class="text-sm text-muted mt-1">Global settings for the Scanarr instance.</p>
      </div>

      <%= form_with model: @site_settings, url: settings_site_path, method: :patch, data: { turbo_submits_with: "Saving..." } do |f| %>
        <%= render UI::ToggleSwitchComponent.new(
          form: f,
          method: :registration_enabled,
          label: "Allow Registration",
          description: "Let new users create accounts from the login page.",
          auto_submit: true,
          on_value: "true",
          off_value: "false"
        ) %>
      <% end %>
    </section>
  <% end %>

  <%# Data Management %>
  <section class="rounded-lg border border-border bg-surface p-6 space-y-4">
    <div>
      <h2 class="text-lg font-semibold">Data Management</h2>
      <p class="text-sm text-muted mt-1">Export, import, and manage your library data.</p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= render UI::ButtonComponent.new(variant: :secondary, href: export_path) do %>
        <%= icon "archive", class: "h-4 w-4" %>
        Export / Import
      <% end %>
      <%= render UI::ButtonComponent.new(variant: :secondary, href: admin_backups_path) do %>
        <%= icon "hard-drive", class: "h-4 w-4" %>
        Backups
      <% end %>
    </div>
  </section>
</div>
