<div class="max-w-4xl space-y-6">
  <%= render UI::PageHeaderComponent.new(title: "Review source replacement", description: "#{@from_source.name} → #{@to_source.name}") %>
  <p class="text-sm text-muted">Saved chapters, reading history, and download settings stay unchanged. Only selected series will prefer the replacement provider.</p>

  <% if @result.already_on_target.any? %>
    <%= form_with url: source_migrations_path, method: :post, data: { turbo: false }, class: "space-y-4" do |f| %>
      <%= f.hidden_field :from_source_id, value: @from_source.id %>
      <%= f.hidden_field :to_source_id, value: @to_source.id %>
      <%= hidden_field_tag "series_ids[]", "" %>
      <section class="rounded-lg border border-border bg-surface p-5 space-y-3" data-controller="selection-toggle">
        <h2 class="text-lg font-semibold">Previously linked titles</h2>
        <p class="text-sm text-muted">These matches already exist in your library. Live availability is checked after switching.</p>
        <div class="flex flex-wrap items-center gap-3">
          <span class="text-sm text-muted" data-selection-toggle-target="count"><%= @result.already_on_target.size %> selected</span>
          <button type="button" class="min-h-11 px-2 text-sm text-accent" data-action="selection-toggle#selectAll">Select all</button>
          <button type="button" class="min-h-11 px-2 text-sm text-muted" data-action="selection-toggle#clearAll">Clear all</button>
        </div>
        <% @result.already_on_target.each do |series| %>
          <label class="flex min-h-11 items-center gap-3 rounded-md border border-border p-3">
            <input type="checkbox" name="series_ids[]" value="<%= series.id %>" checked data-selection-toggle-target="checkbox" data-action="change->selection-toggle#toggle" class="h-4 w-4 shrink-0">
            <span class="min-w-0">
              <span class="block font-medium"><%= series.canonical_title %></span>
              <span class="text-xs text-muted">Linked to <%= @to_source.name %></span>
            </span>
          </label>
        <% end %>
      </section>
      <%= f.submit "Replace source for selected series", class: "min-h-11 cursor-pointer rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-foreground" %>
    <% end %>
  <% end %>

  <% if @result.no_match.any? %>
    <section class="rounded-lg border border-border bg-surface p-5 space-y-3">
      <h2 class="text-lg font-semibold">Review these titles individually</h2>
      <p class="text-sm text-muted">These titles have no existing link to the replacement. Review a match before switching to avoid selecting a different edition.</p>
      <% @result.no_match.each do |series| %>
        <%= link_to series.canonical_title, library_series_migration_path(series_slug: series.to_param, from_source_id: @from_source.id, to_source_id: @to_source.id), class: "flex min-h-11 items-center text-accent hover:underline" %>
      <% end %>
    </section>
  <% end %>
  <% if @result.already_on_target.empty? && @result.no_match.empty? %>
    <%= render UI::EmptyStateComponent.new(title: "No followed series to replace", description: "Choose a provider used by a series you follow.", compact: true) %>
  <% end %>
  <%= link_to "Back to providers", source_migrations_path(from_source_id: @from_source.id), class: "inline-flex min-h-11 items-center text-muted hover:text-foreground" %>
</div>
