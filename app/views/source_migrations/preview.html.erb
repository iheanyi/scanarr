<div class="space-y-8 max-w-4xl">
  <% selectable_count = @result.already_on_target.size %>
  <% needs_linking_count = @result.no_match.size %>

  <%= render UI::PageHeaderComponent.new(
    title: "Migration Preview",
    description: "Review what will happen when migrating from #{@from_source.name} to #{@to_source.name}."
  ) %>

  <%# Summary %>
  <section class="rounded-lg border border-border bg-surface p-6 space-y-4">
    <h2 class="text-lg font-semibold">Migration Summary</h2>

    <div class="rounded-md bg-surface-2 p-4">
      <dl class="grid grid-cols-2 gap-2 text-sm">
        <dt class="text-muted">From</dt>
        <dd class="font-semibold"><%= @from_source.name %></dd>
        <dt class="text-muted">To</dt>
        <dd class="font-semibold"><%= @to_source.name %></dd>
        <dt class="text-muted">Selectable now</dt>
        <dd class="font-semibold text-success tabular-nums"><%= selectable_count %></dd>
        <dt class="text-muted">Need linking first</dt>
        <dd class="font-semibold text-warning tabular-nums"><%= needs_linking_count %></dd>
      </dl>
      <p class="mt-3 text-sm text-muted">
        Selectable series can be bulk-migrated here. Series that need linking can be migrated from their per-series migrate page.
      </p>
    </div>
  </section>

  <%= form_with url: source_migrations_path, method: :post, class: "space-y-6", data: { controller: "selection-toggle" } do |f| %>
    <%= f.hidden_field :from_source_id, value: @from_source.id %>
    <%= f.hidden_field :to_source_id, value: @to_source.id %>
    <%= hidden_field_tag "series_ids[]", "" %>

    <% if selectable_count.positive? %>
      <section class="rounded-lg border border-border bg-surface p-6 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-semibold text-success">Select Series to Migrate (<%= selectable_count %>)</h2>
          <div class="flex items-center gap-2">
            <span class="text-xs text-muted" data-selection-toggle-target="count"><%= selectable_count %> selected</span>
            <button type="button"
                    class="inline-flex items-center rounded-md border border-border px-2 py-1 text-xs text-foreground hover:bg-surface-2 cursor-pointer"
                    data-action="selection-toggle#selectAll">
              Check all
            </button>
            <button type="button"
                    class="inline-flex items-center rounded-md border border-border px-2 py-1 text-xs text-foreground hover:bg-surface-2 cursor-pointer"
                    data-action="selection-toggle#clearAll">
              Clear all
            </button>
          </div>
        </div>
        <p class="text-sm text-muted">Source priority is updated only for checked series.</p>

        <div class="grid gap-3 sm:grid-cols-2">
          <% @result.already_on_target.each do |series| %>
            <% current_count = @series_chapter_counts.fetch([ series.id, @from_source.id ], 0) %>
            <% target_count = @series_chapter_counts.fetch([ series.id, @to_source.id ], 0) %>
            <label class="group flex gap-3 rounded-lg border border-border bg-surface-2 p-3 cursor-pointer hover:border-accent/40 hover:bg-surface">
              <input type="checkbox"
                     name="series_ids[]"
                     value="<%= series.id %>"
                     checked
                     data-selection-toggle-target="checkbox"
                     data-action="change->selection-toggle#toggle"
                     class="mt-1 h-4 w-4 rounded border-border text-accent focus:ring-accent">
              <%= render UI::SeriesCoverComponent.new(
                    url: series.cover_image_url,
                    fallback_url: series.cover_fallback_url,
                    alt: "#{series.canonical_title} cover",
                    size: :sm,
                    rounded: :md,
                    class: "shrink-0"
                  ) %>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-foreground line-clamp-2"><%= series.canonical_title %></p>
                <dl class="mt-2 grid grid-cols-2 gap-x-3 gap-y-1 text-xs">
                  <dt class="text-muted">Current (<%= @from_source.name %>)</dt>
                  <dd class="text-foreground tabular-nums"><%= current_count %> chapters</dd>
                  <dt class="text-muted">Target (<%= @to_source.name %>)</dt>
                  <dd class="text-success tabular-nums"><%= target_count %> chapters</dd>
                </dl>
              </div>
            </label>
          <% end %>
        </div>
      </section>
    <% else %>
      <section class="rounded-lg border border-warning/30 bg-warning-soft p-6 space-y-2">
        <h2 class="text-lg font-semibold text-warning">No selectable series for this source pair</h2>
        <p class="text-sm text-warning/90">
          There are currently no followed series linked to both <%= @from_source.name %> and <%= @to_source.name %>.
        </p>
      </section>
    <% end %>

    <% if needs_linking_count.positive? %>
      <section class="rounded-lg border border-border bg-surface p-6 space-y-4">
        <h2 class="text-lg font-semibold text-warning">Need Per-Series Linking (<%= needs_linking_count %>)</h2>
        <p class="text-sm text-muted">These series are not linked on the target source yet. Use per-series migrate to link and migrate them.</p>

        <div class="grid gap-3 sm:grid-cols-2">
          <% @result.no_match.each do |series| %>
            <% current_count = @series_chapter_counts.fetch([ series.id, @from_source.id ], 0) %>
            <div class="flex gap-3 rounded-lg border border-border bg-surface-2 p-3">
              <%= render UI::SeriesCoverComponent.new(
                    url: series.cover_image_url,
                    fallback_url: series.cover_fallback_url,
                    alt: "#{series.canonical_title} cover",
                    size: :sm,
                    rounded: :md,
                    class: "shrink-0"
                  ) %>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-foreground line-clamp-2"><%= series.canonical_title %></p>
                <dl class="mt-2 grid grid-cols-2 gap-x-3 gap-y-1 text-xs">
                  <dt class="text-muted">Current (<%= @from_source.name %>)</dt>
                  <dd class="text-foreground tabular-nums"><%= current_count %> chapters</dd>
                  <dt class="text-muted">Target (<%= @to_source.name %>)</dt>
                  <dd class="text-warning tabular-nums">Not linked</dd>
                </dl>
                <div class="mt-3">
                  <%= link_to "Open per-series migrate",
                              library_series_migration_path(series_slug: series.to_param, from_source_id: @from_source.id),
                              class: "inline-flex items-center rounded-md border border-border px-2.5 py-1 text-xs font-semibold text-foreground hover:bg-surface" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <div class="flex items-center gap-3">
      <% if selectable_count.positive? %>
        <%= f.submit "Execute Migration",
                     class: "inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-foreground hover:bg-accent-strong cursor-pointer",
                     data: { turbo_confirm: "Migrate selected series from #{@from_source.name} to #{@to_source.name}?" } %>
      <% end %>

      <%= link_to "Back", source_migrations_path,
                  class: "inline-flex items-center gap-2 rounded-md border border-border bg-surface-2 px-4 py-2 text-sm font-semibold text-foreground hover:bg-surface-2/80" %>
    </div>
  <% end %>
</div>
