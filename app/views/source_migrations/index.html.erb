<div class="space-y-8 max-w-4xl">
  <%= render UI::PageHeaderComponent.new(
    title: "Replace sources",
    description: "Change where your followed manga comes from. Saved chapters and reading history stay in your library."
  ) %>

  <%# Source Health Dashboard %>
  <section class="rounded-lg border border-border bg-surface p-6 space-y-4">
    <h2 class="text-lg font-semibold">Your followed series by provider</h2>

    <div class="divide-y divide-border">
      <% @sources.each do |source| %>
        <% health = @source_health[source.id] %>
        <div class="flex items-center justify-between gap-4 py-3">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium text-foreground"><%= source.display_name %></span>
              <% if source.mature_content? %>
                <%= render UI::BadgeComponent.new(label: "18+", variant: :warning) %>
              <% end %>
              <% if source.rate_limited? %>
                <%= render UI::BadgeComponent.new(label: "Rate Limited", variant: :warning) %>
              <% end %>
              <% if !source.enabled %>
                <%= render UI::BadgeComponent.new(label: "Disabled", variant: :default) %>
              <% end %>
            </div>
            <% if health %>
              <div class="flex gap-3 mt-1 text-xs">
                <span class="text-success"><%= health.healthy_count %> healthy</span>
                <% if health.attention_count.to_i > 0 %>
                  <span class="text-warning"><%= health.attention_count %> needs attention</span>
                <% end %>
                <% if health.stale_count.to_i > 0 %>
                  <span class="text-danger"><%= health.stale_count %> stale</span>
                <% end %>
              </div>
            <% else %>
              <p class="text-xs text-muted-2">No series tracked</p>
            <% end %>
          </div>

          <% case source.health_status %>
          <% when "dead" %>
            <%= render UI::BadgeComponent.new(label: "Dead", variant: :danger) %>
          <% when "broken" %>
            <% broken_label = source.health_changed_at ? "Broken for #{time_ago_in_words(source.health_changed_at)}" : "Broken" %>
            <%= render UI::BadgeComponent.new(label: broken_label, variant: :danger) %>
          <% when "degraded" %>
            <%= render UI::BadgeComponent.new(label: "Degraded", variant: :warning) %>
          <% else %>
            <%= render UI::BadgeComponent.new(label: "Healthy", variant: :success) %>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <%# Migration Tool %>
  <section class="rounded-lg border border-border bg-surface p-6 space-y-4">
    <div>
      <h2 class="text-lg font-semibold">Replace a provider for multiple series</h2>
      <p class="text-sm text-muted mt-1">
        Review the series you follow, then select which ones should use a replacement provider.
        Existing matches can switch immediately; other titles need matching first.
      </p>
    </div>

    <%= form_with url: preview_source_migrations_path, method: :post, data: { turbo: false }, class: "space-y-4" do |f| %>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="from_source_id" class="block text-sm font-medium text-foreground mb-1">Current provider</label>
          <select id="from_source_id" required name="from_source_id" class="w-full rounded-md border border-border bg-surface-2 px-3 py-2 text-sm text-foreground focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/30">
            <option value="">Select source...</option>
            <% @sources.each do |source| %>
              <option value="<%= source.id %>" <%= "selected" if params[:from_source_id].to_s == source.id.to_s %>><%= source.display_name_with_content_rating %></option>
            <% end %>
          </select>
        </div>

        <div>
          <label for="to_source_id" class="block text-sm font-medium text-foreground mb-1">Replacement provider</label>
          <select id="to_source_id" required name="to_source_id" class="w-full rounded-md border border-border bg-surface-2 px-3 py-2 text-sm text-foreground focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/30">
            <option value="">Select source...</option>
            <% @target_sources.each do |source| %>
              <option value="<%= source.id %>" <%= "selected" if params[:to_source_id].to_s == source.id.to_s %>><%= source.display_name_with_content_rating %></option>
            <% end %>
          </select>
        </div>
      </div>

      <%= f.submit "Review series",
                    class: "inline-flex items-center gap-2 rounded-md border border-border bg-surface-2 px-4 py-2 text-sm font-semibold text-foreground hover:bg-surface-2/80 cursor-pointer" %>
    <% end %>
  </section>
</div>
