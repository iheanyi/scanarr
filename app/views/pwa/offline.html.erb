<main class="mx-auto flex min-h-dvh w-full max-w-md flex-col items-center justify-center gap-6 px-6 py-10 text-center">
  <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl border border-border bg-surface-2 text-accent">
    <%= icon "wifi-off", class: "h-8 w-8" %>
  </div>
  <div class="space-y-2">
    <h1 class="text-2xl font-semibold text-foreground">You are offline</h1>
    <p class="text-sm text-muted">
      Scanarr could not reach the server. Cached chapters remain readable, and progress will sync once you reconnect.
    </p>
  </div>
  <div class="flex flex-wrap items-center justify-center gap-2">
    <%= link_to "Try Again", request.referer.presence || library_path, class: "inline-flex items-center rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-foreground hover:bg-accent-strong" %>
    <%= link_to "Go to Library", library_path, class: "inline-flex items-center rounded-md border border-border px-4 py-2 text-sm font-medium text-foreground hover:bg-surface-2" %>
  </div>
</main>
