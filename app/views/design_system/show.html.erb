<div id="design-system" class="relative overflow-hidden rounded-[32px] bg-background p-6 text-foreground">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute inset-0 ds-radial-1"></div>
    <div class="absolute inset-0 ds-radial-2"></div>
    <div class="absolute inset-0 ds-grid opacity-25"></div>
  </div>

  <div class="relative space-y-12">
    <div class="rounded-3xl border border-border bg-surface p-6 shadow-[0_0_0_1px_rgba(8,10,12,0.7)] backdrop-blur">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="text-xs uppercase tracking-[0.35em] text-muted-2">Scanarr Design System</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight text-foreground">Design language for scanners and readers.</h1>
          <p class="mt-3 max-w-2xl text-sm text-muted">
            A restrained system inspired by Geist and SpineFind. Built for clarity, speed, and a calm reading
            experience across every surface in Scanarr.
          </p>
          <div class="mt-4 flex flex-wrap gap-1.5 text-[11px] text-muted">
            <span class="rounded-full border border-border bg-surface-2 px-2.5 py-1 leading-4">Neutral-first</span>
            <span class="rounded-full border border-border bg-surface-2 px-2.5 py-1 leading-4">Quiet motion</span>
            <span class="rounded-full border border-border bg-surface-2 px-2.5 py-1 leading-4">Readable hierarchy</span>
          </div>
        </div>
        <div class="min-w-[220px] space-y-3 text-xs text-muted">
          <div class="flex items-center justify-between rounded-2xl border border-border bg-surface-2 px-4 py-3">
            <span class="uppercase tracking-[0.25em] text-muted-2">Status</span>
            <span class="text-foreground">v0.1</span>
          </div>
          <div class="flex items-center justify-between rounded-2xl border border-border bg-surface-2 px-4 py-3">
            <span class="uppercase tracking-[0.25em] text-muted-2">Updated</span>
            <span class="text-foreground">Feb 2026</span>
          </div>
          <div class="rounded-2xl border border-border bg-surface-2 px-4 py-3 text-muted">
            Public reference for UI standards and component behavior.
          </div>
        </div>
      </div>
    </div>

    <div class="lg:hidden">
      <div class="flex flex-wrap gap-2 text-xs text-muted">
        <a href="#overview" class="rounded-full border border-border px-3 py-1 hover:text-foreground">Overview</a>
        <a href="#tokens" class="rounded-full border border-border px-3 py-1 hover:text-foreground">Tokens</a>
        <a href="#components" class="rounded-full border border-border px-3 py-1 hover:text-foreground">Components</a>
        <a href="#guidelines" class="rounded-full border border-border px-3 py-1 hover:text-foreground">Guidelines</a>
        <a href="#roadmap" class="rounded-full border border-border px-3 py-1 hover:text-foreground">Roadmap</a>
      </div>
    </div>

    <div class="grid gap-12 lg:grid-cols-[220px_minmax(0,1fr)]">
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-4 text-sm text-muted">
          <p class="text-xs uppercase tracking-[0.28em] text-muted-2">Sections</p>
          <nav class="flex flex-col gap-2 border-l border-border pl-4">
            <a href="#overview" class="hover:text-foreground">Overview</a>
            <a href="#tokens" class="hover:text-foreground">Tokens</a>
            <a href="#components" class="hover:text-foreground">Components</a>
            <a href="#guidelines" class="hover:text-foreground">Guidelines</a>
            <a href="#roadmap" class="hover:text-foreground">Roadmap</a>
          </nav>
        </div>
      </aside>

      <div class="space-y-16">
        <section id="overview" class="scroll-mt-24 space-y-6 border-t border-border pt-8">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-semibold text-foreground">Overview</h2>
            <span class="text-xs uppercase tracking-[0.3em] text-muted-2">Principles</span>
          </div>
          <div class="grid gap-6 md:grid-cols-2">
            <div class="rounded-2xl border border-border bg-surface p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.03)]">
              <p class="text-xs uppercase tracking-[0.28em] text-muted-2">01</p>
              <h3 class="mt-3 text-sm font-semibold text-foreground">Minimal color</h3>
              <p class="mt-2 text-sm text-muted">Neutral surfaces first. Accent is reserved for primary actions and success.</p>
            </div>
            <div class="rounded-2xl border border-border bg-surface p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.03)]">
              <p class="text-xs uppercase tracking-[0.28em] text-muted-2">02</p>
              <h3 class="mt-3 text-sm font-semibold text-foreground">Generous whitespace</h3>
              <p class="mt-2 text-sm text-muted">Interfaces should breathe. Density is an intentional, context-specific choice.</p>
            </div>
            <div class="rounded-2xl border border-border bg-surface p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.03)]">
              <p class="text-xs uppercase tracking-[0.28em] text-muted-2">03</p>
              <h3 class="mt-3 text-sm font-semibold text-foreground">Subtle interactions</h3>
              <p class="mt-2 text-sm text-muted">Motion is quiet and purposeful. Focus on feedback, not spectacle.</p>
            </div>
            <div class="rounded-2xl border border-border bg-surface p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.03)]">
              <p class="text-xs uppercase tracking-[0.28em] text-muted-2">04</p>
              <h3 class="mt-3 text-sm font-semibold text-foreground">Clear hierarchy</h3>
              <p class="mt-2 text-sm text-muted">Type and spacing do the heavy lifting. Color is supporting cast.</p>
            </div>
          </div>
        </section>

        <section id="tokens" class="scroll-mt-24 space-y-6 border-t border-border pt-8">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-semibold text-foreground">Tokens</h2>
            <span class="text-xs uppercase tracking-[0.3em] text-muted-2">Color / Type / Space</span>
          </div>
          <div class="grid gap-8 lg:grid-cols-2">
            <div class="overflow-hidden rounded-2xl border border-border bg-surface">
              <div class="flex items-center justify-between border-b border-border px-5 py-3">
                <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-foreground">Color</h3>
                <span class="text-[10px] uppercase tracking-[0.3em] text-muted-2">Palette</span>
              </div>
              <div class="grid gap-4 p-6 sm:grid-cols-2">
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 rounded-xl border border-border bg-background"></div>
                  <div>
                    <p class="text-sm text-foreground">Base</p>
                    <p class="text-xs text-muted-2">#0b0f14</p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 rounded-xl border border-border bg-surface"></div>
                  <div>
                    <p class="text-sm text-foreground">Surface</p>
                    <p class="text-xs text-muted-2">#131a24</p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 rounded-xl border border-border-soft bg-border"></div>
                  <div>
                    <p class="text-sm text-foreground">Border</p>
                    <p class="text-xs text-muted-2">#2c3849</p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 rounded-xl bg-accent-strong"></div>
                  <div>
                    <p class="text-sm text-foreground">Accent</p>
                    <p class="text-xs text-muted-2">#5fd3b7</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="overflow-hidden rounded-2xl border border-border bg-surface">
              <div class="flex items-center justify-between border-b border-border px-5 py-3">
                <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-foreground">Status</h3>
                <span class="text-[10px] uppercase tracking-[0.3em] text-muted-2">Semantic</span>
              </div>
              <div class="grid gap-4 p-6 sm:grid-cols-2">
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 rounded-xl bg-success-soft"></div>
                  <div>
                    <p class="text-sm text-foreground">Success</p>
                    <p class="text-xs text-muted-2">#6fe3b5</p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 rounded-xl bg-warning-soft"></div>
                  <div>
                    <p class="text-sm text-foreground">Warning</p>
                    <p class="text-xs text-muted-2">#f2c16b</p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 rounded-xl bg-error-soft"></div>
                  <div>
                    <p class="text-sm text-foreground">Error</p>
                    <p class="text-xs text-muted-2">#f0646f</p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 rounded-xl bg-info-soft"></div>
                  <div>
                    <p class="text-sm text-foreground">Info</p>
                    <p class="text-xs text-muted-2">#6fb6ff</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="overflow-hidden rounded-2xl border border-border bg-surface">
              <div class="flex items-center justify-between border-b border-border px-5 py-3">
                <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-foreground">Typography</h3>
                <span class="text-[10px] uppercase tracking-[0.3em] text-muted-2">Scale</span>
              </div>
              <div class="space-y-3 p-6">
                <p class="text-3xl font-semibold text-foreground">Heading XL</p>
                <p class="text-xl font-medium text-foreground">Heading L</p>
                <p class="text-base text-foreground">Body text for reading and metadata.</p>
                <p class="text-sm text-muted">Secondary text for hints and labels.</p>
              </div>
            </div>
            <div class="overflow-hidden rounded-2xl border border-border bg-surface">
              <div class="flex items-center justify-between border-b border-border px-5 py-3">
                <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-foreground">Spacing</h3>
                <span class="text-[10px] uppercase tracking-[0.3em] text-muted-2">Scale</span>
              </div>
              <div class="space-y-4 p-6">
                <div class="flex items-center justify-between gap-4">
                  <div class="h-2 flex-1 rounded-full bg-border"></div>
                  <p class="text-sm text-muted">2 / 4 / 6</p>
                </div>
                <div class="flex items-center justify-between gap-4">
                  <div class="h-2 flex-1 rounded-full bg-border"></div>
                  <p class="text-sm text-muted">8 / 10 / 12</p>
                </div>
                <div class="flex items-center justify-between gap-4">
                  <div class="h-2 flex-1 rounded-full bg-border"></div>
                  <p class="text-sm text-muted">16 / 20 / 24</p>
                </div>
              </div>
            </div>
            <div class="overflow-hidden rounded-2xl border border-border bg-surface">
              <div class="flex items-center justify-between border-b border-border px-5 py-3">
                <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-foreground">Radius</h3>
                <span class="text-[10px] uppercase tracking-[0.3em] text-muted-2">Shapes</span>
              </div>
              <div class="flex items-center gap-4 p-6">
                <div class="h-10 w-10 rounded-md border border-border-soft"></div>
                <div class="h-10 w-10 rounded-xl border border-border-soft"></div>
                <div class="h-10 w-10 rounded-2xl border border-border-soft"></div>
                <div class="h-10 w-10 rounded-full border border-border-soft"></div>
              </div>
              <p class="px-6 pb-6 pt-1 text-xs text-muted">Use rounded-2xl for cards, rounded-md for inputs, rounded-full for pills.</p>
            </div>
          </div>
        </section>

        <section id="components" class="scroll-mt-24 space-y-6 border-t border-border pt-8">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-semibold text-foreground">Components</h2>
            <span class="text-xs uppercase tracking-[0.3em] text-muted-2">Preview</span>
          </div>
          <div class="grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
            <div class="rounded-2xl border border-border bg-surface p-6">
              <div class="flex flex-wrap items-center justify-between gap-4">
                <div>
                  <p class="text-xs uppercase tracking-[0.28em] text-muted-2">Buttons</p>
                  <h3 class="mt-2 text-sm font-semibold text-foreground">Action hierarchy</h3>
                  <p class="mt-2 text-sm text-muted">Primary, secondary, ghost, and danger variants for clear intent.</p>
                </div>
                <span class="rounded-full border border-border px-3 py-1 text-xs text-muted">UI::Button</span>
              </div>
              <div class="mt-5 flex flex-wrap items-center gap-3">
                <button class="rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-foreground hover:bg-accent-strong">Primary</button>
                <button class="rounded-md bg-surface-2 px-4 py-2 text-sm font-semibold text-foreground hover:bg-border">Secondary</button>
                <button class="rounded-md border border-border-soft px-4 py-2 text-sm font-semibold text-foreground hover:bg-surface-2">Ghost</button>
                <button class="rounded-md bg-danger px-4 py-2 text-sm font-semibold text-foreground hover:opacity-90">Danger</button>
              </div>
              <pre class="mt-5 overflow-x-auto rounded-xl border border-border bg-background p-4 text-xs text-muted"><code>&lt;button class="rounded-md bg-accent px-4 py-2 text-sm font-semibold"&gt;Primary&lt;/button&gt;</code></pre>
            </div>
            <div class="space-y-6">
              <div class="rounded-2xl border border-border bg-surface p-6">
                <div class="flex items-center justify-between">
                  <h3 class="text-sm font-semibold text-foreground">Badges</h3>
                  <span class="text-xs text-muted-2">UI::Badge</span>
                </div>
                <div class="mt-3 flex flex-wrap gap-2">
                  <span class="rounded-full bg-surface-2 px-3 py-1 text-xs text-foreground">Default</span>
                  <span class="rounded-full bg-success-soft px-3 py-1 text-xs text-success">Success</span>
                  <span class="rounded-full bg-warning-soft px-3 py-1 text-xs text-warning">Warning</span>
                  <span class="rounded-full bg-error-soft px-3 py-1 text-xs text-error">Error</span>
                </div>
              </div>
              <div class="rounded-2xl border border-border bg-surface p-6">
                <div class="flex items-center justify-between">
                  <h3 class="text-sm font-semibold text-foreground">Inputs</h3>
                  <span class="text-xs text-muted-2">UI::Input</span>
                </div>
                <div class="mt-3 space-y-3">
                  <input type="text" placeholder="Search series" class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-2 focus:border-accent focus:outline-none" />
                  <div class="flex items-center gap-3">
                    <label class="flex items-center gap-2 text-sm text-muted">
                      <input type="checkbox" class="h-4 w-4 rounded border-border bg-background text-accent focus:ring-accent" />
                      Auto-download
                    </label>
                    <span class="text-xs text-muted-2">Auto-applies</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="grid gap-6 lg:grid-cols-2">
            <div class="rounded-2xl border border-border bg-surface p-6">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-semibold text-foreground">Selects</h3>
                <span class="text-xs text-muted-2">UI::Select</span>
              </div>
              <div class="mt-3">
                <%= form_with url: "#", method: :get, local: true do |form| %>
                  <%= render UI::SelectComponent.new(
                    form: form,
                    method: :reading_style,
                    label: "Reading style",
                    hint: "Auto-applies on change.",
                    options: [
                      ["Left to Right", "left_to_right"],
                      ["Right to Left", "right_to_left"],
                      ["Long Strip", "long_strip"]
                    ],
                    selected: "left_to_right"
                  ) %>
                <% end %>
              </div>
            </div>
            <div class="rounded-2xl border border-border bg-surface p-6">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-semibold text-foreground">Toggles</h3>
                <span class="text-xs text-muted-2">UI::ToggleSwitch</span>
              </div>
              <div class="mt-3">
                <%= form_with url: "#", method: :post, local: true do |form| %>
                  <%= render UI::ToggleSwitchComponent.new(
                    form: form,
                    method: :auto_download,
                    label: "Auto-download new chapters",
                    description: "Instantly pulls new chapters when available.",
                    on_value: "1",
                    off_value: "0"
                  ) %>
                <% end %>
              </div>
            </div>
          </div>
          <div class="rounded-2xl border border-border bg-surface p-6">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-semibold text-foreground">Multi-select</h3>
              <span class="text-xs text-muted-2">UI::MultiSelect</span>
            </div>
            <div class="mt-3">
              <%= render UI::MultiSelectComponent.new(
                name: "sources",
                label: "Sources",
                options: [
                  ["MangaDex", "mangadex"],
                  ["WeebCentral", "weebcentral"],
                  ["MangaPill", "mangapill"],
                  ["MangaSee", "mangasee"]
                ],
                selected: ["mangadex", "weebcentral"],
                filter_placeholder: "Filter sources",
                all_label: "All sources"
              ) %>
            </div>
          </div>
        </section>

        <section id="guidelines" class="scroll-mt-24 space-y-6 border-t border-border pt-8">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-semibold text-foreground">Guidelines</h2>
            <span class="text-xs uppercase tracking-[0.3em] text-muted-2">Usage</span>
          </div>
          <div class="grid gap-6 md:grid-cols-2">
            <div class="rounded-2xl border border-border bg-surface p-6">
              <h3 class="text-sm font-semibold text-foreground">Do</h3>
              <ul class="mt-3 space-y-2 text-sm text-muted">
                <li>Use the accent color for the single primary action.</li>
                <li>Prefer concise labels with direct verbs.</li>
                <li>Keep secondary actions visually quiet.</li>
                <li>Use whitespace to separate content clusters.</li>
              </ul>
            </div>
            <div class="rounded-2xl border border-border bg-surface p-6">
              <h3 class="text-sm font-semibold text-foreground">Don't</h3>
              <ul class="mt-3 space-y-2 text-sm text-muted">
                <li>Stack multiple bright buttons in one row.</li>
                <li>Use borders where spacing solves the layout.</li>
                <li>Introduce motion without meaning.</li>
                <li>Over-label; let hierarchy do the work.</li>
              </ul>
            </div>
          </div>
          <div class="rounded-2xl border border-border bg-surface p-6">
            <h3 class="text-sm font-semibold text-foreground">Accessibility</h3>
            <p class="mt-2 text-sm text-muted">
              Maintain 4.5:1 contrast for body text, preserve focus rings, and ensure hover states never carry meaning alone.
            </p>
          </div>
        </section>

        <section id="roadmap" class="scroll-mt-24 space-y-6 border-t border-border pt-8">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-semibold text-foreground">Roadmap</h2>
            <span class="text-xs uppercase tracking-[0.3em] text-muted-2">Phases</span>
          </div>
          <div class="space-y-4">
            <div class="rounded-2xl border border-border bg-surface p-6">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="text-sm text-foreground">Phase 0 - Foundation setup + design system page</p>
                  <p class="mt-2 text-xs text-muted-2">Base layout, public docs, and early component scaffolding.</p>
                </div>
                <span class="rounded-full bg-success-soft px-3 py-1 text-xs text-success">Done</span>
              </div>
            </div>
            <div class="rounded-2xl border border-border bg-surface p-6">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="text-sm text-foreground">Phase 1 - Icon + tokens + base component</p>
                  <p class="mt-2 text-xs text-muted-2">Build the primitives that everything composes from.</p>
                </div>
                <span class="rounded-full bg-accent-soft px-3 py-1 text-xs text-accent-strong">In progress</span>
              </div>
            </div>
            <div class="rounded-2xl border border-border bg-surface p-6">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="text-sm text-foreground">Phase 2 - Buttons, badge, spinner, toggle</p>
                  <p class="mt-2 text-xs text-muted-2">Action surfaces and quick status markers.</p>
                </div>
                <span class="rounded-full bg-accent-soft px-3 py-1 text-xs text-accent-strong">In progress</span>
              </div>
            </div>
            <div class="rounded-2xl border border-border bg-surface p-6">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="text-sm text-foreground">Phase 3-6 - Forms, feedback, layout, series refactor</p>
                  <p class="mt-2 text-xs text-muted-2">Full coverage across inputs, feedback, and product surfaces.</p>
                </div>
                <span class="rounded-full bg-surface-2 px-3 py-1 text-xs text-muted">Queued</span>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</div>
