            </div>
            <div class="rounded-2xl border border-border/80 bg-background/70 p-3">
              <div class="h-10 rounded-xl bg-surface"></div>
              <p class="mt-3 text-xs uppercase tracking-[0.18em] text-muted-2">Surface</p>
              <p class="text-sm text-foreground">#101b2c</p>
            </div>
            <div class="rounded-2xl border border-border/80 bg-background/70 p-3">
              <div class="h-10 rounded-xl bg-accent"></div>
              <p class="mt-3 text-xs uppercase tracking-[0.18em] text-muted-2">Accent</p>
              <p class="text-sm text-foreground">#5ee7ff</p>
            </div>
          </div>
        </div>

        <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
          <div class="ds-direction-shell grid-cols-[82px_minmax(0,1fr)]">
            <div class="ds-direction-sidebar flex flex-col gap-3 p-4 text-sm text-muted">
              <div class="rounded-2xl border border-border/80 bg-background/60 p-3 text-center text-xs uppercase tracking-[0.2em] text-foreground">
                Live
              </div>
              <div>Browse</div>
              <div>Search</div>
              <div>Queue</div>
              <div>Stats</div>
            </div>

            <div class="flex flex-col gap-4 p-4">
              <div class="ds-direction-surface rounded-[1.5rem] p-4">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="text-[11px] uppercase tracking-[0.22em] text-muted-2">Browse feed</p>
                    <h3 class="mt-2 text-2xl font-semibold text-foreground">Trending series with clearer motion and urgency.</h3>
