<div id="design-system" class="relative overflow-hidden rounded-[32px] bg-[color:var(--ds-bg)] p-6 text-[color:var(--ds-text)]" style="--ds-bg:#0c1014; --ds-surface:#141a21; --ds-surface-2:#1b232c; --ds-border:#2a3340; --ds-border-soft:#353f4d; --ds-text:#e7ecf2; --ds-muted:#9aa6b2; --ds-muted-2:#7d8894; --ds-accent:#5aa2c7; --ds-accent-strong:#6ab5dd; --ds-accent-soft:rgba(90,162,199,0.18); --ds-accent-ghost:rgba(90,162,199,0.08); --ds-warm:#d1a06b; --ds-warm-soft:rgba(209,160,107,0.2); --ds-danger:#c77474; --ds-danger-soft:rgba(199,116,116,0.2);">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute inset-0 bg-[radial-gradient(60rem_38rem_at_20%_-10%,rgba(20,30,36,0.75),transparent)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(50rem_32rem_at_90%_10%,rgba(12,18,24,0.6),transparent)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(92,104,118,0.14)_1px,transparent_1px),linear-gradient(to_bottom,rgba(92,104,118,0.14)_1px,transparent_1px)] bg-[size:80px_80px] opacity-25"></div>
  </div>

  <div class="relative space-y-12">
    <div class="rounded-3xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)] p-6 shadow-[0_0_0_1px_rgba(8,10,12,0.7)] backdrop-blur">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="text-xs uppercase tracking-[0.35em] text-[color:var(--ds-muted-2)]">Scanarr Design System</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight text-[color:var(--ds-text)]">Design language for scanners and readers.</h1>
          <p class="mt-3 max-w-2xl text-sm text-[color:var(--ds-muted)]">
            A restrained system inspired by Geist and SpineFind. Built for clarity, speed, and a calm reading
            experience across every surface in Scanarr.
          </p>
          <div class="mt-4 flex flex-wrap gap-1.5 text-[11px] text-[color:var(--ds-muted)]">
            <span class="rounded-full border border-[color:var(--ds-border)] bg-[color:var(--ds-surface-2)] px-2.5 py-1 leading-4">Neutral-first</span>
            <span class="rounded-full border border-[color:var(--ds-border)] bg-[color:var(--ds-surface-2)] px-2.5 py-1 leading-4">Quiet motion</span>
            <span class="rounded-full border border-[color:var(--ds-border)] bg-[color:var(--ds-surface-2)] px-2.5 py-1 leading-4">Readable hierarchy</span>
          </div>
        </div>
        <div class="min-w-[220px] space-y-3 text-xs text-[color:var(--ds-muted)]">
          <div class="flex items-center justify-between rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface-2)] px-4 py-3">
            <span class="uppercase tracking-[0.25em] text-[color:var(--ds-muted-2)]">Status</span>
            <span class="text-[color:var(--ds-text)]">v0.1</span>
          </div>
          <div class="flex items-center justify-between rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface-2)] px-4 py-3">
            <span class="uppercase tracking-[0.25em] text-[color:var(--ds-muted-2)]">Updated</span>
            <span class="text-[color:var(--ds-text)]">Feb 2026</span>
          </div>
          <div class="rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface-2)] px-4 py-3 text-[color:var(--ds-muted)]">
            Public reference for UI standards and component behavior.
          </div>
        </div>
      </div>
    </div>

    <div class="lg:hidden">
      <div class="flex flex-wrap gap-2 text-xs text-[color:var(--ds-muted)]">
        <a href="#overview" class="rounded-full border border-[color:var(--ds-border)] px-3 py-1 hover:text-[color:var(--ds-text)]">Overview</a>
        <a href="#tokens" class="rounded-full border border-[color:var(--ds-border)] px-3 py-1 hover:text-[color:var(--ds-text)]">Tokens</a>
        <a href="#components" class="rounded-full border border-[color:var(--ds-border)] px-3 py-1 hover:text-[color:var(--ds-text)]">Components</a>
        <a href="#guidelines" class="rounded-full border border-[color:var(--ds-border)] px-3 py-1 hover:text-[color:var(--ds-text)]">Guidelines</a>
        <a href="#roadmap" class="rounded-full border border-[color:var(--ds-border)] px-3 py-1 hover:text-[color:var(--ds-text)]">Roadmap</a>
      </div>
    </div>

    <div class="grid gap-12 lg:grid-cols-[220px_minmax(0,1fr)]">
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-4 text-sm text-[color:var(--ds-muted)]">
          <p class="text-xs uppercase tracking-[0.28em] text-[color:var(--ds-muted-2)]">Sections</p>
          <nav class="flex flex-col gap-2 border-l border-[color:var(--ds-border)] pl-4">
            <a href="#overview" class="hover:text-[color:var(--ds-text)]">Overview</a>
            <a href="#tokens" class="hover:text-[color:var(--ds-text)]">Tokens</a>
            <a href="#components" class="hover:text-[color:var(--ds-text)]">Components</a>
            <a href="#guidelines" class="hover:text-[color:var(--ds-text)]">Guidelines</a>
            <a href="#roadmap" class="hover:text-[color:var(--ds-text)]">Roadmap</a>
          </nav>
        </div>
      </aside>

      <div class="space-y-16">
        <section id="overview" class="scroll-mt-24 space-y-6 border-t border-[color:var(--ds-border)] pt-8">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-semibold text-[color:var(--ds-text)]">Overview</h2>
            <span class="text-xs uppercase tracking-[0.3em] text-[color:var(--ds-muted-2)]">Principles</span>
          </div>
          <div class="grid gap-6 md:grid-cols-2">
            <div class="rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)] p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.03)]">
              <p class="text-xs uppercase tracking-[0.28em] text-[color:var(--ds-muted-2)]">01</p>
              <h3 class="mt-3 text-sm font-semibold text-[color:var(--ds-text)]">Minimal color</h3>
              <p class="mt-2 text-sm text-[color:var(--ds-muted)]">Neutral surfaces first. Accent is reserved for primary actions and success.</p>
            </div>
            <div class="rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)] p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.03)]">
              <p class="text-xs uppercase tracking-[0.28em] text-[color:var(--ds-muted-2)]">02</p>
              <h3 class="mt-3 text-sm font-semibold text-[color:var(--ds-text)]">Generous whitespace</h3>
              <p class="mt-2 text-sm text-[color:var(--ds-muted)]">Interfaces should breathe. Density is an intentional, context-specific choice.</p>
            </div>
            <div class="rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)] p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.03)]">
              <p class="text-xs uppercase tracking-[0.28em] text-[color:var(--ds-muted-2)]">03</p>
              <h3 class="mt-3 text-sm font-semibold text-[color:var(--ds-text)]">Subtle interactions</h3>
              <p class="mt-2 text-sm text-[color:var(--ds-muted)]">Motion is quiet and purposeful. Focus on feedback, not spectacle.</p>
            </div>
            <div class="rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)] p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.03)]">
              <p class="text-xs uppercase tracking-[0.28em] text-[color:var(--ds-muted-2)]">04</p>
              <h3 class="mt-3 text-sm font-semibold text-[color:var(--ds-text)]">Clear hierarchy</h3>
              <p class="mt-2 text-sm text-[color:var(--ds-muted)]">Type and spacing do the heavy lifting. Color is supporting cast.</p>
            </div>
          </div>
        </section>

        <section id="tokens" class="scroll-mt-24 space-y-6 border-t border-[color:var(--ds-border)] pt-8">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-semibold text-[color:var(--ds-text)]">Tokens</h2>
            <span class="text-xs uppercase tracking-[0.3em] text-[color:var(--ds-muted-2)]">Color / Type / Space</span>
          </div>
          <div class="grid gap-8 lg:grid-cols-2">
            <div class="overflow-hidden rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)]">
              <div class="flex items-center justify-between border-b border-[color:var(--ds-border)] px-5 py-3">
                <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ds-text)]">Color</h3>
                <span class="text-[10px] uppercase tracking-[0.3em] text-[color:var(--ds-muted-2)]">Palette</span>
              </div>
              <div class="grid gap-4 p-6 sm:grid-cols-2">
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 rounded-xl border border-[color:var(--ds-border)] bg-[color:var(--ds-bg)]"></div>
                  <div>
                    <p class="text-sm text-[color:var(--ds-text)]">Base</p>
                    <p class="text-xs text-[color:var(--ds-muted-2)]">#0c1014</p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 rounded-xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)]"></div>
                  <div>
                    <p class="text-sm text-[color:var(--ds-text)]">Surface</p>
                    <p class="text-xs text-[color:var(--ds-muted-2)]">#141a21</p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 rounded-xl border border-[color:var(--ds-border-soft)] bg-[color:var(--ds-border)]"></div>
                  <div>
                    <p class="text-sm text-[color:var(--ds-text)]">Border</p>
                    <p class="text-xs text-[color:var(--ds-muted-2)]">#2a3340</p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 rounded-xl bg-[color:var(--ds-accent-strong)]"></div>
                  <div>
                    <p class="text-sm text-[color:var(--ds-text)]">Accent</p>
                    <p class="text-xs text-[color:var(--ds-muted-2)]">#5aa2c7</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="overflow-hidden rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)]">
              <div class="flex items-center justify-between border-b border-[color:var(--ds-border)] px-5 py-3">
                <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ds-text)]">Typography</h3>
                <span class="text-[10px] uppercase tracking-[0.3em] text-[color:var(--ds-muted-2)]">Scale</span>
              </div>
              <div class="space-y-3 p-6">
                <p class="text-3xl font-semibold text-[color:var(--ds-text)]">Heading XL</p>
                <p class="text-xl font-medium text-[color:var(--ds-text)]">Heading L</p>
                <p class="text-base text-[color:var(--ds-text)]">Body text for reading and metadata.</p>
                <p class="text-sm text-[color:var(--ds-muted)]">Secondary text for hints and labels.</p>
              </div>
            </div>
            <div class="overflow-hidden rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)]">
              <div class="flex items-center justify-between border-b border-[color:var(--ds-border)] px-5 py-3">
                <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ds-text)]">Spacing</h3>
                <span class="text-[10px] uppercase tracking-[0.3em] text-[color:var(--ds-muted-2)]">Scale</span>
              </div>
              <div class="space-y-4 p-6">
                <div class="flex items-center justify-between gap-4">
                  <div class="h-2 flex-1 rounded-full bg-[color:var(--ds-border)]"></div>
                  <p class="text-sm text-[color:var(--ds-muted)]">2 / 4 / 6</p>
                </div>
                <div class="flex items-center justify-between gap-4">
                  <div class="h-2 flex-1 rounded-full bg-[color:var(--ds-border)]"></div>
                  <p class="text-sm text-[color:var(--ds-muted)]">8 / 10 / 12</p>
                </div>
                <div class="flex items-center justify-between gap-4">
                  <div class="h-2 flex-1 rounded-full bg-[color:var(--ds-border)]"></div>
                  <p class="text-sm text-[color:var(--ds-muted)]">16 / 20 / 24</p>
                </div>
              </div>
            </div>
            <div class="overflow-hidden rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)]">
              <div class="flex items-center justify-between border-b border-[color:var(--ds-border)] px-5 py-3">
                <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ds-text)]">Radius</h3>
                <span class="text-[10px] uppercase tracking-[0.3em] text-[color:var(--ds-muted-2)]">Shapes</span>
              </div>
              <div class="flex items-center gap-4 p-6">
                <div class="h-10 w-10 rounded-md border border-[color:var(--ds-border-soft)]"></div>
                <div class="h-10 w-10 rounded-xl border border-[color:var(--ds-border-soft)]"></div>
                <div class="h-10 w-10 rounded-2xl border border-[color:var(--ds-border-soft)]"></div>
                <div class="h-10 w-10 rounded-full border border-[color:var(--ds-border-soft)]"></div>
              </div>
              <p class="px-6 pb-6 pt-1 text-xs text-[color:var(--ds-muted)]">Use rounded-2xl for cards, rounded-md for inputs, rounded-full for pills.</p>
            </div>
          </div>
        </section>

        <section id="components" class="scroll-mt-24 space-y-6 border-t border-[color:var(--ds-border)] pt-8">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-semibold text-[color:var(--ds-text)]">Components</h2>
            <span class="text-xs uppercase tracking-[0.3em] text-[color:var(--ds-muted-2)]">Preview</span>
          </div>
          <div class="grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
            <div class="rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)] p-6">
              <div class="flex flex-wrap items-center justify-between gap-4">
                <div>
                  <p class="text-xs uppercase tracking-[0.28em] text-[color:var(--ds-muted-2)]">Buttons</p>
                  <h3 class="mt-2 text-sm font-semibold text-[color:var(--ds-text)]">Action hierarchy</h3>
                  <p class="mt-2 text-sm text-[color:var(--ds-muted)]">Primary, secondary, ghost, and danger variants for clear intent.</p>
                </div>
                <span class="rounded-full border border-[color:var(--ds-border)] px-3 py-1 text-xs text-[color:var(--ds-muted)]">UI::Button</span>
              </div>
              <div class="mt-5 flex flex-wrap items-center gap-3">
                <button class="rounded-md bg-[color:var(--ds-accent)] px-4 py-2 text-sm font-semibold text-[color:var(--ds-bg)] hover:bg-[color:var(--ds-accent-strong)]">Primary</button>
                <button class="rounded-md bg-[color:var(--ds-surface-2)] px-4 py-2 text-sm font-semibold text-[color:var(--ds-text)] hover:bg-[color:var(--ds-border)]">Secondary</button>
                <button class="rounded-md border border-[color:var(--ds-border-soft)] px-4 py-2 text-sm font-semibold text-[color:var(--ds-text)] hover:bg-[color:var(--ds-surface-2)]">Ghost</button>
                <button class="rounded-md bg-[color:var(--ds-danger)] px-4 py-2 text-sm font-semibold text-[color:var(--ds-bg)] hover:opacity-90">Danger</button>
              </div>
              <pre class="mt-5 overflow-x-auto rounded-xl border border-[color:var(--ds-border)] bg-[color:var(--ds-bg)] p-4 text-xs text-[color:var(--ds-muted)]"><code>&lt;button class="rounded-md bg-[color:var(--ds-accent)] px-4 py-2 text-sm font-semibold"&gt;Primary&lt;/button&gt;</code></pre>
            </div>
            <div class="space-y-6">
              <div class="rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)] p-6">
                <div class="flex items-center justify-between">
                  <h3 class="text-sm font-semibold text-[color:var(--ds-text)]">Badges</h3>
                  <span class="text-xs text-[color:var(--ds-muted-2)]">UI::Badge</span>
                </div>
                <div class="mt-3 flex flex-wrap gap-2">
                  <span class="rounded-full bg-[color:var(--ds-surface-2)] px-3 py-1 text-xs text-[color:var(--ds-text)]">Default</span>
                  <span class="rounded-full bg-[color:var(--ds-accent-soft)] px-3 py-1 text-xs text-[color:var(--ds-accent-strong)]">Success</span>
                  <span class="rounded-full bg-[color:var(--ds-warm-soft)] px-3 py-1 text-xs text-[color:var(--ds-warm)]">Warning</span>
                  <span class="rounded-full bg-[color:var(--ds-danger-soft)] px-3 py-1 text-xs text-[color:var(--ds-danger)]">Danger</span>
                </div>
              </div>
              <div class="rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)] p-6">
                <div class="flex items-center justify-between">
                  <h3 class="text-sm font-semibold text-[color:var(--ds-text)]">Inputs</h3>
                  <span class="text-xs text-[color:var(--ds-muted-2)]">UI::Input</span>
                </div>
                <div class="mt-3 space-y-3">
                  <input type="text" placeholder="Search series" class="w-full rounded-md border border-[color:var(--ds-border)] bg-[color:var(--ds-bg)] px-3 py-2 text-sm text-[color:var(--ds-text)] placeholder:text-[color:var(--ds-muted-2)] focus:border-[color:var(--ds-accent)] focus:outline-none" />
                  <div class="flex items-center gap-3">
                    <label class="flex items-center gap-2 text-sm text-[color:var(--ds-muted)]">
                      <input type="checkbox" class="h-4 w-4 rounded border-[color:var(--ds-border)] bg-[color:var(--ds-bg)] text-[color:var(--ds-accent)] focus:ring-[color:var(--ds-accent)]" />
                      Auto-download
                    </label>
                    <span class="text-xs text-[color:var(--ds-muted-2)]">Auto-applies</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="grid gap-6 lg:grid-cols-2">
            <div class="rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)] p-6">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-semibold text-[color:var(--ds-text)]">Selects</h3>
                <span class="text-xs text-[color:var(--ds-muted-2)]">UI::Select</span>
              </div>
              <div class="mt-3">
                <%= form_with url: "#", method: :get, local: true do |form| %>
                  <%= render UI::SelectComponent.new(
                    form: form,
                    method: :reading_style,
                    label: "Reading style",
                    hint: "Auto-applies on change.",
                    options: [
                      ["Left to Right", "left_to_right"],
                      ["Right to Left", "right_to_left"],
                      ["Long Strip", "long_strip"]
                    ],
                    selected: "left_to_right"
                  ) %>
                <% end %>
              </div>
            </div>
            <div class="rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)] p-6">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-semibold text-[color:var(--ds-text)]">Toggles</h3>
                <span class="text-xs text-[color:var(--ds-muted-2)]">UI::ToggleSwitch</span>
              </div>
              <div class="mt-3">
                <%= form_with url: "#", method: :post, local: true do |form| %>
                  <%= render UI::ToggleSwitchComponent.new(
                    form: form,
                    method: :auto_download,
                    label: "Auto-download new chapters",
                    description: "Instantly pulls new chapters when available.",
                    on_value: "1",
                    off_value: "0"
                  ) %>
                <% end %>
              </div>
            </div>
          </div>
          <div class="rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)] p-6">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-semibold text-[color:var(--ds-text)]">Multi-select</h3>
              <span class="text-xs text-[color:var(--ds-muted-2)]">UI::MultiSelect</span>
            </div>
            <div class="mt-3">
              <%= render UI::MultiSelectComponent.new(
                name: "sources",
                label: "Sources",
                options: [
                  ["MangaDex", "mangadex"],
                  ["WeebCentral", "weebcentral"],
                  ["MangaPill", "mangapill"],
                  ["MangaSee", "mangasee"]
                ],
                selected: ["mangadex", "weebcentral"],
                filter_placeholder: "Filter sources",
                all_label: "All sources"
              ) %>
            </div>
          </div>
        </section>

        <section id="guidelines" class="scroll-mt-24 space-y-6 border-t border-[color:var(--ds-border)] pt-8">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-semibold text-[color:var(--ds-text)]">Guidelines</h2>
            <span class="text-xs uppercase tracking-[0.3em] text-[color:var(--ds-muted-2)]">Usage</span>
          </div>
          <div class="grid gap-6 md:grid-cols-2">
            <div class="rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)] p-6">
              <h3 class="text-sm font-semibold text-[color:var(--ds-text)]">Do</h3>
              <ul class="mt-3 space-y-2 text-sm text-[color:var(--ds-muted)]">
                <li>Use the accent color for the single primary action.</li>
                <li>Prefer concise labels with direct verbs.</li>
                <li>Keep secondary actions visually quiet.</li>
                <li>Use whitespace to separate content clusters.</li>
              </ul>
            </div>
            <div class="rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)] p-6">
              <h3 class="text-sm font-semibold text-[color:var(--ds-text)]">Don't</h3>
              <ul class="mt-3 space-y-2 text-sm text-[color:var(--ds-muted)]">
                <li>Stack multiple bright buttons in one row.</li>
                <li>Use borders where spacing solves the layout.</li>
                <li>Introduce motion without meaning.</li>
                <li>Over-label; let hierarchy do the work.</li>
              </ul>
            </div>
          </div>
          <div class="rounded-2xl border border-[color:var(--ds-border)] bg-[color:var(--ds-surface)] p-6">
            <h3 class="text-sm font-semibold text-[color:var(--ds-text)]">Accessibility</h3>
            <p class="mt-2 text-sm text-[color:var(--ds-muted)]">
              Maintain 4.5:1 contrast for body text, preserve focus rings, and ensure hover states never carry meaning alone.
            </p>
          </div>
        </section>

        <section id="roadmap" class="scroll-mt-24 space-y-6 border-t border-[color:var(--ds-border)] pt-8">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-semibold text-[color:var(--ds-text)]">Roadmap</h2>
