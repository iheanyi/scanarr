                  <%= icon "layout-dashboard", class: "h-[18px] w-[18px] text-accent" %>
                </div>
                <h3 class="text-sm font-semibold text-foreground">Data Display</h3>
              </div>
              <p class="text-xs text-muted leading-relaxed">Cards for items, lists for chapters, grids for libraries.</p>
            </div>
            <div class="rounded-xl border border-border bg-surface p-4">
              <div class="flex items-center gap-3 mb-2">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 border border-accent/20">
                  <%= icon "loader", class: "h-[18px] w-[18px] text-accent" %>
                </div>
                <h3 class="text-sm font-semibold text-foreground">Loading States</h3>
              </div>
              <p class="text-xs text-muted leading-relaxed">Skeleton screens, spinners for actions, progress for downloads.</p>
            </div>
            <div class="rounded-xl border border-border bg-surface p-4">
              <div class="flex items-center gap-3 mb-2">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 border border-accent/20">
                  <%= icon "inbox", class: "h-[18px] w-[18px] text-accent" %>
                </div>
                <h3 class="text-sm font-semibold text-foreground">Empty States</h3>
              </div>
              <p class="text-xs text-muted leading-relaxed">Helpful messages with clear next actions when no content.</p>
            </div>
            <div class="rounded-xl border border-border bg-surface p-4">
              <div class="flex items-center gap-3 mb-2">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 border border-accent/20">
                  <%= icon "circle-check", class: "h-[18px] w-[18px] text-accent" %>
                </div>
                <h3 class="text-sm font-semibold text-foreground">Feedback</h3>
              </div>
              <p class="text-xs text-muted leading-relaxed">Toast notifications, inline validation, status badges.</p>
            </div>
            <div class="rounded-xl border border-border bg-surface p-4">
              <div class="flex items-center gap-3 mb-2">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 border border-accent/20">
                  <%= icon "layers", class: "h-[18px] w-[18px] text-accent" %>
                </div>
                <h3 class="text-sm font-semibold text-foreground">Overlays</h3>
              </div>
              <p class="text-xs text-muted leading-relaxed">Modals for focus, dialogs for confirmation, popovers for context.</p>
            </div>
          </div>
        </section>

        <section id="guidelines" class="scroll-mt-24 space-y-6 border-t border-border pt-8">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-2xl font-semibold text-foreground">Guidelines</h2>
            <span class="text-xs uppercase tracking-[0.3em] text-muted-2">Usage</span>
          </div>
          <div class="grid gap-6 md:grid-cols-2">
            <div class="rounded-2xl border border-border bg-surface p-6">
              <h3 class="text-sm font-semibold text-foreground">Do</h3>
              <ul class="mt-3 space-y-2 text-sm text-muted">
                <li>Use the accent color for the single primary action.</li>
                <li>Prefer concise labels with direct verbs.</li>
                <li>Keep secondary actions visually quiet.</li>
                <li>Use whitespace to separate content clusters.</li>
              </ul>
            </div>
            <div class="rounded-2xl border border-border bg-surface p-6">
              <h3 class="text-sm font-semibold text-foreground">Don't</h3>
              <ul class="mt-3 space-y-2 text-sm text-muted">
                <li>Stack multiple bright buttons in one row.</li>
                <li>Use borders where spacing solves the layout.</li>
                <li>Introduce motion without meaning.</li>
                <li>Over-label; let hierarchy do the work.</li>
              </ul>
            </div>
          </div>
          <div class="rounded-2xl border border-border bg-surface p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-sm font-semibold text-foreground">Accessibility</h3>
              <span class="text-xs text-muted-2">WCAG 2.1 AA</span>
            </div>
            <div class="grid gap-4 md:grid-cols-2">
              <div class="space-y-3">
                <div class="flex items-start gap-3">
                  <div class="mt-0.5 h-5 w-5 flex-shrink-0 rounded-full bg-success-soft flex items-center justify-center">
                    <%= icon "check", class: "size-3 text-success", stroke_width: "3" %>
                  </div>
                  <div>
                    <p class="text-sm text-foreground">4.5:1 contrast for body text</p>
                    <p class="text-xs text-muted-2">3:1 for large text (18px+ or 14px bold)</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="mt-0.5 h-5 w-5 flex-shrink-0 rounded-full bg-success-soft flex items-center justify-center">
                    <%= icon "check", class: "size-3 text-success", stroke_width: "3" %>
                  </div>
                  <div>
                    <p class="text-sm text-foreground">Visible focus indicators</p>
                    <p class="text-xs text-muted-2">2px ring with accent color on all interactive elements</p>
                  </div>
                </div>
              </div>
              <div class="space-y-3">
                <div class="flex items-start gap-3">
                  <div class="mt-0.5 h-5 w-5 flex-shrink-0 rounded-full bg-success-soft flex items-center justify-center">
                    <%= icon "check", class: "size-3 text-success", stroke_width: "3" %>
                  </div>
                  <div>
                    <p class="text-sm text-foreground">Color is not the only indicator</p>
                    <p class="text-xs text-muted-2">Icons, text, or patterns supplement color meaning</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="mt-0.5 h-5 w-5 flex-shrink-0 rounded-full bg-success-soft flex items-center justify-center">
                    <%= icon "check", class: "size-3 text-success", stroke_width: "3" %>
                  </div>
                  <div>
                    <p class="text-sm text-foreground">Touch targets 44x44px minimum</p>
                    <p class="text-xs text-muted-2">Adequate spacing between interactive elements</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="roadmap" class="scroll-mt-24 space-y-6 border-t border-border pt-8">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-2xl font-semibold text-foreground">Roadmap</h2>
            <span class="text-xs uppercase tracking-[0.3em] text-muted-2">Phases</span>
          </div>
          <div class="space-y-4">
            <div class="rounded-2xl border border-border bg-surface p-6">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="text-sm text-foreground">Phase 0 - Foundation setup + design system page</p>
                  <p class="mt-2 text-xs text-muted-2">Base layout, public docs, and early component scaffolding.</p>
                </div>
                <span class="rounded-full bg-success-soft px-3 py-1 text-xs text-success">Done</span>
              </div>
            </div>
            <div class="rounded-2xl border border-border bg-surface p-6">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="text-sm text-foreground">Phase 1 - Icons, tokens, base component</p>
                  <p class="mt-2 text-xs text-muted-2">Lucide icons, semantic color tokens, BaseComponent with cn() helper.</p>
                </div>
                <span class="rounded-full bg-success-soft px-3 py-1 text-xs text-success">Done</span>
              </div>
            </div>
            <div class="rounded-2xl border border-border bg-surface p-6">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="text-sm text-foreground">Phase 2 - Button, badge, spinner, toggle, dropdown, card</p>
                  <p class="mt-2 text-xs text-muted-2">Action surfaces, status markers, and interactive containers.</p>
                </div>
                <span class="rounded-full bg-success-soft px-3 py-1 text-xs text-success">Done</span>
              </div>
            </div>
            <div class="rounded-2xl border border-border bg-surface p-6">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="text-sm text-foreground">Phase 3 - Forms, selects, multi-select, input</p>
                  <p class="mt-2 text-xs text-muted-2">Form components with auto-submit, redirect select, and empty states.</p>
                </div>
                <span class="rounded-full bg-success-soft px-3 py-1 text-xs text-success">Done</span>
              </div>
            </div>
            <div class="rounded-2xl border border-border bg-surface p-6">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="text-sm text-foreground">Phase 4 - Token reconciliation + raw color cleanup</p>
                  <p class="mt-2 text-xs text-muted-2">Unified naming, semantic tokens everywhere, zero raw Tailwind colors.</p>
                </div>
                <span class="rounded-full bg-success-soft px-3 py-1 text-xs text-success">Done</span>
              </div>
            </div>
            <div class="rounded-2xl border border-border bg-surface p-6">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="text-sm text-foreground">Phase 5 - Layout patterns, feedback, series refactor</p>
                  <p class="mt-2 text-xs text-muted-2">Full coverage across notifications, layout, and product surfaces.</p>
                </div>
                <span class="rounded-full bg-accent-soft px-3 py-1 text-xs text-accent-strong">In progress</span>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</div>
