<% content_for :page_direction, ScanarrThemes::DEFAULT %>
<% content_for :scanarr_theme, "midnight-panel" %>
<% content_for :ui_picker, true %>
<% directions = [
  {
    id: "palette-midnight-panel",
    step: "Default",
    name: "Midnight Panel",
    flag: "App theme",
    summary: "Near-black navy, muted periwinkle command state, and crisp manga-tech control surfaces.",
    focus: "The live default: Panel Pulse clarity without cyan arcade energy or coral heat."
  },
  {
    id: "palette-paper-shadow",
    step: "Candidate 02",
    name: "Paper Shadow",
    flag: "Reader",
    summary: "Graphite-black chrome with a warm manga-page command color and softer physical-library cues.",
    focus: "Best default candidate if we want a mature reading surface where covers own the saturation."
  },
  {
    id: "palette-riso-noir",
    step: "Candidate 03",
    name: "Riso Noir",
    flag: "Graphic",
    summary: "Deep black, controlled violet command state, and a stranger night-print manga personality.",
    focus: "Best default candidate if Scanarr should feel more distinctive without going neon cyberpunk."
  }
] %>
<% palette_options = ScanarrThemes::THEMES %>

<div id="design-system" class="relative overflow-hidden rounded-[28px] bg-background p-4 pb-24 text-foreground sm:rounded-[32px] sm:p-6 sm:pb-24">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute inset-0 ds-radial-1"></div>
    <div class="absolute inset-0 ds-radial-2"></div>
    <div class="absolute inset-0 ds-grid opacity-25"></div>
  </div>

  <div class="relative space-y-8">
    <section class="scanarr-hero-panel rounded-[2rem] p-6 sm:p-8">
      <div class="relative grid gap-8 xl:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
        <div class="space-y-5">
          <p class="text-xs uppercase tracking-[0.35em] text-muted-2">Reader Control Room</p>
          <div class="space-y-3">
            <h1 class="max-w-4xl text-3xl font-semibold tracking-tight text-foreground sm:text-5xl">
              Midnight Panel is the Scanarr default.
            </h1>
            <p class="max-w-3xl text-sm text-muted sm:text-base">
              The app shell is near-black navy, controls use a muted periwinkle command color, and manga covers carry the
              expressive weight. The other palettes remain available for contrast and future theme choices.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 text-[11px] text-muted">
            <span class="rounded-full border border-accent/30 bg-accent-soft px-3 py-1.5 font-semibold text-accent">Midnight Panel default</span>
            <span class="rounded-full border border-border bg-surface/70 px-3 py-1.5">Cover-led color</span>
            <span class="rounded-full border border-border bg-surface/70 px-3 py-1.5">No gradient wash</span>
          </div>
        </div>

        <div class="grid gap-3">
          <% directions.each do |direction| %>
            <a href="#<%= direction[:id] %>"
               class="group rounded-2xl border border-border/80 bg-surface/70 p-4 transition-colors hover:border-accent/40 hover:bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">
              <div class="flex items-start justify-between gap-3">
                <div class="space-y-2">
                  <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-muted-2"><%= direction[:step] %></p>
                  <div class="flex flex-wrap items-center gap-2">
                    <h2 class="text-lg font-semibold text-foreground"><%= direction[:name] %></h2>
                    <span class="rounded-full border border-border bg-background/70 px-2.5 py-1 text-[10px] uppercase tracking-[0.18em] text-muted-2">
                      <%= direction[:flag] %>
                    </span>
                  </div>
                  <p class="text-sm text-muted"><%= direction[:summary] %></p>
                </div>
                <%= icon "arrow-down-right", class: "mt-1 size-4 text-muted transition-transform group-hover:translate-x-0.5 group-hover:translate-y-0.5 group-hover:text-foreground" %>
              </div>
            </a>
          <% end %>
        </div>
      </div>
    </section>

    <section class="scanarr-subtle-panel rounded-[2rem] p-4 sm:p-5">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-xs uppercase tracking-[0.28em] text-muted-2">Color roles</p>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight text-foreground">Color earns its place.</h2>
        </div>
        <p class="max-w-xl text-sm text-muted">
          Midnight Panel uses one command hue and four semantic state colors. Product surfaces stay restrained so manga art
          keeps the emotional color.
        </p>
      </div>

      <div class="mt-5 grid gap-3 md:grid-cols-2 xl:grid-cols-5">
        <div class="rounded-2xl border border-accent/30 bg-accent-soft p-4">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Command</p>
          <h3 class="mt-3 text-lg font-semibold text-foreground">Panel Periwinkle</h3>
          <p class="mt-2 text-sm text-foreground/80">Primary actions, current selection, focus, and deliberate command moments.</p>
        </div>
        <div class="rounded-2xl border border-success/30 bg-success-soft p-4">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-success">Complete</p>
          <h3 class="mt-3 text-lg font-semibold text-foreground">Download Mint</h3>
          <p class="mt-2 text-sm text-foreground/80">Completed chapters, healthy downloads, and positive confirmations.</p>
        </div>
        <div class="rounded-2xl border border-warning/30 bg-warning-soft p-4">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-warning">Queued</p>
          <h3 class="mt-3 text-lg font-semibold text-foreground">Queue Amber</h3>
          <p class="mt-2 text-sm text-foreground/80">Pending checks, waiting work, and warnings that should not feel fatal.</p>
        </div>
        <div class="rounded-2xl border border-danger/30 bg-danger-soft p-4">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-danger">Failure</p>
          <h3 class="mt-3 text-lg font-semibold text-foreground">Failure Rose</h3>
          <p class="mt-2 text-sm text-foreground/80">Errors, destructive actions, failed jobs, and broken source states.</p>
        </div>
        <div class="rounded-2xl border border-info/30 bg-info-soft p-4">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-info">Info</p>
          <h3 class="mt-3 text-lg font-semibold text-foreground">Reader Blue</h3>
          <p class="mt-2 text-sm text-foreground/80">Neutral progress, links, and explanatory state that supports scanning.</p>
        </div>
      </div>
    </section>

    <section id="palette-lab" class="scanarr-subtle-panel rounded-[2rem] p-4 sm:p-6">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="space-y-3">
          <p class="text-xs uppercase tracking-[0.28em] text-muted-2">Palette lab</p>
          <h2 class="max-w-3xl text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
            Flip between Midnight Panel and alternate themes.
          </h2>
          <p class="max-w-3xl text-sm text-muted sm:text-base">
            Midnight Panel is the live default. Paper Shadow, Riso Noir, Signal Coral, and the older explorations stay in
            the picker for comparison and future user-selectable themes.
          </p>
        </div>
        <a href="#palette-lab" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-border bg-background/70 px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-accent/40 hover:text-accent-strong focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">
          <%= icon "palette", class: "size-4" %>
          App theme
        </a>
      </div>

      <div data-uidotsh-pick="App theme" class="contents">
        <% palette_options.each_with_index do |palette, index| %>
          <% option_label = palette[:id] == ScanarrThemes::DEFAULT ? "#{palette[:name]} (default)" : palette[:name] %>
          <article id="palette-<%= palette[:id] %>" data-uidotsh-option="<%= option_label %>" data-direction="<%= palette[:id] %>" class="contents" <%= "hidden" if index.positive? %>>
            <div class="mt-6 rounded-[1.75rem] border border-border/80 bg-background p-4 text-foreground sm:p-5">
              <div class="grid gap-5 xl:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)]">
                <div class="space-y-5">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-muted">
                      <%= palette[:mood] %>
                    </span>
                    <% palette[:tags].each do |tag| %>
                      <span class="rounded-full border border-border/70 bg-surface/60 px-3 py-1 text-xs text-muted-2"><%= tag %></span>
                    <% end %>
                  </div>

                  <div class="space-y-3">
                    <h3 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl"><%= palette[:name] %></h3>
                    <p class="max-w-[68ch] text-base text-muted"><%= palette[:summary] %></p>
                    <p class="max-w-[68ch] text-sm text-muted-2"><%= palette[:best_for] %></p>
                  </div>

                  <div class="grid gap-3 sm:grid-cols-3">
                    <div class="rounded-2xl border border-border bg-surface p-3">
                      <div class="h-12 rounded-xl border border-border" style="background-color: <%= palette[:base] %>"></div>
                      <p class="mt-3 text-xs text-muted-2">Base</p>
                      <p class="font-mono text-sm text-foreground"><%= palette[:base] %></p>
                    </div>
                    <div class="rounded-2xl border border-border bg-surface p-3">
                      <div class="h-12 rounded-xl border border-border" style="background-color: <%= palette[:surface] %>"></div>
                      <p class="mt-3 text-xs text-muted-2">Surface</p>
                      <p class="font-mono text-sm text-foreground"><%= palette[:surface] %></p>
                    </div>
                    <div class="rounded-2xl border border-border bg-surface p-3">
                      <div class="h-12 rounded-xl border border-border" style="background-color: <%= palette[:accent] %>"></div>
                      <p class="mt-3 text-xs text-muted-2">Accent</p>
                      <p class="font-mono text-sm text-foreground"><%= palette[:accent] %></p>
                    </div>
                  </div>
                </div>

                <div class="rounded-[1.5rem] border border-border bg-surface p-4">
                  <div class="grid min-h-[26rem] overflow-hidden rounded-[1.25rem] border border-border bg-background lg:grid-cols-[11rem_minmax(0,1fr)]">
                    <aside class="border-b border-border bg-surface p-4 lg:border-r lg:border-b-0">
                      <div class="flex items-center gap-2">
                        <div class="size-8 rounded-lg bg-accent"></div>
                        <div>
                          <p class="text-sm font-semibold text-foreground">Scanarr</p>
                          <p class="text-xs text-muted-2">Source browser</p>
                        </div>
                      </div>
                      <nav class="mt-6 grid gap-2 text-sm text-muted">
                        <span class="rounded-lg border border-border bg-background px-3 py-2 text-foreground">Browse</span>
                        <span class="px-3 py-2">Library</span>
                        <span class="px-3 py-2">Queue</span>
                        <span class="px-3 py-2">Settings</span>
                      </nav>
                    </aside>

                    <div class="space-y-4 p-4">
                      <div class="rounded-2xl border border-border bg-surface-2 p-4">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                          <div>
                            <p class="text-xs text-muted-2">Latest Series</p>
                            <h4 class="mt-2 text-2xl font-semibold tracking-tight text-foreground">Flame Comics</h4>
                            <p class="mt-2 max-w-[48ch] text-sm text-muted">
                              Browse cards, descriptions, metadata, status chips, and reader controls under the same token set.
                            </p>
                          </div>
                          <span class="rounded-full bg-accent px-3 py-1 text-xs font-semibold text-accent-foreground">Open</span>
                        </div>
                      </div>

                      <div class="grid gap-3 sm:grid-cols-3">
                        <% [ "Cover", "Progress", "Reader" ].each_with_index do |label, item_index| %>
                          <div class="rounded-2xl border border-border bg-surface p-3">
                            <div class="aspect-[3/4] rounded-xl border border-border bg-background">
                              <div class="h-full rounded-xl bg-accent-soft"></div>
                            </div>
                            <p class="mt-3 text-sm font-medium text-foreground"><%= label %></p>
                            <p class="text-xs text-muted-2"><%= [ "Art stays dominant", "Status stays legible", "Chrome stays quiet" ][item_index] %></p>
                          </div>
                        <% end %>
                      </div>

                      <div class="grid gap-3 sm:grid-cols-3">
                        <div class="rounded-2xl border border-border bg-background p-3">
                          <p class="text-xs text-muted-2">Queued</p>
                          <p class="mt-1 text-2xl font-semibold text-foreground">24</p>
                        </div>
                        <div class="rounded-2xl border border-border bg-background p-3">
                          <p class="text-xs text-muted-2">Unread</p>
                          <p class="mt-1 text-2xl font-semibold text-foreground">118</p>
                        </div>
                        <div class="rounded-2xl border border-border bg-background p-3">
                          <p class="text-xs text-muted-2">Errors</p>
                          <p class="mt-1 text-2xl font-semibold text-danger">2</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    </section>

    <details class="scanarr-subtle-panel rounded-[2rem] p-4 sm:p-5">
      <summary class="cursor-pointer list-none rounded-[1.5rem] select-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-focus">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="text-xs uppercase tracking-[0.28em] text-muted-2">Archive</p>
            <h2 class="mt-2 text-xl font-semibold text-foreground">Earlier direction explorations</h2>
            <p class="mt-2 max-w-2xl text-sm text-muted">
              Ink Noir, Editorial Shelf, and Panel Pulse stay here as reference paths now that Midnight Panel drives the live system.
            </p>
          </div>
          <span class="rounded-full border border-border bg-background/70 px-3 py-1 text-xs uppercase tracking-[0.18em] text-muted-2">
            Expand archive
          </span>
        </div>
      </summary>

      <div class="mt-5 space-y-6">
        <article id="ink-noir" data-direction="ink-noir" class="ds-direction-card rounded-[2rem] p-4 sm:p-6">
      <div class="relative space-y-6">
        <div class="flex flex-col gap-5 xl:flex-row xl:items-start xl:justify-between">
          <div class="max-w-3xl space-y-4">
            <span class="ds-direction-label"><%= icon "moon-star", class: "size-3.5" %> Ink Noir</span>
            <div class="space-y-3">
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="text-3xl font-semibold text-foreground">Cinematic contrast, poster-led covers, quieter chrome.</h2>
                <span class="rounded-full border border-accent/30 bg-accent-soft px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-accent-foreground/90">
                  Archived exploration
                </span>
              </div>
              <p class="max-w-2xl text-sm text-muted">
                The app fades back so the art can dominate. Navigation becomes more atmospheric, chapter rows gain
                stronger visual grouping, and the reader shifts toward an immersive theater rather than a utility page.
              </p>
            </div>
            <div class="flex flex-wrap gap-2 text-xs">
              <span class="ds-direction-pill rounded-full px-3 py-1.5">Reader immersion</span>
              <span class="ds-direction-pill rounded-full px-3 py-1.5">Punchy cover moments</span>
              <span class="ds-direction-pill rounded-full px-3 py-1.5">Sharper action hierarchy</span>
            </div>
          </div>

          <div class="grid min-w-0 gap-2 sm:min-w-[260px] sm:grid-cols-3">
            <div class="rounded-2xl border border-border/80 bg-background/70 p-3">
              <div class="h-10 rounded-xl bg-background"></div>
              <p class="mt-3 text-xs uppercase tracking-[0.18em] text-muted-2">Base</p>
              <p class="text-sm text-foreground">#05070b</p>
            </div>
            <div class="rounded-2xl border border-border/80 bg-background/70 p-3">
              <div class="h-10 rounded-xl bg-surface"></div>
              <p class="mt-3 text-xs uppercase tracking-[0.18em] text-muted-2">Surface</p>
              <p class="text-sm text-foreground">#0d1219</p>
            </div>
            <div class="rounded-2xl border border-border/80 bg-background/70 p-3">
              <div class="h-10 rounded-xl bg-accent"></div>
              <p class="mt-3 text-xs uppercase tracking-[0.18em] text-muted-2">Accent</p>
              <p class="text-sm text-foreground">#f04367</p>
            </div>
          </div>
        </div>

        <div class="grid gap-6 xl:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
          <div class="ds-direction-shell grid-cols-[92px_minmax(0,1fr)]">
            <div class="ds-direction-sidebar flex flex-col justify-between p-4 text-sm text-muted">
              <div class="space-y-6">
                <div>
                  <p class="text-[10px] uppercase tracking-[0.28em] text-muted-2">Scanarr</p>
                  <p class="mt-2 text-base font-semibold text-foreground">Night Mode</p>
                </div>
                <div class="space-y-3">
                  <div class="rounded-2xl border border-border/80 bg-background/40 p-3 text-foreground">Library</div>
                  <div>Browse</div>
                  <div>History</div>
                  <div>Offline</div>
                </div>
              </div>
              <div class="space-y-2">
                <div class="h-1.5 rounded-full bg-surface-2">
                  <div class="h-1.5 w-3/4 rounded-full bg-accent"></div>
                </div>
                <p class="text-xs text-muted-2">Reader progress as mood lighting</p>
              </div>
            </div>

            <div class="flex flex-col gap-4 p-4">
              <div class="ds-direction-surface rounded-[1.5rem] p-4">
                <div class="flex items-start justify-between gap-4">
                  <div class="space-y-2">
                    <p class="text-[11px] uppercase tracking-[0.22em] text-muted-2">Featured series</p>
                    <h3 class="text-2xl font-semibold text-foreground">Blue Lock</h3>
                    <p class="max-w-lg text-sm text-muted">
                      Covers read like poster art, while secondary metadata stays intentionally recessive.
                    </p>
                  </div>
                  <span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent-strong">Read now</span>
                </div>
              </div>

              <div class="grid gap-4 sm:grid-cols-3">
                <% [ "Blue Lock", "Dandadan", "Chainsaw Man" ].each do |title| %>
                  <div class="space-y-3">
                    <div class="ds-direction-cover aspect-[2/3] rounded-[1.5rem]"></div>
                    <div class="space-y-1">
                      <p class="text-sm font-semibold text-foreground"><%= title %></p>
                      <p class="text-xs text-muted-2">Unread chapter spotlight</p>
                    </div>
                  </div>
                <% end %>
              </div>

              <div class="grid gap-3 sm:grid-cols-3">
                <div class="ds-direction-metric rounded-2xl p-3">
                  <p class="text-xs uppercase tracking-[0.18em] text-muted-2">Unread</p>
                  <p class="mt-2 text-2xl font-semibold text-foreground">18</p>
                </div>
                <div class="ds-direction-metric rounded-2xl p-3">
                  <p class="text-xs uppercase tracking-[0.18em] text-muted-2">Downloaded</p>
                  <p class="mt-2 text-2xl font-semibold text-foreground">642</p>
                </div>
                <div class="ds-direction-metric rounded-2xl p-3">
                  <p class="text-xs uppercase tracking-[0.18em] text-muted-2">In progress</p>
                  <p class="mt-2 text-2xl font-semibold text-foreground">4</p>
                </div>
              </div>
            </div>
          </div>

          <div class="space-y-6">
            <div class="ds-direction-surface rounded-[1.75rem] p-4">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="text-[11px] uppercase tracking-[0.22em] text-muted-2">Reader preview</p>
                  <h3 class="mt-2 text-xl font-semibold text-foreground">Focus mode with visible progress, softer chrome.</h3>
                </div>
                <span class="rounded-full border border-border/80 bg-background/70 px-3 py-1 text-xs text-muted">Right to left</span>
              </div>
              <div class="mt-4 rounded-[1.5rem] border border-border/80 bg-background/70 p-4">
                <div class="flex items-center justify-between text-xs text-muted">
                  <span>Page 17 / 41</span>
                  <span class="text-accent-strong">42%</span>
                </div>
                <div class="mt-2 h-1.5 rounded-full bg-surface-2">
                  <div class="h-1.5 w-[42%] rounded-full bg-accent"></div>
                </div>
                <div class="mt-4 grid gap-3 sm:grid-cols-3">
                  <div class="ds-direction-page h-72 rounded-[1.4rem]"></div>
                  <div class="ds-direction-page h-72 rounded-[1.4rem]"></div>
                  <div class="ds-direction-page h-72 rounded-[1.4rem]"></div>
                </div>
              </div>
            </div>

            <div class="ds-direction-surface rounded-[1.75rem] p-4">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <p class="text-[11px] uppercase tracking-[0.22em] text-muted-2">Chapter list</p>
                  <h3 class="mt-2 text-xl font-semibold text-foreground">Rows grouped into stronger reading blocks.</h3>
                </div>
                <span class="rounded-full border border-border/80 bg-background/70 px-3 py-1 text-xs text-muted">Priority on latest unread</span>
              </div>
              <div class="mt-4 space-y-3">
                <% [
                  [ "Chapter 154", "Unread · 8 minutes ago", "New" ],
                  [ "Chapter 153", "Page 12/19 · yesterday", "Continue" ],
                  [ "Chapter 152", "Downloaded · completed", "Offline" ]
                ].each do |chapter, meta, tag| %>
                  <div class="rounded-2xl border border-border/80 bg-background/70 px-4 py-3">
                    <div class="flex items-center justify-between gap-3">
                      <div class="space-y-1">
                        <p class="text-sm font-semibold text-foreground"><%= chapter %></p>
                        <p class="text-xs text-muted-2"><%= meta %></p>
                      </div>
                      <span class="rounded-full bg-accent-soft px-3 py-1 text-[11px] font-semibold text-accent-strong"><%= tag %></span>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
        </article>

        <article id="editorial-shelf" data-direction="editorial-shelf" class="ds-direction-card rounded-[2rem] p-4 sm:p-6">
      <div class="relative space-y-6">
        <div class="flex flex-col gap-5 xl:flex-row xl:items-start xl:justify-between">
          <div class="max-w-3xl space-y-4">
            <span class="ds-direction-label"><%= icon "library-big", class: "size-3.5" %> Editorial Shelf</span>
            <div class="space-y-3">
              <h2 class="text-3xl font-semibold text-foreground">Warmer, curated, and more like a collector’s shelf than a utility console.</h2>
              <p class="max-w-2xl text-sm text-muted">
                This direction gives library and series pages a premium editorial tone. It favors warm neutrals, quieter
                borders, and the feeling that your collection has been selected, not merely stored.
              </p>
            </div>
            <div class="flex flex-wrap gap-2 text-xs">
              <span class="ds-direction-pill rounded-full px-3 py-1.5">Library-led identity</span>
              <span class="ds-direction-pill rounded-full px-3 py-1.5">Richer metadata framing</span>
              <span class="ds-direction-pill rounded-full px-3 py-1.5">Soft premium surfaces</span>
            </div>
          </div>

          <div class="grid min-w-0 gap-2 sm:min-w-[260px] sm:grid-cols-3">
            <div class="rounded-2xl border border-border/80 bg-background/70 p-3">
              <div class="h-10 rounded-xl bg-background"></div>
              <p class="mt-3 text-xs uppercase tracking-[0.18em] text-muted-2">Base</p>
              <p class="text-sm text-foreground">#111318</p>
            </div>
            <div class="rounded-2xl border border-border/80 bg-background/70 p-3">
              <div class="h-10 rounded-xl bg-surface"></div>
              <p class="mt-3 text-xs uppercase tracking-[0.18em] text-muted-2">Surface</p>
              <p class="text-sm text-foreground">#1b1e24</p>
