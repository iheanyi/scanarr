<% nav_link_attributes = lambda do |path, active: current_page?(path)|
     base = "flex min-h-11 items-center gap-2.5 rounded-lg px-3 py-2 text-sm transition-colors"
     state = active ? "bg-surface-2 text-foreground font-semibold" : "text-muted hover:text-foreground hover:bg-surface-2/60"
     { class: "#{base} #{state}", aria: (active ? { current: "page" } : nil), data: { action: "click->drawer#close" } }.compact
   end %>
<% library_active = controller_name == "library" || controller_name == "series" || controller_name == "chapters" %>
<% discover_active = controller_name == "sources" %>
<% organize_paths = [ calendar_path, stats_path, export_path, source_migrations_path ] %>
<% admin_active = controller_path.start_with?("admin/") || controller_name == "design_system" %>

<div class="flex h-full flex-col gap-6">
  <nav aria-label="Main navigation" class="flex flex-col gap-5 text-sm text-muted" data-sidebar-nav="true">
    <div class="space-y-0.5">
      <%= link_to library_path, nav_link_attributes.call(library_path, active: library_active) do %>
        <%= icon "book-open", class: "h-4 w-4 shrink-0", aria: { hidden: true } %>
        Library
      <% end %>
      <%= link_to search_path, nav_link_attributes.call(search_path) do %>
        <%= icon "search", class: "h-4 w-4 shrink-0", aria: { hidden: true } %>
        Find manga
      <% end %>
      <%= link_to sources_path, nav_link_attributes.call(sources_path, active: discover_active) do %>
        <%= icon "compass", class: "h-4 w-4 shrink-0", aria: { hidden: true } %>
        Browse sources
      <% end %>
      <%= link_to reading_history_path, nav_link_attributes.call(reading_history_path) do %>
        <%= icon "history", class: "h-4 w-4 shrink-0", aria: { hidden: true } %>
        Reading history
      <% end %>
      <% if local_downloads_enabled? %>
        <%= link_to offline_library_path, nav_link_attributes.call(offline_library_path) do %>
          <%= icon "download", class: "h-4 w-4 shrink-0", aria: { hidden: true } %>
          On this device
        <% end %>
      <% end %>
    </div>

    <details class="group" <%= "open" if organize_paths.any? { |path| current_page?(path) } %>>
      <summary class="flex min-h-11 cursor-pointer items-center justify-between rounded-lg px-3 text-sm text-muted hover:text-foreground">
        Library tools
        <%= icon "chevron-down", class: "h-4 w-4", aria: { hidden: true } %>
      </summary>
      <div class="mt-1 space-y-0.5">
        <% [ [ calendar_path, "calendar", "Release calendar" ], [ stats_path, "chart-bar", "Reading stats" ], [ export_path, "archive", "Import / export" ], [ source_migrations_path, "arrow-right-left", "Change sources" ] ].each do |path, glyph, label| %>
          <%= link_to path, nav_link_attributes.call(path) do %>
            <%= icon glyph, class: "h-4 w-4 shrink-0", aria: { hidden: true } %>
            <%= label %>
          <% end %>
        <% end %>
      </div>
    </details>

    <% if current_user&.admin? %>
      <details <%= "open" if admin_active %>>
        <summary class="flex min-h-11 cursor-pointer items-center justify-between rounded-lg px-3 text-sm text-muted hover:text-foreground">
          Server management
          <%= icon "chevron-down", class: "h-4 w-4", aria: { hidden: true } %>
        </summary>
        <div class="mt-1 space-y-0.5">
          <% [ [ admin_downloads_path, "download", "Server downloads" ], [ admin_source_catalog_path, "globe", "Source catalog" ], [ "/admin/jobs", "cpu", "Jobs" ], [ admin_scrapers_path, "activity", "Source health" ], [ admin_backups_path, "hard-drive", "Backups" ], [ admin_users_path, "users", "Users" ], [ design_system_path, "layers", "Design System" ] ].each do |path, glyph, label| %>
            <%= link_to path, nav_link_attributes.call(path) do %>
              <%= icon glyph, class: "h-4 w-4 shrink-0", aria: { hidden: true } %>
              <%= label %>
            <% end %>
          <% end %>
        </div>
      </details>
    <% end %>
    <%= link_to settings_path, nav_link_attributes.call(settings_path) do %>
      <%= icon "settings", class: "h-4 w-4 shrink-0", aria: { hidden: true } %>
      Settings
    <% end %>
  </nav>

  <% if authenticated? %>
    <div class="mt-auto flex items-center justify-between gap-3 border-t border-border pt-4">
      <div class="relative" data-controller="dropdown">
        <button type="button"
                data-action="click->dropdown#toggle"
                class="relative inline-flex items-center gap-2 rounded-md border border-border bg-surface-2 px-3 py-2 text-sm text-muted hover:text-foreground"
                aria-label="Open notifications">
          <%= icon "bell", class: "h-4 w-4", aria: { hidden: true } %>
          <span>Notifications</span>
          <span data-notification-count="true" class="ml-auto inline-flex h-4 min-w-4 items-center justify-center rounded-full <%= unread_notification_count > 0 ? "bg-accent text-[10px] font-semibold text-accent-foreground" : "" %>">
            <%= unread_notification_count > 0 ? (unread_notification_count > 9 ? "9+" : unread_notification_count) : "" %>
          </span>
        </button>
        <div data-dropdown-target="menu" class="hidden absolute left-0 bottom-full mb-2 w-80 max-w-[calc(100vw-2rem)] rounded-lg border border-border bg-surface shadow-xl z-50">
          <div class="flex items-center justify-between border-b border-border px-4 py-2">
            <span class="text-sm font-semibold text-foreground">Notifications</span>
            <% if unread_notification_count > 0 %>
              <%= button_to mark_all_read_notifications_path, method: :post, class: "text-xs text-success hover:text-success", data: { turbo_submits_with: "Marking..." } do %>
                Mark all read
              <% end %>
            <% end %>
          </div>
          <div class="max-h-80 overflow-y-auto">
            <% if current_notifications.any? %>
              <% current_notifications.each do |notification| %>
                <div class="flex items-start gap-3 border-b border-border/50 px-4 py-3 hover:bg-surface-2/60">
                  <div class="flex-1 min-w-0">
                    <p class="text-sm text-foreground truncate"><%= notification.chapter.series.canonical_title %></p>
                    <p class="text-xs text-muted">Chapter <%= notification.chapter.chapter_number %></p>
                  </div>
                  <%= button_to mark_read_notification_path(notification), method: :post, class: "shrink-0 text-muted hover:text-foreground", data: { turbo_submits_with: "..." } do %>
                    <%= icon "check", class: "h-4 w-4" %>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <div class="px-4 py-6 text-center text-sm text-muted">
                No new notifications
              </div>
            <% end %>
          </div>
          <div class="border-t border-border px-4 py-2">
            <%= link_to "View all", notifications_path, class: "text-xs text-muted hover:text-foreground" %>
          </div>
        </div>
      </div>

      <%= button_to logout_path, method: :delete, class: "inline-flex items-center justify-center rounded-md border border-border bg-surface-2 p-2 text-muted hover:text-foreground", title: "Logout", aria: { label: "Logout" }, data: { turbo_confirm: "Log out?" } do %>
        <%= icon "log-out", class: "h-4 w-4", aria: { hidden: true } %>
      <% end %>
    </div>
  <% end %>
</div>
