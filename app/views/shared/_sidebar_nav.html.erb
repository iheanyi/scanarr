<% nav_link_attributes = lambda do |path|
     base = "flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors"
     active = "bg-surface-2 text-foreground font-semibold"
     inactive = "text-muted hover:text-foreground hover:bg-surface-2/60"
     is_active = current_page?(path)

     {
       class: "#{base} #{is_active ? active : inactive}",
       aria: (is_active ? { current: "page" } : nil),
       data: { action: "click->drawer#close" }
     }.compact
   end %>

<div class="flex h-full flex-col gap-6">
  <nav class="flex flex-col gap-6 text-sm text-muted" data-sidebar-nav="true">
    <div class="space-y-2">
      <span class="text-xs uppercase tracking-wider text-muted-2">Browse</span>
      <div class="flex flex-col gap-0.5">
        <%= link_to root_path, nav_link_attributes.call(root_path) do %>
          <%= icon "globe", class: "h-4 w-4 shrink-0" %>
          Sources
        <% end %>
        <%= link_to library_path, nav_link_attributes.call(library_path) do %>
          <%= icon "book-open", class: "h-4 w-4 shrink-0" %>
          Library
        <% end %>
        <%= link_to calendar_path, nav_link_attributes.call(calendar_path) do %>
          <%= icon "calendar", class: "h-4 w-4 shrink-0" %>
          Calendar
        <% end %>
        <%= link_to search_path, nav_link_attributes.call(search_path) do %>
          <%= icon "search", class: "h-4 w-4 shrink-0" %>
          Search
        <% end %>
        <%= link_to stats_path, nav_link_attributes.call(stats_path) do %>
          <%= icon "chart-bar", class: "h-4 w-4 shrink-0" %>
          Stats
        <% end %>
        <%= link_to reading_history_path, nav_link_attributes.call(reading_history_path) do %>
          <%= icon "history", class: "h-4 w-4 shrink-0" %>
          History
        <% end %>
        <%= link_to export_path, nav_link_attributes.call(export_path) do %>
          <%= icon "archive", class: "h-4 w-4 shrink-0" %>
          Export / Import
        <% end %>
      </div>
    </div>

    <div class="space-y-2">
      <span class="text-xs uppercase tracking-wider text-muted-2">Admin</span>
      <div class="flex flex-col gap-0.5">
        <%= link_to admin_downloads_path, nav_link_attributes.call(admin_downloads_path) do %>
          <%= icon "download", class: "h-4 w-4 shrink-0" %>
          Downloads
        <% end %>
        <%= link_to "/admin/jobs", nav_link_attributes.call("/admin/jobs") do %>
          <%= icon "cpu", class: "h-4 w-4 shrink-0" %>
          Jobs
        <% end %>
        <%= link_to admin_scrapers_path, nav_link_attributes.call(admin_scrapers_path) do %>
          <%= icon "activity", class: "h-4 w-4 shrink-0" %>
          Scrapers
        <% end %>
        <%= link_to admin_backups_path, nav_link_attributes.call(admin_backups_path) do %>
          <%= icon "hard-drive", class: "h-4 w-4 shrink-0" %>
          Backups
        <% end %>
        <%= link_to design_system_path, nav_link_attributes.call(design_system_path) do %>
          <%= icon "layers", class: "h-4 w-4 shrink-0" %>
          Design System
        <% end %>
      </div>
    </div>
  </nav>

  <% if user_signed_in? %>
    <div class="mt-auto flex items-center justify-between gap-3 border-t border-border pt-4">
      <div class="relative" data-controller="dropdown">
        <button type="button"
                data-action="click->dropdown#toggle"
                class="relative inline-flex items-center gap-2 rounded-md border border-border bg-surface-2 px-3 py-2 text-sm text-muted hover:text-foreground"
                aria-label="Open notifications">
          <%= icon "bell", class: "h-4 w-4", aria: { hidden: true } %>
          <span>Notifications</span>
          <span id="notification-count" class="ml-auto inline-flex h-4 min-w-4 items-center justify-center rounded-full <%= unread_notification_count > 0 ? "bg-accent text-[10px] font-semibold text-accent-foreground" : "" %>">
            <%= unread_notification_count > 0 ? (unread_notification_count > 9 ? "9+" : unread_notification_count) : "" %>
          </span>
        </button>
        <div data-dropdown-target="menu" class="hidden absolute left-0 bottom-full mb-2 w-80 max-w-[calc(100vw-2rem)] rounded-lg border border-border bg-surface shadow-xl z-50">
          <div class="flex items-center justify-between border-b border-border px-4 py-2">
            <span class="text-sm font-semibold text-foreground">Notifications</span>
            <% if unread_notification_count > 0 %>
              <%= button_to mark_all_read_notifications_path, method: :post, class: "text-xs text-success hover:text-success" do %>
                Mark all read
              <% end %>
            <% end %>
          </div>
          <div class="max-h-80 overflow-y-auto">
            <% if current_notifications.any? %>
              <% current_notifications.each do |notification| %>
                <div class="flex items-start gap-3 border-b border-border/50 px-4 py-3 hover:bg-surface-2/60">
                  <div class="flex-1 min-w-0">
                    <p class="text-sm text-foreground truncate"><%= notification.chapter.series.canonical_title %></p>
                    <p class="text-xs text-muted">Chapter <%= notification.chapter.chapter_number %></p>
                  </div>
                  <%= button_to mark_read_notification_path(notification), method: :post, class: "shrink-0 text-muted hover:text-foreground" do %>
                    <%= icon "check", class: "h-4 w-4" %>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <div class="px-4 py-6 text-center text-sm text-muted">
                No new notifications
              </div>
            <% end %>
          </div>
          <div class="border-t border-border px-4 py-2">
            <%= link_to "View all", notifications_path, class: "text-xs text-muted hover:text-foreground" %>
          </div>
        </div>
      </div>

      <%= button_to logout_path, method: :delete, class: "inline-flex items-center justify-center rounded-md border border-border bg-surface-2 p-2 text-muted hover:text-foreground", title: "Logout", aria: { label: "Logout" } do %>
        <%= icon "log-out", class: "h-4 w-4", aria: { hidden: true } %>
      <% end %>
    </div>
  <% end %>
</div>
