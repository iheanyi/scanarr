<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-preview">
<% end %>

<div class="space-y-6">
  <% if user_signed_in? %>
    <%= turbo_stream_from current_user, :notification_items %>
  <% end %>

  <%= render UI::PageHeaderComponent.new(title: "Notifications") do |header| %>
    <% if @notifications.any? { |n| !n.read? } %>
      <% header.with_actions do %>
        <%= form_with url: mark_all_read_notifications_path, method: :post, data: { turbo_submits_with: "Marking..." } do %>
          <%= render UI::ButtonComponent.new(variant: :ghost, size: :sm, type: "submit") do %>
            <%= icon "check", class: "h-4 w-4" %>
            Mark all as read
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if @notifications.any? %>
    <ul id="notification-list" class="divide-y divide-border rounded-lg border border-border bg-surface">
      <% @notifications.each do |notification| %>
        <li class="flex items-center gap-4 px-4 py-3 transition-colors hover:bg-surface-2/40 <%= notification.read? ? "opacity-60" : "" %>">
          <%= render UI::SeriesCoverComponent.new(url: notification.chapter.series.cover_image_url, alt: "", size: :xs, rounded: :sm, class: "shrink-0") %>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-foreground truncate"><%= notification.chapter.series.canonical_title %></p>
            <p class="text-sm text-muted">
              Chapter <%= notification.chapter.chapter_number %>
              <% if notification.chapter.title.present? %>
                - <%= notification.chapter.title %>
              <% end %>
            </p>
            <p class="text-xs text-muted-2"><%= time_ago_in_words(notification.created_at) %> ago</p>
          </div>
          <div class="flex items-center gap-2">
            <% source = notification.chapter.series.primary_source %>
            <% if source %>
              <%= link_to source_series_chapter_path(source_slug: source.slug, series_slug: notification.chapter.series.to_param, chapter_identifier: notification.chapter.public_id), class: "inline-flex items-center gap-1 rounded-md border border-border px-2 py-1 text-xs text-muted hover:text-foreground hover:border-border-soft" do %>
                <%= icon "book-open", class: "h-3 w-3" %>
                Read
              <% end %>
            <% end %>
            <% unless notification.read? %>
              <%= button_to mark_read_notification_path(notification), method: :post, class: "inline-flex items-center rounded-md border border-border p-1 text-muted hover:text-foreground hover:border-border-soft", data: { turbo_submits_with: "..." } do %>
                <%= icon "check", class: "h-4 w-4" %>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= render UI::EmptyStateComponent.new(
      title: "No notifications yet",
      description: "Follow some series to get notified when new chapters are available."
    ) do |empty| %>
      <% empty.with_icon do %>
        <%= icon "bell", class: "h-6 w-6" %>
      <% end %>
    <% end %>
  <% end %>
</div>
