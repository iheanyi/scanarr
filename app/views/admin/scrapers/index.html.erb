<main class="space-y-8">
  <header class="space-y-2">
    <p class="text-sm text-muted">Admin</p>
    <h1 class="text-3xl font-semibold text-balance">Scraper Support</h1>
    <p class="text-muted text-pretty">Run smoke tests and review recent scraper runs.</p>
  </header>

  <section class="space-y-3">
    <h2 class="text-xl font-semibold text-balance">Sources</h2>
    <div class="overflow-hidden rounded-lg border border-border bg-surface">
      <table class="w-full text-sm">
        <thead class="bg-surface-2 text-left text-muted">
          <tr>
            <th class="px-4 py-3">Source</th>
            <th class="px-4 py-3">Key</th>
            <th class="px-4 py-3">Base URL</th>
            <th class="px-4 py-3">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border text-foreground">
          <% @sources.each do |source| %>
            <tr>
              <td class="px-4 py-3 font-semibold"><%= source.name || source.key %></td>
              <td class="px-4 py-3 text-muted"><%= source.key %></td>
              <td class="px-4 py-3 text-muted"><%= source.base_url %></td>
              <td class="px-4 py-3">
                <%= button_to "Run smoke test",
                              admin_scraper_smoke_path(source_id: source.id),
                              method: :post,
                              class: "inline-flex items-center rounded-md border border-accent/40 px-3 py-1.5 text-xs font-semibold text-accent" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold text-balance">Recent Runs</h2>
    <div class="rounded-lg border border-border bg-surface p-4">
      <%= form_with url: admin_scrapers_path, method: :get, local: true do |form| %>
        <div class="grid gap-3 md:grid-cols-3">
          <%= render UI::SelectComponent.new(
            form: form,
            method: :source_id,
            options: @sources.map { |source| [source.name || source.key, source.id] },
            selected: params[:source_id],
            include_blank: "All sources",
            label: "Source"
          ) %>
          <%= render UI::SelectComponent.new(
            form: form,
            method: :status,
            options: @statuses,
            selected: params[:status],
            include_blank: "Any status",
            label: "Status"
          ) %>
          <%= render UI::SelectComponent.new(
            form: form,
            method: :run_type,
            options: @run_types,
            selected: params[:run_type],
            include_blank: "Any type",
            label: "Run type"
          ) %>
        </div>
        <div class="mt-3">
          <%= form.submit "Apply filters",
                          class: "inline-flex items-center rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-foreground" %>
        </div>
      <% end %>
    </div>

    <div class="overflow-hidden rounded-lg border border-border bg-surface">
      <table class="w-full text-sm">
        <thead class="bg-surface-2 text-left text-muted">
          <tr>
            <th class="px-4 py-3">Started</th>
            <th class="px-4 py-3">Source</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3">Stats</th>
            <th class="px-4 py-3">Error</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border text-foreground">
          <% @runs.each do |run| %>
            <tr>
              <td class="px-4 py-3 text-muted tabular-nums"><%= run.started_at %></td>
              <td class="px-4 py-3"><%= run.source.key %></td>
              <td class="px-4 py-3 text-muted"><%= run.status %></td>
              <td class="px-4 py-3 text-muted"><%= run.stats_json&.to_json %></td>
              <td class="px-4 py-3 text-muted"><%= run.error %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</main>
