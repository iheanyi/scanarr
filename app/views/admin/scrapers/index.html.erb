<main class="space-y-8">
  <header class="space-y-2">
    <p class="text-sm text-zinc-400">Admin</p>
    <h1 class="text-3xl font-semibold text-balance">Scraper Support</h1>
    <p class="text-zinc-400 text-pretty">Run smoke tests and review recent scraper runs.</p>
  </header>

  <section class="space-y-3">
    <h2 class="text-xl font-semibold text-balance">Sources</h2>
    <div class="overflow-hidden rounded-lg border border-zinc-800/80 bg-zinc-900/40">
      <table class="w-full text-sm">
        <thead class="bg-zinc-900/60 text-left text-zinc-400">
          <tr>
            <th class="px-4 py-3">Source</th>
            <th class="px-4 py-3">Key</th>
            <th class="px-4 py-3">Base URL</th>
            <th class="px-4 py-3">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-800/80 text-zinc-200">
          <% @sources.each do |source| %>
            <tr>
              <td class="px-4 py-3 font-semibold"><%= source.name || source.key %></td>
              <td class="px-4 py-3 text-zinc-400"><%= source.key %></td>
              <td class="px-4 py-3 text-zinc-400"><%= source.base_url %></td>
              <td class="px-4 py-3">
                <%= button_to "Run smoke test",
                              admin_scraper_smoke_path(source_id: source.id),
                              method: :post,
                              class: "inline-flex items-center rounded-md border border-emerald-500/40 px-3 py-1.5 text-xs font-semibold text-emerald-300" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold text-balance">Recent Runs</h2>
    <div class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
      <%= form_with url: admin_scrapers_path, method: :get, local: true do |form| %>
        <div class="grid gap-3 md:grid-cols-3">
          <div class="space-y-1">
            <%= form.label :source_id, "Source", class: "text-xs uppercase text-zinc-500" %>
            <%= form.select :source_id,
                            options_for_select(
                              @sources.map { |source| [source.name || source.key, source.id] },
                              params[:source_id]
                            ),
                            { include_blank: "All sources" },
                            class: "w-full rounded-md border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100" %>
          </div>
          <div class="space-y-1">
            <%= form.label :status, "Status", class: "text-xs uppercase text-zinc-500" %>
            <%= form.select :status,
                            options_for_select(@statuses, params[:status]),
                            { include_blank: "Any status" },
                            class: "w-full rounded-md border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100" %>
          </div>
          <div class="space-y-1">
            <%= form.label :run_type, "Run type", class: "text-xs uppercase text-zinc-500" %>
            <%= form.select :run_type,
                            options_for_select(@run_types, params[:run_type]),
                            { include_blank: "Any type" },
                            class: "w-full rounded-md border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100" %>
          </div>
        </div>
        <div class="mt-3">
          <%= form.submit "Apply filters",
                          class: "inline-flex items-center rounded-md bg-emerald-500 px-4 py-2 text-sm font-semibold text-zinc-950" %>
        </div>
      <% end %>
    </div>

    <div class="overflow-hidden rounded-lg border border-zinc-800/80 bg-zinc-900/40">
      <table class="w-full text-sm">
        <thead class="bg-zinc-900/60 text-left text-zinc-400">
          <tr>
            <th class="px-4 py-3">Started</th>
            <th class="px-4 py-3">Source</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3">Stats</th>
            <th class="px-4 py-3">Error</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-800/80 text-zinc-200">
          <% @runs.each do |run| %>
            <tr>
              <td class="px-4 py-3 text-zinc-400 tabular-nums"><%= run.started_at %></td>
              <td class="px-4 py-3"><%= run.source.key %></td>
              <td class="px-4 py-3 text-zinc-400"><%= run.status %></td>
              <td class="px-4 py-3 text-zinc-400"><%= run.stats_json&.to_json %></td>
              <td class="px-4 py-3 text-zinc-400"><%= run.error %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</main>
