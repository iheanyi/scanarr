<div class="space-y-8">
  <%= render UI::PageHeaderComponent.new(
    title: "Scraper Support",
    description: "Run smoke tests and review recent scraper runs.",
    breadcrumb_text: "Admin"
  ) %>

  <section class="space-y-3">
    <h2 class="text-xl font-semibold text-balance">Sources</h2>
    <div class="overflow-x-auto rounded-lg border border-border bg-surface">
      <table class="w-full text-sm">
        <thead class="bg-surface-2 text-left text-muted">
          <tr>
            <th class="px-4 py-3">Source</th>
            <th class="px-4 py-3">Key</th>
            <th class="px-4 py-3">Base URL</th>
            <th class="px-4 py-3">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border text-foreground">
          <% @sources.each do |source| %>
            <tr>
              <td class="px-4 py-3 font-semibold"><%= source.name || source.key %></td>
              <td class="px-4 py-3 text-muted"><%= source.key %></td>
              <td class="px-4 py-3 text-muted">
                <%= source.effective_base_url %>
                <% if source.adopted_base_url.present? %>
                  <span class="ml-1 text-xs text-warning">(adopted)</span>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <%= button_to "Run smoke test",
                              admin_scraper_smoke_path(source_id: source.id),
                              method: :post,
                              class: "inline-flex items-center rounded-md border border-accent/40 px-3 py-1.5 text-xs font-semibold text-accent",
                              data: { turbo_submits_with: "Running..." } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold text-balance">Recent Runs</h2>
    <div class="rounded-lg border border-border bg-surface p-4">
      <%= form_with url: admin_scrapers_path, method: :get, local: true do |form| %>
        <div class="grid gap-3 md:grid-cols-3">
          <%= render UI::SelectComponent.new(
            form: form,
            method: :source_id,
            options: @sources.map { |source| [ source.name || source.key, source.id ] },
            selected: params[:source_id],
            include_blank: "All sources",
            label: "Source"
          ) %>
          <%= render UI::SelectComponent.new(
            form: form,
            method: :status,
            options: @statuses,
            selected: params[:status],
            include_blank: "Any status",
            label: "Status"
          ) %>
          <%= render UI::SelectComponent.new(
            form: form,
            method: :run_type,
            options: @run_types,
            selected: params[:run_type],
            include_blank: "Any type",
            label: "Run type"
          ) %>
        </div>
        <div class="mt-3">
          <%= render UI::ButtonComponent.new(variant: :primary, type: "submit") do %>
            Apply filters
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @runs.empty? %>
      <%= render UI::EmptyStateComponent.new(
        title: "No runs yet",
        description: "Run a smoke test above to see results here.",
        compact: true
      ) do |empty| %>
        <% empty.with_icon do %>
          <%= icon "activity", class: "h-6 w-6" %>
        <% end %>
      <% end %>
    <% else %>
      <div class="overflow-x-auto rounded-lg border border-border bg-surface">
        <table class="w-full text-sm">
          <thead class="bg-surface-2 text-left text-muted">
            <tr>
              <th class="px-4 py-3">Started</th>
              <th class="px-4 py-3">Source</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Stats</th>
              <th class="px-4 py-3">Error</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border text-foreground">
            <% @runs.each do |run| %>
              <tr>
                <td class="px-4 py-3 text-muted tabular-nums"><%= run.started_at&.strftime("%Y-%m-%d %H:%M") %></td>
                <td class="px-4 py-3"><%= run.source.name || run.source.key %></td>
                <td class="px-4 py-3">
                  <%= render UI::StatusBadgeComponent.new(status: run.status) %>
                </td>
                <td class="px-4 py-3 text-muted">
                  <% if run.stats_json.present? %>
                    <div class="space-x-2 text-xs">
                      <% run.stats_json.each do |key, value| %>
                        <span><%= key %>: <strong class="text-foreground"><%= value %></strong></span>
                      <% end %>
                    </div>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-muted"><%= run.error %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</div>
