<div class="space-y-8">
  <%= render UI::PageHeaderComponent.new(
    title: "Source Catalog",
    description: "Every source known to the Mihon/Tachiyomi community index, with the ones Scanarr implements marked.",
    breadcrumb_text: "Admin"
  ) %>

  <section class="space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="text-sm text-muted">
        <% if @total_count.zero? %>
          Catalog is empty. Refresh to mirror the community index.
        <% else %>
          <%= @total_count %> sources in the community index,
          <span class="text-success"><%= @implemented_count %> implemented in Scanarr</span>.
          <% if @last_refreshed_at %>
            Last refreshed <%= time_ago_in_words(@last_refreshed_at) %> ago.
          <% end %>
        <% end %>
      </div>
      <%= button_to "Refresh catalog",
                    admin_source_catalog_refresh_path,
                    method: :post,
                    class: "inline-flex items-center rounded-md border border-accent/40 px-3 py-1.5 text-xs font-semibold text-accent",
                    data: { turbo_submits_with: "Refreshing..." } %>
    </div>

    <%= form_with url: admin_source_catalog_path, method: :get, class: "flex flex-wrap items-center gap-2" do |f| %>
      <%= f.text_field :q, value: params[:q], placeholder: "Filter by name...",
            class: "rounded-md border border-border bg-surface-2 px-3 py-1.5 text-sm text-foreground placeholder:text-muted-2" %>
      <label class="flex items-center gap-1.5 text-sm text-muted">
        <%= f.check_box :lang, { checked: params[:lang] == "all" }, "all", "" %>
        All languages
      </label>
      <%= f.submit "Filter", class: "inline-flex items-center rounded-md border border-border px-3 py-1.5 text-xs font-semibold text-foreground" %>
    <% end %>

    <div class="overflow-x-auto rounded-lg border border-border bg-surface">
      <table class="w-full text-sm">
        <thead class="bg-surface-2 text-left text-muted">
          <tr>
            <th class="px-4 py-3">Source</th>
            <th class="px-4 py-3">Language</th>
            <th class="px-4 py-3">Base URL</th>
            <th class="px-4 py-3">Upstream version</th>
            <th class="px-4 py-3">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border text-foreground">
          <% @upstream_sources.each do |upstream| %>
            <tr>
              <td class="px-4 py-3 font-semibold">
                <span class="inline-flex items-center gap-2">
                  <%= upstream.name %>
                  <% if upstream.nsfw %>
                    <%= render UI::BadgeComponent.new(label: "18+", variant: :warning) %>
                  <% end %>
                </span>
              </td>
              <td class="px-4 py-3 text-muted"><%= upstream.lang %></td>
              <td class="px-4 py-3 text-muted"><%= upstream.base_url %></td>
              <td class="px-4 py-3 text-muted"><%= upstream.extension_version_code %></td>
              <td class="px-4 py-3">
                <% if @implemented_ids.include?(upstream.mihon_id) %>
                  <%= render UI::BadgeComponent.new(label: "Implemented", variant: :success) %>
                <% else %>
                  <%= render UI::BadgeComponent.new(label: "No adapter", variant: :default) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render UI::PaginationComponent.new(
      collection: @upstream_sources,
      base_path: admin_source_catalog_path,
      params: params.permit(:q, :lang)
    ) %>
  </section>
</div>
