<main class="space-y-8">
  <header class="space-y-2">
    <p class="text-sm text-zinc-400">Admin</p>
    <h1 class="text-3xl font-semibold text-balance">Download Queue</h1>
    <p class="text-zinc-400 text-pretty">Monitor download progress and view recent downloads.</p>
  </header>

  <section class="grid gap-4 md:grid-cols-4">
    <div class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
      <p class="text-xs uppercase text-zinc-500">Queued</p>
      <p class="text-2xl font-semibold text-amber-400"><%= @stats["queued"] || 0 %></p>
    </div>
    <div class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
      <p class="text-xs uppercase text-zinc-500">Downloading</p>
      <p class="text-2xl font-semibold text-blue-400"><%= @stats["downloading"] || 0 %></p>
    </div>
    <div class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
      <p class="text-xs uppercase text-zinc-500">Complete</p>
      <p class="text-2xl font-semibold text-emerald-400"><%= @stats["complete"] || 0 %></p>
    </div>
    <div class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
      <p class="text-xs uppercase text-zinc-500">Failed</p>
      <p class="text-2xl font-semibold text-red-400"><%= @stats["failed"] || 0 %></p>
    </div>
  </section>

  <section class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-sm font-semibold">Cover Images</h3>
        <p class="text-xs text-zinc-500 mt-1">
          <%= @covers_attached %>/<%= @series_count %> stored locally
          <% if @covers_with_url > @covers_attached %>
            · <%= @covers_with_url - @covers_attached %> can be downloaded
          <% end %>
        </p>
      </div>
      <% if @covers_with_url > 0 %>
        <%= button_to "Refresh All Covers",
                      admin_refresh_all_covers_path,
                      method: :post,
                      class: "inline-flex items-center gap-1.5 rounded-md border border-emerald-500/40 px-3 py-1.5 text-sm font-semibold text-emerald-300 hover:bg-emerald-500/10",
                      data: { turbo_confirm: "Refresh all #{@covers_with_url} covers from source? This may take a while." } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Refresh All
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold text-balance">Downloads</h2>
    <div class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
      <%= form_with url: admin_downloads_path, method: :get, local: true do |form| %>
        <div class="flex items-end gap-3">
          <div class="space-y-1">
            <%= form.label :status, "Status", class: "text-xs uppercase text-zinc-500" %>
            <%= form.select :status,
                            options_for_select(@statuses, params[:status]),
                            { include_blank: "Any status" },
                            class: "w-full rounded-md border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100" %>
          </div>
          <div>
            <%= form.submit "Filter",
                            class: "inline-flex items-center rounded-md bg-emerald-500 px-4 py-2 text-sm font-semibold text-zinc-950" %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @downloads.empty? %>
      <div class="rounded-lg border border-dashed border-zinc-800/80 bg-zinc-900/40 p-6 text-center">
        <p class="text-zinc-400">No downloads yet.</p>
      </div>
    <% else %>
      <div class="overflow-hidden rounded-lg border border-zinc-800/80 bg-zinc-900/40">
        <table class="w-full text-sm">
          <thead class="bg-zinc-900/60 text-left text-zinc-400">
            <tr>
              <th class="px-4 py-3">Series / Chapter</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3 w-48">Progress</th>
              <th class="px-4 py-3">Updated</th>
              <th class="px-4 py-3">Error</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-800/80 text-zinc-200">
            <% @downloads.each do |download| %>
              <% chapter = download.release&.chapter %>
              <% series = chapter&.series %>
              <% progress_pct = download.pages_expected.to_i > 0 ? (download.pages_downloaded.to_f / download.pages_expected * 100).round : 0 %>
              <tr>
                <td class="px-4 py-3">
                  <% if series && chapter %>
                    <span class="font-semibold"><%= series.canonical_title %></span>
                    <span class="text-zinc-400">Ch. <%= chapter.chapter_number %></span>
                  <% else %>
                    <span class="text-zinc-500">Unknown</span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <% case download.download_status %>
                  <% when "queued" %>
                    <span class="inline-flex items-center rounded-full bg-amber-500/20 px-2 py-0.5 text-xs font-medium text-amber-300">Queued</span>
                  <% when "downloading" %>
                    <span class="inline-flex items-center rounded-full bg-blue-500/20 px-2 py-0.5 text-xs font-medium text-blue-300">Downloading</span>
                  <% when "complete" %>
                    <span class="inline-flex items-center rounded-full bg-emerald-500/20 px-2 py-0.5 text-xs font-medium text-emerald-300">Complete</span>
                  <% when "failed" %>
                    <span class="inline-flex items-center rounded-full bg-red-500/20 px-2 py-0.5 text-xs font-medium text-red-300">Failed</span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <% if download.pages_expected.to_i > 0 %>
                    <div class="flex items-center gap-2">
                      <div class="h-2 flex-1 rounded-full bg-zinc-800">
                        <div class="h-2 rounded-full bg-emerald-500 transition-all" style="width: <%= progress_pct %>%"></div>
                      </div>
                      <span class="text-xs text-zinc-400 tabular-nums"><%= download.pages_downloaded %>/<%= download.pages_expected %></span>
                    </div>
                  <% else %>
                    <span class="text-zinc-500">—</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-zinc-400 tabular-nums"><%= download.updated_at.strftime("%Y-%m-%d %H:%M") %></td>
                <td class="px-4 py-3 text-zinc-400 max-w-xs truncate" title="<%= download.download_error %>">
                  <%= download.download_error.present? ? truncate(download.download_error, length: 50) : "—" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</main>
