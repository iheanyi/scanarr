<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
  <meta name="turbo-cache-control" content="no-preview">
<% end %>

<div class="space-y-8">
  <%= turbo_stream_from "admin_downloads" %>

  <%= render UI::PageHeaderComponent.new(
    title: "Download Queue",
    description: "Monitor download progress and view recent downloads.",
    breadcrumb_text: "Admin"
  ) %>

  <section id="download_stats" class="grid gap-4 md:grid-cols-4">
    <%= render UI::StatCardComponent.new(label: "Queued", value: @stats["queued"] || 0, color: :warning) %>
    <%= render UI::StatCardComponent.new(label: "Downloading", value: @stats["downloading"] || 0, color: :info) %>
    <%= render UI::StatCardComponent.new(label: "Complete", value: @stats["complete"] || 0, color: :accent) %>
    <%= render UI::StatCardComponent.new(label: "Failed", value: @stats["failed"] || 0, color: :danger) %>
  </section>

  <section class="grid gap-4 md:grid-cols-2">
    <div class="rounded-lg border border-border bg-surface p-4">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-sm font-semibold">Cover Images</h3>
          <p class="text-xs text-muted-2 mt-1">
            <%= @covers_attached %>/<%= @series_count %> stored locally
            <% if @covers_missing > 0 %>
              · <%= @covers_missing %> missing
            <% end %>
          </p>
        </div>
        <% if @series_count > 0 %>
          <%= button_to admin_refresh_all_covers_path,
                        method: :post,
                        class: "inline-flex items-center gap-1.5 whitespace-nowrap rounded-md border border-accent/40 px-3 py-1.5 text-sm font-semibold text-accent hover:bg-accent-ghost",
                        data: { turbo_confirm: "Refresh all #{@series_count} covers from source? This fetches fresh cover URLs and downloads them." } do %>
            <%= icon "refresh-cw", class: "h-4 w-4" %>
            Refresh All
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="rounded-lg border border-border bg-surface p-4">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-sm font-semibold">Series Metadata</h3>
          <p class="text-xs text-muted-2 mt-1">
            Re-import titles, descriptions, tags, covers, and chapters for all series
          </p>
        </div>
        <% if @series_count > 0 %>
          <%= button_to admin_refresh_all_metadata_path,
                        method: :post,
                        class: "inline-flex items-center gap-1.5 whitespace-nowrap rounded-md border border-accent/40 px-3 py-1.5 text-sm font-semibold text-accent hover:bg-accent-ghost",
                        data: { turbo_confirm: "Refresh all metadata for #{@series_count} series? This re-imports titles, descriptions, tags, covers, and chapters from each source." } do %>
            <%= icon "refresh-cw", class: "h-4 w-4" %>
            Refresh All
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold text-balance">Downloads</h2>
    <div class="rounded-lg border border-border bg-surface p-4">
      <%= form_with url: admin_downloads_path, method: :get, local: true do |form| %>
        <div class="flex flex-wrap items-end gap-3">
          <%= render UI::SelectComponent.new(
            form: form,
            method: :status,
            options: @statuses + [ "cancelled" ],
            selected: params[:status],
            include_blank: "Any status",
            label: "Status"
          ) %>
          <div>
            <%= render UI::ButtonComponent.new(variant: :primary, type: "submit") do %>
              Filter
            <% end %>
          </div>
          <% if params[:status].present? %>
            <%= link_to "Clear filter", admin_downloads_path, class: "text-sm text-muted hover:text-foreground" %>
          <% end %>
        </div>
      <% end %>
      <% if @cancelled_count > 0 && params[:status] != "cancelled" %>
        <p class="mt-3 text-xs text-muted-2">
          <%= @cancelled_count %> cancelled download<%= @cancelled_count == 1 ? "" : "s" %> hidden.
          <%= link_to "View cancelled", admin_downloads_path(status: "cancelled"), class: "text-muted hover:text-foreground underline" %>
        </p>
      <% end %>
    </div>

    <% if @downloads.empty? || @downloads.total_count == 0 %>
      <%= render UI::EmptyStateComponent.new(
        title: "No downloads yet",
        description: "Downloads will appear here when you start downloading chapters.",
        compact: true
      ) do |empty| %>
        <% empty.with_icon do %>
          <%= icon "download", class: "h-6 w-6" %>
        <% end %>
      <% end %>
    <% else %>
      <div class="flex items-center justify-between mb-3">
        <p class="text-sm text-muted">
          Showing <%= @downloads.offset_value + 1 %>-<%= [ @downloads.offset_value + @downloads.length, @downloads.total_count ].min %> of <%= @downloads.total_count %> downloads
        </p>
        <div class="flex items-center gap-2">
          <% if @stuck_count > 0 %>
            <%= button_to admin_restart_all_stuck_downloads_path,
                          method: :post,
                          class: "inline-flex items-center gap-1.5 rounded-md border border-info/40 px-3 py-1.5 text-sm font-medium text-info hover:bg-info-soft",
                          data: { turbo_confirm: "Restart all #{@stuck_count} stuck downloads?" } do %>
              <%= icon "refresh-cw", class: "h-4 w-4" %>
              Restart Stuck (<%= @stuck_count %>)
            <% end %>
          <% end %>
          <% if (@stats["failed"] || 0) > 0 %>
            <%= button_to admin_restart_all_failed_downloads_path,
                          method: :post,
                          class: "inline-flex items-center gap-1.5 rounded-md border border-danger/40 px-3 py-1.5 text-sm font-medium text-danger hover:bg-danger-soft",
                          data: { turbo_confirm: "Restart all #{@stats['failed']} failed downloads?" } do %>
              <%= icon "refresh-cw", class: "h-4 w-4" %>
              Restart Failed (<%= @stats["failed"] %>)
            <% end %>
          <% end %>
        </div>
      </div>
      <div class="overflow-x-auto rounded-lg border border-border bg-surface">
        <table class="w-full text-sm">
          <thead class="bg-surface-2 text-left text-muted">
            <tr>
              <th class="px-4 py-3">Series / Chapter</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3 w-48">Progress</th>
              <th class="px-4 py-3">Updated</th>
              <th class="px-4 py-3">Error</th>
              <th class="px-4 py-3 w-24">Actions</th>
            </tr>
          </thead>
          <tbody id="downloads_list" class="divide-y divide-border text-foreground">
            <% @downloads.each do |download| %>
              <%= render "admin/downloads/download_row", download: download %>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= render UI::PaginationComponent.new(
        collection: @downloads,
        base_path: admin_downloads_path,
        params: { status: params[:status] }
      ) %>
    <% end %>
  </section>
</div>
