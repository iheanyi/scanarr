<main class="space-y-8">
  <%= turbo_stream_from "admin_downloads" %>

  <header class="space-y-2">
    <p class="text-sm text-zinc-400">Admin</p>
    <h1 class="text-3xl font-semibold text-balance">Download Queue</h1>
    <p class="text-zinc-400 text-pretty">Monitor download progress and view recent downloads.</p>
  </header>

  <section id="download_stats" class="grid gap-4 md:grid-cols-4">
    <div class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
      <p class="text-xs uppercase text-zinc-500">Queued</p>
      <p class="text-2xl font-semibold text-amber-400"><%= @stats["queued"] || 0 %></p>
    </div>
    <div class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
      <p class="text-xs uppercase text-zinc-500">Downloading</p>
      <p class="text-2xl font-semibold text-blue-400"><%= @stats["downloading"] || 0 %></p>
    </div>
    <div class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
      <p class="text-xs uppercase text-zinc-500">Complete</p>
      <p class="text-2xl font-semibold text-emerald-400"><%= @stats["complete"] || 0 %></p>
    </div>
    <div class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
      <p class="text-xs uppercase text-zinc-500">Failed</p>
      <p class="text-2xl font-semibold text-red-400"><%= @stats["failed"] || 0 %></p>
    </div>
  </section>

  <section class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-sm font-semibold">Cover Images</h3>
        <p class="text-xs text-zinc-500 mt-1">
          <%= @covers_attached %>/<%= @series_count %> stored locally
          <% if @covers_missing > 0 %>
            · <%= @covers_missing %> missing
          <% end %>
        </p>
      </div>
      <% if @series_count > 0 %>
        <%= button_to admin_refresh_all_covers_path,
                      method: :post,
                      class: "inline-flex items-center gap-1.5 rounded-md border border-emerald-500/40 px-3 py-1.5 text-sm font-semibold text-emerald-300 hover:bg-emerald-500/10",
                      data: { turbo_confirm: "Refresh all #{@series_count} covers from source? This fetches fresh cover URLs and downloads them." } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Refresh All
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold text-balance">Downloads</h2>
    <div class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
      <%= form_with url: admin_downloads_path, method: :get, local: true do |form| %>
        <div class="flex flex-wrap items-end gap-3">
          <div class="space-y-1">
            <%= form.label :status, "Status", class: "text-xs uppercase text-zinc-500" %>
            <%= form.select :status,
                            options_for_select(@statuses + ["cancelled"], params[:status]),
                            { include_blank: "Any status" },
                            class: "w-full rounded-md border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-100" %>
          </div>
          <div>
            <%= form.submit "Filter",
                            class: "inline-flex items-center rounded-md bg-emerald-500 px-4 py-2 text-sm font-semibold text-zinc-950" %>
          </div>
          <% if params[:status].present? %>
            <%= link_to "Clear filter", admin_downloads_path, class: "text-sm text-zinc-400 hover:text-zinc-200" %>
          <% end %>
        </div>
      <% end %>
      <% if @cancelled_count > 0 && params[:status] != "cancelled" %>
        <p class="mt-3 text-xs text-zinc-500">
          <%= @cancelled_count %> cancelled download<%= @cancelled_count == 1 ? '' : 's' %> hidden.
          <%= link_to "View cancelled", admin_downloads_path(status: "cancelled"), class: "text-zinc-400 hover:text-zinc-200 underline" %>
        </p>
      <% end %>
    </div>

    <% if @downloads.empty? || @downloads.total_count == 0 %>
      <div class="rounded-lg border border-dashed border-zinc-800/80 bg-zinc-900/40 p-6 text-center">
        <p class="text-zinc-400">No downloads yet.</p>
      </div>
    <% else %>
      <div class="flex items-center justify-between mb-3">
        <p class="text-sm text-zinc-400">
          Showing <%= @downloads.offset_value + 1 %>-<%= [@downloads.offset_value + @downloads.length, @downloads.total_count].min %> of <%= @downloads.total_count %> downloads
        </p>
      </div>
      <div class="overflow-hidden rounded-lg border border-zinc-800/80 bg-zinc-900/40">
        <table class="w-full text-sm">
          <thead class="bg-zinc-900/60 text-left text-zinc-400">
            <tr>
              <th class="px-4 py-3">Series / Chapter</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3 w-48">Progress</th>
              <th class="px-4 py-3">Updated</th>
              <th class="px-4 py-3">Error</th>
            </tr>
          </thead>
          <tbody id="downloads_list" class="divide-y divide-zinc-800/80 text-zinc-200">
            <% @downloads.each do |download| %>
              <%= render "admin/downloads/download_row", download: download %>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @downloads.total_pages > 1 %>
        <nav class="mt-4 flex items-center justify-center gap-1">
          <% if @downloads.first_page? %>
            <span class="px-3 py-2 text-sm text-zinc-600 cursor-not-allowed">Previous</span>
          <% else %>
            <%= link_to "Previous", url_for(page: @downloads.prev_page, status: params[:status]), class: "px-3 py-2 text-sm text-zinc-300 hover:text-white rounded-md hover:bg-zinc-800" %>
          <% end %>

          <%# Show up to 7 page numbers centered around current page %>
          <% window = 3 %>
          <% start_page = [@downloads.current_page - window, 1].max %>
          <% end_page = [@downloads.current_page + window, @downloads.total_pages].min %>
          <% (start_page..end_page).each do |page_num| %>
            <% if page_num == @downloads.current_page %>
              <span class="px-3 py-2 text-sm font-semibold text-emerald-400 bg-emerald-500/10 rounded-md"><%= page_num %></span>
            <% else %>
              <%= link_to page_num, url_for(page: page_num, status: params[:status]), class: "px-3 py-2 text-sm text-zinc-400 hover:text-white rounded-md hover:bg-zinc-800" %>
            <% end %>
          <% end %>

          <% if @downloads.last_page? %>
            <span class="px-3 py-2 text-sm text-zinc-600 cursor-not-allowed">Next</span>
          <% else %>
            <%= link_to "Next", url_for(page: @downloads.next_page, status: params[:status]), class: "px-3 py-2 text-sm text-zinc-300 hover:text-white rounded-md hover:bg-zinc-800" %>
          <% end %>
        </nav>
      <% end %>
    <% end %>
  </section>
</main>
