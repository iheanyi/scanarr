<% chapter = download.release&.chapter %>
<% series = chapter&.series %>
<% progress_pct = download.pages_expected.to_i > 0 ? (download.pages_downloaded.to_f / download.pages_expected * 100).round : 0 %>
<% can_restart = download.download_status.in?(%w[failed downloading cancelled]) %>
<% is_stuck = download.download_status == "downloading" && download.updated_at < 10.minutes.ago %>
<tr id="<%= dom_id(download) %>">
  <td class="px-4 py-3">
    <% if series && chapter %>
      <span class="font-semibold"><%= series.canonical_title %></span>
      <span class="text-muted">Ch. <%= chapter.chapter_number %></span>
    <% else %>
      <span class="text-muted-2">Unknown</span>
    <% end %>
  </td>
  <td class="px-4 py-3">
    <% status_label = download.download_status.in?(%w[queued pending]) ? "Queued" : nil %>
    <%= render UI::StatusBadgeComponent.new(status: download.download_status, label: status_label) %>
    <% if download.download_status == "downloading" && is_stuck %>
      <span class="ml-1 text-warning" title="No progress for 10+ minutes">⚠</span>
    <% end %>
  </td>
  <td class="px-4 py-3">
    <% if download.pages_expected.to_i > 0 %>
      <div class="flex items-center gap-2">
        <div class="h-2 flex-1 rounded-full bg-surface-2">
          <div class="h-2 rounded-full <%= download.download_status == "complete" ? "bg-accent" : "bg-info" %> transition-all" style="width: <%= progress_pct %>%"></div>
        </div>
        <span class="text-xs text-muted tabular-nums"><%= download.pages_downloaded %>/<%= download.pages_expected %></span>
      </div>
    <% else %>
      <span class="text-muted-2">—</span>
    <% end %>
  </td>
  <td class="px-4 py-3 text-muted tabular-nums"><%= download.updated_at.strftime("%Y-%m-%d %H:%M") %></td>
  <td class="px-4 py-3 text-muted max-w-xs truncate" title="<%= download.download_error %>">
    <%= download.download_error.present? ? truncate(download.download_error, length: 50) : "—" %>
  </td>
  <td class="px-4 py-3">
    <div class="flex items-center gap-1">
      <% if can_restart %>
        <%= button_to admin_download_restart_path(download, status: params[:status]),
                      method: :post,
                      class: "inline-flex items-center gap-1 rounded px-2 py-1 text-xs font-medium text-warning hover:bg-warning-soft",
                      title: is_stuck ? "Restart stuck download" : "Restart download" do %>
          <%= icon "refresh-cw", class: "h-3.5 w-3.5" %>
          Restart
        <% end %>
      <% end %>
      <% if download.download_status.in?(%w[queued pending downloading]) %>
        <%= button_to admin_download_cancel_path(download, status: params[:status]),
                      method: :post,
                      class: "inline-flex items-center gap-1 rounded px-2 py-1 text-xs font-medium text-danger hover:bg-danger-soft",
                      data: { turbo_confirm: "Cancel this download?" } do %>
          <%= icon "x", class: "h-3.5 w-3.5" %>
          Cancel
        <% end %>
      <% end %>
      <% unless can_restart || download.download_status.in?(%w[queued pending downloading]) %>
        <span class="text-muted-2">—</span>
      <% end %>
    </div>
  </td>
</tr>
