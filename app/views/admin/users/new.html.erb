<div class="space-y-6 max-w-xl">
  <%= render UI::PageHeaderComponent.new(
    title: "Add User",
    description: "Create a new user account."
  ) %>

  <div class="rounded-lg border border-border bg-surface p-6">
    <% if @user.errors.any? %>
      <div class="mb-6 rounded-lg border border-danger/30 bg-danger-soft p-4">
        <ul class="space-y-1 text-sm text-danger">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: admin_users_path, class: "space-y-4" do |f| %>
      <%= render UI::InputComponent.new(
        form: f,
        method: :username,
        label: "Username",
        required: true,
        class: "mt-1"
      ) %>

      <%= render UI::InputComponent.new(
        form: f,
        method: :email,
        type: "email",
        label: "Email",
        required: true,
        class: "mt-1"
      ) %>

      <%= render UI::InputComponent.new(
        form: f,
        method: :password,
        type: "password",
        label: "Password",
        required: true,
        autocomplete: "new-password",
        hint: "Minimum 8 characters",
        minlength: 8,
        class: "mt-1"
      ) %>

      <%= render UI::InputComponent.new(
        form: f,
        method: :password_confirmation,
        type: "password",
        label: "Confirm Password",
        required: true,
        autocomplete: "new-password",
        class: "mt-1"
      ) %>

      <%= render UI::SelectComponent.new(
        form: f,
        method: :role,
        options: [ [ "Member", "member" ], [ "Admin", "admin" ] ],
        selected: @user.role,
        label: "Role",
        class: "mt-1"
      ) %>

      <div class="flex gap-3 pt-2">
        <%= render UI::ButtonComponent.new(label: "Create User", variant: :primary, type: "submit") %>
        <%= render UI::ButtonComponent.new(label: "Cancel", variant: :secondary, href: admin_users_path) %>
      </div>
    <% end %>
  </div>
</div>
