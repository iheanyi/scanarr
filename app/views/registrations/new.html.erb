<div class="flex min-h-screen items-center justify-center px-4">
  <div class="w-full max-w-sm space-y-8">
    <div class="text-center">
      <h1 class="text-3xl font-semibold text-foreground">Scanarr</h1>
      <p class="mt-2 text-sm text-muted">Create an account to get started.</p>
    </div>

    <% if @user.errors.any? %>
      <div class="rounded-lg border border-danger/30 bg-danger-soft p-4">
        <ul class="space-y-1 text-sm text-danger">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: register_path, method: :post, class: "space-y-6" do |f| %>
      <div class="space-y-4">
        <%= render UI::InputComponent.new(
          form: f,
          method: :username,
          label: "Username",
          required: true,
          autofocus: true,
          autocomplete: "username",
          class: "mt-1 rounded-lg px-4"
        ) %>

        <%= render UI::InputComponent.new(
          form: f,
          method: :email,
          type: "email",
          label: "Email",
          required: true,
          autocomplete: "email",
          class: "mt-1 rounded-lg px-4"
        ) %>

        <%= render UI::InputComponent.new(
          form: f,
          method: :password,
          type: "password",
          label: "Password",
          required: true,
          autocomplete: "new-password",
          hint: "Minimum 8 characters",
          minlength: 8,
          class: "mt-1 rounded-lg px-4"
        ) %>

        <%= render UI::InputComponent.new(
          form: f,
          method: :password_confirmation,
          type: "password",
          label: "Confirm Password",
          required: true,
          autocomplete: "new-password",
          class: "mt-1 rounded-lg px-4"
        ) %>
      </div>

      <%= render UI::ButtonComponent.new(variant: :primary, type: "submit", size: :lg, class: "w-full") do %>
        Create Account
      <% end %>
    <% end %>

    <p class="text-center text-sm text-muted">
      Already have an account?
      <%= link_to "Sign in", login_path, class: "text-accent hover:text-accent/80" %>
    </p>
  </div>
</div>
