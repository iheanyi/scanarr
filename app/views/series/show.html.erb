<div class="space-y-6">
  <nav aria-label="Breadcrumb" class="text-sm text-muted">
    <%= link_to @source.name || @source.key, source_series_index_path(source_slug: @source.slug), class: "hover:text-foreground", data: { turbo_preload: "" } %>
    <span class="text-muted-2">/</span>
    <span class="text-foreground"><%= @series.canonical_title %></span>
  </nav>

  <header class="flex flex-col gap-4 sm:flex-row sm:gap-6">
    <div class="relative group shrink-0">
      <%= render UI::SeriesCoverComponent.new(
        url: @series.cover_image_url,
        alt: "#{@series.canonical_title} cover",
        size: :xl,
        rounded: :lg,
        loading: "eager",
        class: "h-48 w-36 border-border/80"
      ) do |cover| %>
        <% cover.with_fallback do %>
          <div class="flex h-full w-full flex-col items-center justify-center gap-2 p-2">
            <span class="text-xs uppercase text-muted-2">No cover</span>
            <% if @series.cover_url.present? %>
              <%= button_to source_series_refresh_cover_path(source_slug: @source.slug, series_slug: @series.to_param),
                            method: :post,
                            class: "inline-flex items-center rounded-md bg-surface-2 border border-border px-2 py-1 text-xs font-medium text-foreground hover:text-foreground hover:bg-surface" do %>
                <%= icon "download", class: "h-3 w-3 mr-1" %>
                Fetch
              <% end %>
            <% end %>
          </div>
        <% end %>
        <% cover.with_overlay do %>
          <% if @series.cover_url.present? && @series.cover_image_url.present? %>
            <%= button_to source_series_refresh_cover_path(source_slug: @source.slug, series_slug: @series.to_param),
                          method: :post,
                          class: "absolute bottom-2 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity inline-flex items-center rounded-md bg-surface/90 border border-border px-2 py-1 text-xs font-medium text-foreground hover:text-accent" do %>
              <%= icon "refresh-cw", class: "h-3 w-3 mr-1" %>
              Refresh
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <div class="space-y-2 flex-1">
      <div class="flex items-center gap-2">
        <p class="text-sm text-muted"><%= @source.name || @source.key %></p>
        <% if @series.status.present? %>
          <%= render UI::StatusBadgeComponent.new(status: @series.status) %>
        <% end %>
        <% if @series.series_type.present? %>
          <span class="inline-flex items-center rounded-full bg-surface-2 px-2 py-0.5 text-xs text-muted"><%= @series.series_type.titleize %></span>
        <% end %>
        <%= button_to source_series_refresh_metadata_path(source_slug: @source.slug, series_slug: @series.to_param),
                      method: :post,
                      class: "inline-flex items-center gap-1 rounded-md border border-border px-2 py-0.5 text-xs text-muted hover:text-foreground hover:border-muted" do %>
          <%= icon "refresh-cw", class: "h-3 w-3" %>
          Refresh
        <% end %>
      </div>
      <h1 class="text-3xl font-semibold text-balance"><%= @series.canonical_title %></h1>
      <% if @series.localized_title.present? %>
        <p class="text-lg text-muted"><%= @series.localized_title %></p>
      <% end %>
      <% if @series.display_author.present? %>
        <p class="text-sm text-foreground">by <%= @series.display_author %></p>
      <% end %>
      <% if @series.raw_tags.present? %>
        <div class="flex flex-wrap gap-1.5">
          <% @series.raw_tags.first(12).each do |tag| %>
            <span class="inline-block rounded-full bg-surface-2 border border-border px-2.5 py-0.5 text-xs text-muted"><%= tag %></span>
          <% end %>
          <% if @series.raw_tags.size > 12 %>
            <span class="inline-block rounded-full bg-surface-2 border border-border px-2.5 py-0.5 text-xs text-muted-2">+<%= @series.raw_tags.size - 12 %> more</span>
          <% end %>
        </div>
      <% end %>
      <% if @series.description.present? %>
        <div class="max-w-2xl text-sm text-muted" data-controller="text-expand">
          <div class="text-pretty <%= "line-clamp-3" if @series.description.length > 200 %>" data-text-expand-target="content">
            <%= simple_format(@series.description) %>
          </div>
          <% if @series.description.length > 200 %>
            <button type="button"
                    class="text-xs text-muted-2 hover:text-foreground cursor-pointer mt-1"
                    data-text-expand-target="toggle"
                    data-action="click->text-expand#toggle">
              Show more
            </button>
          <% end %>
        </div>
      <% end %>

      <% if @check_error %>
        <div class="mt-4 flex items-start gap-2 rounded-lg border border-danger/30 bg-danger-soft p-3">
          <%= icon "alert-triangle", class: "h-4 w-4 shrink-0 text-danger mt-0.5" %>
          <div class="text-sm">
            <p class="font-medium text-danger">
              Chapter check failing
              <% if @check_error.check_critically_failing? %>
                (<%= @check_error.consecutive_failures %> consecutive failures)
              <% end %>
            </p>
            <p class="text-muted text-xs mt-0.5"><%= @check_error.last_check_error %></p>
            <% if @check_error.last_check_error_at %>
              <p class="text-muted-2 text-xs mt-0.5">Last failed <%= time_ago_in_words(@check_error.last_check_error_at) %> ago</p>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="flex flex-wrap items-center gap-3 mt-4">
        <% if user_signed_in? %>
          <%= render UI::FollowControlsComponent.new(series: @series, user_follow: @user_follow) %>
        <% end %>

        <span class="hidden sm:block h-5 w-px bg-border"></span>

        <%= form_with model: @series,
                      url: source_series_update_path(source_slug: @source.slug, series_slug: @series.to_param),
                      method: :patch,
                      class: "flex items-center gap-2",
                      data: { turbo_submits_with: "Updating..." } do |form| %>
          <%= icon "book-open", class: "h-3.5 w-3.5 text-muted-2" %>
          <%= render UI::AutoSelectComponent.new(
            form: form,
            method: :reading_style,
            options: [
              [ "Left to Right", "left_to_right" ],
              [ "Right to Left", "right_to_left" ],
              [ "Long Strip", "long_strip" ],
              [ "Webcomic", "webcomic" ]
            ],
            selected: @series.reading_style || "left_to_right",
            full_width: false,
            size: :sm
          ) %>
        <% end %>
      </div>
    </div>
  </header>

  <section class="space-y-3" data-controller="chapter-filter bulk-select">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <h2 class="text-xl font-semibold text-balance">Chapters</h2>
        <% if @chapter_progress_map.present? %>
          <% read_count = @chapter_progress_map.count { |_, p| p.status == "completed" } %>
          <span class="text-sm text-muted"><%= read_count %>/<%= @chapters.size %> read</span>
        <% end %>
      </div>
      <% if @chapters.any? %>
        <div class="flex items-center gap-2">
          <% if @in_progress_count > 0 %>
            <%= button_to source_series_cancel_all_downloads_path(source_slug: @source.slug, series_slug: @series.to_param),
                          method: :post,
                          class: "inline-flex items-center gap-1.5 rounded-md border border-warning/40 px-3 py-1.5 text-sm font-semibold text-warning hover:bg-warning-soft",
                          data: { turbo_confirm: "Cancel all #{@in_progress_count} in-progress download(s)?" } do %>
              <%= icon "x", class: "h-4 w-4" %>
              Cancel All
              <span class="rounded-full bg-warning/20 px-1.5 py-0.5 text-xs"><%= @in_progress_count %></span>
            <% end %>
          <% end %>
          <% if @downloaded_count > 0 %>
            <%= button_to source_series_remove_all_downloads_path(source_slug: @source.slug, series_slug: @series.to_param),
                          method: :delete,
                          class: "inline-flex items-center gap-1.5 rounded-md border border-danger/40 px-3 py-1.5 text-sm font-semibold text-danger hover:bg-danger-soft",
                          data: { turbo_confirm: "Remove all #{@downloaded_count} downloaded chapter(s)? This cannot be undone." } do %>
              <%= icon "trash-2", class: "h-4 w-4" %>
              Remove All
              <span class="rounded-full bg-danger/20 px-1.5 py-0.5 text-xs"><%= @downloaded_count %></span>
            <% end %>
          <% end %>
          <div data-controller="loading-button">
            <%= form_with url: source_series_download_all_path(source_slug: @source.slug, series_slug: @series.to_param),
                          method: :post,
                          data: { action: "submit->loading-button#submit" } do %>
              <button type="submit"
                      data-loading-button-target="button"
                      data-turbo-submits-with="Queuing..."
                      <%= "disabled" if @downloadable_count == 0 %>
                      class="<%= @downloadable_count > 0 ? "inline-flex items-center gap-1.5 rounded-md bg-accent px-3 py-1.5 text-sm font-semibold text-accent-foreground hover:bg-accent-strong transition-opacity" : "inline-flex items-center gap-1.5 rounded-md bg-surface-2 px-3 py-1.5 text-sm font-semibold text-muted cursor-not-allowed" %>">
                <svg data-loading-button-target="spinner" xmlns="http://www.w3.org/2000/svg" class="hidden h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <%= icon "download", class: "h-4 w-4", data: { loading_button_target: "icon" } %>
                <span data-loading-button-target="text">Download All</span>
                <% if @downloadable_count > 0 %>
                  <span class="rounded-full bg-background/20 px-1.5 py-0.5 text-xs"><%= @downloadable_count %></span>
                <% end %>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <%= turbo_stream_from @series, :downloads %>
    <% if @chapters.any? %>
      <div class="flex items-center gap-3">
        <div class="relative flex-1">
          <%= icon "search", class: "pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-2" %>
          <input type="text"
                 placeholder="Filter chapters by number or title…"
                 data-chapter-filter-target="input"
                 data-action="input->chapter-filter#filter"
                 class="w-full rounded-lg border border-border bg-surface-2 py-2 pl-9 pr-3 text-sm text-foreground placeholder:text-muted-2 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent">
        </div>
        <span data-chapter-filter-target="count" class="shrink-0 text-xs text-muted-2">
          <%= @chapters.size %> of <%= @chapters.size %>
        </span>
      </div>
      <ul class="space-y-2">
        <%= render partial: "series/chapter_row", collection: @chapters, as: :chapter, locals: { source: @source, series: @series, chapter_progress_map: @chapter_progress_map } %>
      </ul>

      <%# Bulk action floating bar %>
      <div data-bulk-select-target="actionBar" data-turbo-temporary class="hidden sticky bottom-4 z-10">
        <div class="mx-auto max-w-2xl rounded-lg border border-border bg-surface shadow-lg p-3">
          <%= form_with url: source_series_bulk_actions_path(source_slug: @source.slug, series_slug: @series.to_param), method: :post do |f| %>
            <input type="hidden" name="chapter_ids" value="" data-bulk-select-target="chapterIds">
            <input type="hidden" name="action_name" value="" data-bulk-select-target="actionName">
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox"
                         data-bulk-select-target="selectAll"
                         data-action="change->bulk-select#toggleAll"
                         class="h-4 w-4 rounded border-border text-accent focus:ring-accent cursor-pointer">
                  <span class="text-xs text-muted-2">All</span>
                </label>
                <span data-bulk-select-target="count" class="text-sm font-medium text-foreground">0 selected</span>
              </div>
              <div class="flex items-center gap-2">
                <button type="button"
                        data-action-name="download"
                        data-action="click->bulk-select#submitAction"
                        class="inline-flex items-center gap-1.5 rounded-md bg-accent px-3 py-1.5 text-sm font-semibold text-accent-foreground hover:bg-accent-strong">
                  <%= icon "download", class: "h-4 w-4" %>
                  Download
                </button>
                <button type="button"
                        data-action-name="remove"
                        data-action="click->bulk-select#submitAction"
                        class="inline-flex items-center gap-1.5 rounded-md border border-danger/40 px-3 py-1.5 text-sm font-semibold text-danger hover:bg-danger-soft">
                  <%= icon "trash-2", class: "h-4 w-4" %>
                  Remove
                </button>
                <button type="button"
                        data-action-name="mark_read"
                        data-action="click->bulk-select#submitAction"
                        class="inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-1.5 text-sm font-semibold text-foreground hover:bg-surface-2">
                  <%= icon "check", class: "h-4 w-4" %>
                  Mark Read
                </button>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <%= render UI::EmptyStateComponent.new(
        title: "No chapters imported yet",
        description: "Check back after importing chapters from the source.",
        compact: true
      ) do |empty| %>
        <% empty.with_icon do %>
          <%= icon "book-open", class: "h-6 w-6" %>
        <% end %>
      <% end %>
    <% end %>
  </section>
</div>
