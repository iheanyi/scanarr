<div class="space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:gap-6">
    <div class="relative group">
      <div class="h-48 w-36 shrink-0 overflow-hidden rounded-lg border border-border/80 bg-background">
        <% if @series.cover_image_url.present? %>
          <%= image_tag @series.cover_image_url, alt: "#{@series.canonical_title} cover", class: "h-full w-full object-cover" %>
        <% else %>
          <div class="flex h-full w-full flex-col items-center justify-center gap-2 p-2">
            <span class="text-xs uppercase text-muted-2">No cover</span>
            <% if @series.cover_url.present? %>
              <%= button_to source_series_refresh_cover_path(source_slug: @source.slug, series_slug: @series.to_param),
                            method: :post,
                            class: "inline-flex items-center rounded-md bg-surface-2 border border-border px-2 py-1 text-xs font-medium text-foreground hover:text-foreground hover:bg-surface" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Fetch
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
      <% if @series.cover_url.present? && @series.cover_image_url.present? %>
        <%= button_to source_series_refresh_cover_path(source_slug: @source.slug, series_slug: @series.to_param),
                      method: :post,
                      class: "absolute bottom-2 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity inline-flex items-center rounded-md bg-surface/90 border border-border px-2 py-1 text-xs font-medium text-foreground hover:text-accent" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Refresh
        <% end %>
      <% end %>
    </div>
    <div class="space-y-2 flex-1">
      <div class="flex items-center gap-2">
        <p class="text-sm text-muted"><%= @source.name || @source.key %></p>
        <%= button_to source_series_refresh_metadata_path(source_slug: @source.slug, series_slug: @series.to_param),
                      method: :post,
                      class: "inline-flex items-center gap-1 rounded-md border border-border px-2 py-0.5 text-xs text-muted hover:text-foreground hover:border-muted" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Refresh
        <% end %>
      </div>
      <h1 class="text-3xl font-semibold text-balance"><%= @series.canonical_title %></h1>
      <% if @series.localized_title.present? %>
        <p class="text-lg text-muted"><%= @series.localized_title %></p>
      <% end %>
      <% if @series.display_author.present? %>
        <p class="text-sm text-foreground">by <%= @series.display_author %></p>
      <% end %>
      <% if @series.description.present? %>
        <div class="max-w-2xl text-sm text-muted space-y-2">
          <p class="text-pretty"><%= truncate(@series.description, length: 240, separator: " ") %></p>
          <% if @series.description.length > 240 %>
            <details class="text-xs text-muted-2">
              <summary class="cursor-pointer hover:text-foreground">Show more</summary>
              <div class="mt-2 text-sm text-muted">
                <%= simple_format(@series.description, class: "space-y-2") %>
              </div>
            </details>
          <% end %>
        </div>
      <% end %>
      <p class="text-muted text-pretty">Choose a chapter to read or download.</p>

      <% if user_signed_in? %>
        <div class="flex flex-wrap items-center gap-3 mt-3" id="follow-controls">
          <% if @user_follow %>
            <%= render UI::ToggleButtonComponent.new(
              active: true,
              active_label: "Following",
              inactive_label: "Follow",
              hover_label: "Unfollow",
              form_url: follow_path(@user_follow),
              method: :delete,
              data: { turbo_confirm: "Unfollow this series?" }
            ) %>
            <%= form_with model: @user_follow, url: follow_path(@user_follow), method: :patch, local: true do |f| %>
              <%= render UI::ToggleSwitchComponent.new(
                form: f,
                method: :download_policy,
                label: "Auto-download new chapters",
                description: "Download new chapters as soon as they appear.",
                on_value: "auto_download",
                off_value: "notify_only",
                auto_submit: true
              ) %>
            <% end %>
          <% else %>
            <% if @series.library_series %>
              <%= form_with url: follows_path, method: :post, local: true do |f| %>
                <%= f.hidden_field :library_series_id, value: @series.library_series.id %>
                <%= render UI::ButtonComponent.new(variant: :primary, size: :sm) do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                  Follow
                <% end %>
              <% end %>
            <% else %>
              <span class="text-xs text-muted-2">(Cannot follow - no library series linked)</span>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <div class="flex flex-wrap items-center gap-2 text-sm text-foreground">
        <span class="text-xs uppercase text-muted-2">Reading style</span>
        <%= form_with model: @series,
                      url: source_series_update_path(source_slug: @source.slug, series_slug: @series.to_param),
                      method: :patch,
                      local: true do |form| %>
          <%= render UI::AutoSelectComponent.new(
            form: form,
            method: :reading_style,
            options: [
              ["Left to Right", "left_to_right"],
              ["Right to Left", "right_to_left"],
              ["Long Strip", "long_strip"],
              ["Webcomic", "webcomic"]
            ],
            selected: @series.reading_style
          ) %>
        <% end %>
      </div>
    </div>
  </header>

  <section class="space-y-3" data-controller="chapter-filter">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-semibold text-balance">Chapters</h2>
      <% if @chapters.any? %>
        <div class="flex items-center gap-2">
          <% if @in_progress_count > 0 %>
            <%= button_to source_series_cancel_all_downloads_path(source_slug: @source.slug, series_slug: @series.to_param),
                          method: :post,
                          class: "inline-flex items-center gap-1.5 rounded-md border border-warning/40 px-3 py-1.5 text-sm font-semibold text-warning hover:bg-warning-soft",
                          data: { turbo_confirm: "Cancel all #{@in_progress_count} in-progress download(s)?" } do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
              Cancel All
              <span class="rounded-full bg-warning/20 px-1.5 py-0.5 text-xs"><%= @in_progress_count %></span>
            <% end %>
          <% end %>
          <% if @downloaded_count > 0 %>
            <%= button_to source_series_remove_all_downloads_path(source_slug: @source.slug, series_slug: @series.to_param),
                          method: :delete,
                          class: "inline-flex items-center gap-1.5 rounded-md border border-danger/40 px-3 py-1.5 text-sm font-semibold text-danger hover:bg-danger-soft",
                          data: { turbo_confirm: "Remove all #{@downloaded_count} downloaded chapter(s)? This cannot be undone." } do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
              Remove All
              <span class="rounded-full bg-danger/20 px-1.5 py-0.5 text-xs"><%= @downloaded_count %></span>
            <% end %>
          <% end %>
          <div data-controller="loading-button">
            <%= form_with url: source_series_download_all_path(source_slug: @source.slug, series_slug: @series.to_param),
                          method: :post,
                          data: { action: "submit->loading-button#submit" } do %>
              <button type="submit"
                      data-loading-button-target="button"
                      <%= "disabled" if @downloadable_count == 0 %>
                      class="<%= @downloadable_count > 0 ? "inline-flex items-center gap-1.5 rounded-md bg-accent px-3 py-1.5 text-sm font-semibold text-accent-foreground hover:bg-accent-strong transition-opacity" : "inline-flex items-center gap-1.5 rounded-md bg-surface-2 px-3 py-1.5 text-sm font-semibold text-muted cursor-not-allowed" %>">
                <svg data-loading-button-target="spinner" xmlns="http://www.w3.org/2000/svg" class="hidden h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <svg data-loading-button-target="icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span data-loading-button-target="text">Download All</span>
                <% if @downloadable_count > 0 %>
                  <span class="rounded-full bg-background/20 px-1.5 py-0.5 text-xs"><%= @downloadable_count %></span>
                <% end %>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <%= turbo_stream_from @series, :downloads %>
    <% if @chapters.any? %>
      <div class="flex items-center gap-3">
        <div class="relative flex-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input type="text"
                 placeholder="Filter chapters by number or title…"
                 data-chapter-filter-target="input"
                 data-action="input->chapter-filter#filter"
                 class="w-full rounded-lg border border-border bg-surface-2 py-2 pl-9 pr-3 text-sm text-foreground placeholder:text-muted-2 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
        </div>
        <span data-chapter-filter-target="count" class="shrink-0 text-xs text-muted-2">
          <%= @chapters.size %> of <%= @chapters.size %>
        </span>
      </div>
      <ul class="space-y-2">
        <%= render partial: "series/chapter_row", collection: @chapters, as: :chapter, locals: { source: @source, series: @series, chapter_progress_map: @chapter_progress_map } %>
      </ul>
    <% else %>
      <div class="rounded-lg border border-dashed border-border/80 bg-surface/40 p-6">
        <p class="text-muted text-pretty">No chapters imported yet.</p>
      </div>
    <% end %>
  </section>
</div>
