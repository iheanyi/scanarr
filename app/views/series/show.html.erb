<main class="space-y-6">
  <header class="flex gap-6">
    <div class="relative group">
      <div class="h-48 w-36 shrink-0 overflow-hidden rounded-lg border border-zinc-800/80 bg-zinc-950">
        <% if @series.cover_image_url.present? %>
          <%= image_tag @series.cover_image_url, alt: "#{@series.canonical_title} cover", class: "h-full w-full object-cover" %>
        <% else %>
          <div class="flex h-full w-full flex-col items-center justify-center gap-2 p-2">
            <span class="text-xs uppercase text-zinc-500">No cover</span>
            <% if @series.cover_url.present? %>
              <%= button_to source_series_refresh_cover_path(source_slug: @source.key.to_s.tr("_", "-"), series_slug: @series.friendly_id),
                            method: :post,
                            class: "inline-flex items-center rounded-md bg-zinc-800 border border-zinc-700 px-2 py-1 text-xs font-medium text-zinc-300 hover:text-white hover:bg-zinc-700" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Fetch
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
      <% if @series.cover_url.present? && @series.cover_image_url.present? %>
        <%= button_to source_series_refresh_cover_path(source_slug: @source.key.to_s.tr("_", "-"), series_slug: @series.friendly_id),
                      method: :post,
                      class: "absolute bottom-2 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity inline-flex items-center rounded-md bg-zinc-900/90 border border-zinc-700 px-2 py-1 text-xs font-medium text-zinc-300 hover:text-white" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Refresh
        <% end %>
      <% end %>
    </div>
    <div class="space-y-2 flex-1">
      <p class="text-sm text-zinc-400"><%= @source.name || @source.key %></p>
      <h1 class="text-3xl font-semibold text-balance"><%= @series.canonical_title %></h1>
      <% if @series.display_author.present? %>
        <p class="text-sm text-zinc-300">by <%= @series.display_author %></p>
      <% end %>
      <p class="text-zinc-400 text-pretty">Choose a chapter to read or download.</p>
      <div class="flex flex-wrap items-center gap-2 text-sm text-zinc-300">
        <span class="text-xs uppercase text-zinc-500">Reading style</span>
        <%= form_with model: @series,
                      url: source_series_update_path(source_slug: @source.key.to_s.tr("_", "-"), series_slug: @series.friendly_id),
                      method: :patch,
                      local: true do |form| %>
          <%= form.select :reading_style,
                          options_for_select(
                            [
                              [ "Left to Right", "left_to_right" ],
                              [ "Right to Left", "right_to_left" ],
                              [ "Long Strip", "long_strip" ],
                              [ "Webcomic", "webcomic" ]
                            ],
                            @series.reading_style
                          ),
                          {},
                          class: "rounded-md border border-zinc-800 bg-zinc-950 px-2 py-1 text-sm text-zinc-100" %>
          <%= form.submit "Save", class: "ml-2 rounded-md border border-emerald-500/40 px-3 py-1 text-xs font-semibold text-emerald-300" %>
        <% end %>
      </div>
    </div>
  </header>

  <section class="space-y-3">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-semibold text-balance">Chapters</h2>
      <% if @chapters.any? %>
        <% downloadable_count = @chapters.count { |c| c.source_url.present? && !c.releases.max_by(&:created_at)&.file_asset&.download_status.in?(%w[queued pending downloading complete]) } %>
        <div data-controller="loading-button">
          <%= form_with url: source_series_download_all_path(source_slug: @source.key.to_s.tr("_", "-"), series_slug: @series.friendly_id),
                        method: :post,
                        data: { action: "submit->loading-button#submit" } do %>
            <button type="submit"
                    data-loading-button-target="button"
                    <%= "disabled" if downloadable_count == 0 %>
                    class="<%= downloadable_count > 0 ? "inline-flex items-center gap-1.5 rounded-md bg-emerald-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-emerald-500 transition-opacity" : "inline-flex items-center gap-1.5 rounded-md bg-zinc-700 px-3 py-1.5 text-sm font-semibold text-zinc-400 cursor-not-allowed" %>">
              <svg data-loading-button-target="spinner" xmlns="http://www.w3.org/2000/svg" class="hidden h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <svg data-loading-button-target="icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span data-loading-button-target="text">Download All</span>
              <% if downloadable_count > 0 %>
                <span class="rounded-full bg-white/20 px-1.5 py-0.5 text-xs"><%= downloadable_count %></span>
              <% end %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>
    <% if @chapters.any? %>
      <ul class="space-y-2">
        <% @chapters.each do |chapter| %>
          <li class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <%= link_to "Chapter #{chapter.chapter_number}",
                              source_series_chapter_path(
                                source_slug: @source.key.to_s.tr("_", "-"),
                                series_slug: @series.friendly_id,
                                chapter_identifier: chapter.chapter_number
                              ),
                              class: "text-base font-semibold text-emerald-300" %>
                  <% if current_user %>
                    <% progress = @chapter_progress_map[chapter.id] %>
                    <% progress_label = if progress&.status == "completed"
                                          "Completed"
                                        elsif progress
                                          "In progress"
                                        else
                                          "Not started"
                                        end %>
                    <% progress_classes = case progress_label
                                         when "Completed"
                                           "bg-emerald-500/10 text-emerald-200 border-emerald-500/30"
                                         when "In progress"
                                           "bg-amber-500/10 text-amber-200 border-amber-500/30"
                                         else
                                           "bg-zinc-800/60 text-zinc-200 border-zinc-700"
                                         end %>
                    <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-semibold <%= progress_classes %>">
                      <%= progress_label %>
                    </span>
                  <% end %>
                  <% latest_release = chapter.releases.max_by(&:created_at) %>
                  <% file_asset = latest_release&.file_asset %>
                  <% if file_asset&.download_status.present? %>
                    <% label = case file_asset.download_status
                               when "downloading"
                                 "Downloading"
                               when "failed"
                                 "Failed"
                               when "complete"
                                 "Ready"
                               else
                                 "Queued"
                               end %>
                    <% label_classes = case file_asset.download_status
                                       when "downloading"
                                         "bg-emerald-500/10 text-emerald-200 border-emerald-500/30"
                                       when "failed"
                                         "bg-rose-500/10 text-rose-200 border-rose-500/30"
                                       when "complete"
                                         "bg-sky-500/10 text-sky-200 border-sky-500/30"
                                       else
                                         "bg-zinc-800/60 text-zinc-200 border-zinc-700"
                                       end %>
                    <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-semibold <%= label_classes %>">
                      <%= label %>
                    </span>
                  <% end %>
                </div>
                <% if chapter.title.present? %>
                  <p class="text-sm text-zinc-400 text-pretty"><%= chapter.title %></p>
                <% end %>
                <% if file_asset&.download_status.present? %>
                  <p class="text-xs text-zinc-500">
                    <% if file_asset.download_status == "downloading" && file_asset.pages_expected.present? %>
                      Downloading (<%= file_asset.pages_downloaded %>/<%= file_asset.pages_expected %>)
                    <% elsif file_asset.download_status == "failed" %>
                      Download failed
                    <% elsif file_asset.download_status == "complete" %>
                      Ready
                    <% else %>
                      Queued
                    <% end %>
                  </p>
                <% end %>
              </div>
              <div class="flex items-center gap-2">
                <% if file_asset&.download_status == "complete" %>
                  <%= button_to source_series_chapter_remove_download_path(
                                  source_slug: @source.key.to_s.tr("_", "-"),
                                  series_slug: @series.friendly_id,
                                  chapter_identifier: chapter.chapter_number
                                ),
                                method: :delete,
                                class: "inline-flex items-center rounded-md border border-rose-500/40 px-3 py-1.5 text-sm font-semibold text-rose-300 hover:bg-rose-500/10",
                                data: { turbo_confirm: "Remove download for Chapter #{chapter.chapter_number}?" } do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                    Remove
                  <% end %>
                <% end %>
                <% if file_asset&.download_status.in?(%w[queued pending downloading]) %>
                  <%= button_to source_series_chapter_cancel_download_path(
                                  source_slug: @source.key.to_s.tr("_", "-"),
                                  series_slug: @series.friendly_id,
                                  chapter_identifier: chapter.chapter_number
                                ),
                                method: :post,
                                class: "inline-flex items-center rounded-md border border-amber-500/40 px-3 py-1.5 text-sm font-semibold text-amber-300 hover:bg-amber-500/10" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    Cancel
                  <% end %>
                <% end %>
                <% if chapter.source_url.present? %>
                  <% download_in_progress = file_asset&.download_status.in?(%w[queued pending downloading]) %>
                  <% is_complete = file_asset&.download_status == "complete" %>
                  <% unless download_in_progress %>
                    <%= button_to is_complete ? "Re-download" : "Download",
                                  source_series_chapter_download_path(
                                    source_slug: @source.key.to_s.tr("_", "-"),
                                    series_slug: @series.friendly_id,
                                    chapter_identifier: chapter.chapter_number
                                  ),
                                  method: :post,
                                  class: "inline-flex items-center rounded-md border border-emerald-500/40 px-3 py-1.5 text-sm font-semibold text-emerald-300" %>
                  <% end %>
                <% end %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="rounded-lg border border-dashed border-zinc-800/80 bg-zinc-900/40 p-6">
        <p class="text-zinc-400 text-pretty">No chapters imported yet.</p>
      </div>
    <% end %>
  </section>
</main>
