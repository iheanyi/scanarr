<%# locals: (chapter:, source:, series:, progress: nil, chapter_progress_map: nil, latest_release: nil, latest_release_map: nil) %>
<% progress = progress || chapter_progress_map&.dig(chapter.id) %>
<% latest_release = latest_release || latest_release_map&.dig(chapter.id) || (chapter.releases.loaded? ? chapter.releases.to_a.max_by(&:created_at) : nil) %>
<% file_asset = latest_release&.file_asset %>
<% is_read = progress&.status == "completed" %>
<li id="<%= dom_id(chapter) %>"
    data-chapter-filter-target="item"
    data-chapter-filter-text="chapter <%= chapter.chapter_number %> <%= chapter.title %>"
    class="group/row rounded-lg border border-border/80 bg-surface/40 p-4 hover:border-accent/30 transition-colors <%= "opacity-60" if is_read %>">
  <div class="flex gap-3 sm:items-center">
    <div class="pt-1 sm:pt-0 shrink-0 bulk-checkbox opacity-0 group-hover/row:opacity-100 transition-opacity">
      <input type="checkbox"
             value="<%= chapter.id %>"
             data-bulk-select-target="checkbox"
             data-action="change->bulk-select#toggle"
             class="h-4 w-4 rounded border-border text-accent focus:ring-accent cursor-pointer">
    </div>
    <div class="flex flex-1 flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="space-y-1">
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to "Chapter #{chapter.chapter_number}",
                    source_series_chapter_path(
                      source_slug: source.slug,
                      series_slug: series.to_param,
                      chapter_identifier: chapter_identifier(chapter)
                    ),
                    class: "text-base font-semibold #{is_read ? "text-muted" : "text-accent"}" %>
        <%# Single-badge priority: active download > failed > reading progress > download complete %>
        <span id="<%= dom_id(chapter, :status) %>">
          <% if file_asset&.download_status.in?(%w[queued pending downloading]) %>
            <% dl_label = file_asset.download_status == "downloading" ? "Downloading" : "Queued" %>
            <%= render UI::StatusBadgeComponent.new(status: file_asset.download_status, label: dl_label, bordered: true) %>
          <% elsif file_asset&.download_status == "failed" %>
            <%= render UI::StatusBadgeComponent.new(status: "failed", label: "Failed", bordered: true) %>
          <% elsif progress.present? %>
            <% progress_label = progress.status == "completed" ? "Completed" : "In Progress" %>
            <%= render UI::StatusBadgeComponent.new(status: progress.status == "completed" ? "completed" : "in progress", label: progress_label, bordered: true) %>
          <% end %>
        </span>
      </div>
      <% if chapter.meaningful_title? %>
        <p class="text-sm text-muted text-pretty"><%= chapter.title %></p>
      <% end %>
      <p id="<%= dom_id(chapter, :progress) %>" class="text-xs text-muted-2">
        <% if file_asset&.download_status == "downloading" && file_asset.pages_expected.present? %>
          Downloading (<%= file_asset.pages_downloaded %>/<%= file_asset.pages_expected %>)
        <% elsif file_asset&.download_status == "failed" && file_asset.download_error.present? %>
          <%= file_asset.download_error.truncate(50) %>
        <% elsif progress.present? %>
          <% if progress.status == "in_progress" && progress.page_count.to_i > 0 %>
            Page <%= progress.page_index %>/<%= progress.page_count %> · Last read <%= time_ago_in_words(progress.progressed_at) %> ago
          <% else %>
            Last read <%= time_ago_in_words(progress.progressed_at) %> ago
          <% end %>
        <% end %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <% if file_asset&.download_status == "complete" %>
        <%= render UI::ConfirmButtonComponent.new(
          label: "Remove",
          url: source_series_chapter_remove_download_path(
            source_slug: source.slug,
            series_slug: series.to_param,
            chapter_identifier: chapter_identifier(chapter)
          ),
          method: :delete,
          variant: :danger,
          confirm: "Remove download for Chapter #{chapter.chapter_number}?",
          icon: "trash-2"
        ) %>
      <% end %>
      <% if file_asset&.download_status.in?(%w[queued pending downloading]) %>
        <%= render UI::ConfirmButtonComponent.new(
          label: "Cancel",
          url: source_series_chapter_cancel_download_path(
            source_slug: source.slug,
            series_slug: series.to_param,
            chapter_identifier: chapter_identifier(chapter)
          ),
          method: :post,
          variant: :warning,
          confirm: "Cancel this download?",
          icon: "x"
        ) %>
      <% end %>
      <% if chapter.source_url.present? %>
        <% download_in_progress = file_asset&.download_status.in?(%w[queued pending downloading]) %>
        <% is_complete = file_asset&.download_status == "complete" %>
        <% unless download_in_progress %>
          <%= form_with url: source_series_chapter_download_path(
                        source_slug: source.slug,
                        series_slug: series.to_param,
                        chapter_identifier: chapter_identifier(chapter)
                      ),
                      method: :post do %>
            <%= render UI::ButtonComponent.new(
              type: "submit",
              variant: :ghost,
              class: "border-accent/40 text-accent hover:bg-accent-soft",
              data: { turbo_submits_with: "Queuing..." }
            ) do %>
              <%= is_complete ? "Re-download" : "Download" %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    </div>
  </div>
</li>
