<%# locals: (chapter:, source:, series:, progress: nil, chapter_progress_map: nil, latest_release: nil, latest_release_map: nil, offline_manifest_entry: nil, offline_manifest_map: nil) %>
<% progress = progress || chapter_progress_map&.dig(chapter.id) %>
<% latest_release = latest_release || latest_release_map&.dig(chapter.id) || (chapter.releases.loaded? ? chapter.releases.to_a.max_by(&:created_at) : nil) %>
<% file_asset = latest_release&.file_asset %>
<% offline_manifest_entry = offline_manifest_entry || offline_manifest_map&.dig(chapter.id) %>
<% offline_status = offline_manifest_entry&.status || "unpinned" %>
<% offline_capable = local_downloads_enabled? && (chapter.source_url.present? || latest_release&.source_url.present? || file_asset&.download_status == "complete") %>
<% show_offline_download_icon = offline_status.in?(%w[unpinned failed]) %>
<% show_offline_cancel_icon = offline_status.in?(%w[downloading pinned]) %>
<% show_offline_remove_icon = offline_status == "complete" %>
<% chapter_key = "#{source.slug}:#{series.to_param}:#{chapter_identifier(chapter)}" %>
<% is_read = progress&.status == "completed" %>
<li id="<%= dom_id(chapter) %>"
    data-controller="<%= offline_capable ? "offline-cache" : nil %>"
    <% if offline_capable %>
    data-offline-cache-chapter-key-value="<%= chapter_key %>"
    data-offline-cache-chapter-public-id-value="<%= chapter.public_id %>"
    data-offline-cache-source-slug-value="<%= source.slug %>"
    data-offline-cache-series-slug-value="<%= series.to_param %>"
    data-offline-cache-chapter-identifier-value="<%= chapter_identifier(chapter) %>"
    data-offline-cache-pin-url-value="<%= source_series_chapter_pin_for_offline_path(source_slug: source.slug, series_slug: series.to_param, chapter_identifier: chapter_identifier(chapter)) %>"
    data-offline-cache-unpin-url-value="<%= source_series_chapter_unpin_for_offline_path(source_slug: source.slug, series_slug: series.to_param, chapter_identifier: chapter_identifier(chapter)) %>"
    data-offline-cache-pages-url-value="<%= source_series_chapter_offline_pages_path(source_slug: source.slug, series_slug: series.to_param, chapter_identifier: chapter_identifier(chapter)) %>"
    <% end %>
    data-chapter-filter-target="item"
    data-chapter-filter-text="chapter <%= chapter.chapter_number %> <%= chapter.title %>"
    class="group/row rounded-lg border border-border/80 bg-surface/40 p-4 hover:border-accent/30 transition-colors <%= "opacity-60" if is_read %>">
  <div class="flex gap-3 sm:items-center">
    <div class="pt-1 sm:pt-0 shrink-0 bulk-checkbox opacity-0 group-hover/row:opacity-100 transition-opacity">
      <input type="checkbox"
             value="<%= chapter.id %>"
             data-bulk-select-target="checkbox"
             data-action="change->bulk-select#toggle"
             class="h-4 w-4 rounded border-border text-accent focus:ring-accent cursor-pointer">
    </div>
    <div class="flex flex-1 flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="space-y-1">
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to "Chapter #{chapter.chapter_number}",
                    source_series_chapter_path(
                      source_slug: source.slug,
                      series_slug: series.to_param,
                      chapter_identifier: chapter_identifier(chapter)
                    ),
                    class: "text-base font-semibold #{is_read ? "text-muted" : "text-accent"}" %>
        <% if offline_capable %>
          <span data-offline-cache-target="availableIndicator"
                class="inline-flex h-4 w-4 items-center justify-center text-success"
                title="Available offline"
                aria-label="Available offline"
                <%= "hidden" unless offline_status == "complete" %>>
            <%= icon "check", class: "h-2.5 w-2.5" %>
            <span class="sr-only">Available offline</span>
          </span>
        <% end %>
        <%# Single-badge priority: active download > failed > reading progress > download complete %>
        <span id="<%= dom_id(chapter, :status) %>">
          <% if file_asset&.download_status.in?(%w[queued pending downloading]) %>
            <% dl_label = file_asset.download_status == "downloading" ? "Downloading" : "Queued" %>
            <%= render UI::StatusBadgeComponent.new(status: file_asset.download_status, label: dl_label, bordered: true) %>
          <% elsif file_asset&.download_status == "failed" %>
            <%= render UI::StatusBadgeComponent.new(status: "failed", label: "Failed", bordered: true) %>
          <% elsif progress.present? %>
            <% progress_label = progress.status == "completed" ? "Completed" : "In Progress" %>
            <%= render UI::StatusBadgeComponent.new(status: progress.status == "completed" ? "completed" : "in progress", label: progress_label, bordered: true) %>
          <% end %>
        </span>
        <% if offline_capable %>
          <div class="group/offline inline-flex items-center gap-1 rounded-full px-0.5 py-0.5">
            <span class="max-w-0 overflow-hidden whitespace-nowrap px-0 text-[10px] text-muted-2 tabular-nums text-right opacity-0 transition-all duration-150 group-hover/offline:max-w-8 group-hover/offline:px-1 group-hover/offline:opacity-100 group-focus-within/offline:max-w-8 group-focus-within/offline:px-1 group-focus-within/offline:opacity-100"
                  <%= "hidden" unless show_offline_cancel_icon %>
                  data-offline-cache-target="progress"></span>
            <button type="button"
                    class="inline-flex h-5 w-5 items-center justify-center rounded-full border border-border/50 bg-surface/40 text-muted-2 transition-colors hover:border-info/35 hover:bg-surface hover:text-info focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                    data-action="click->offline-cache#download"
                    data-offline-cache-target="downloadButton"
                    <%= "hidden" unless show_offline_download_icon %>>
              <%= icon "download", class: "h-3 w-3" %>
              <span class="sr-only">Download for offline</span>
            </button>
            <button type="button"
                    class="inline-flex h-5 w-5 items-center justify-center rounded-full border border-border/50 bg-surface/40 text-muted-2 transition-colors hover:border-warning/35 hover:bg-surface hover:text-warning focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                    data-action="click->offline-cache#cancel"
                    data-offline-cache-target="cancelButton"
                    <%= "hidden" unless show_offline_cancel_icon %>>
              <%= icon "x", class: "h-3 w-3" %>
              <span class="sr-only">Cancel offline download</span>
            </button>
            <button type="button"
                    class="inline-flex h-5 w-5 items-center justify-center rounded-full border border-border/50 bg-surface/40 text-muted-2 transition-colors hover:border-danger/35 hover:bg-surface hover:text-danger focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                    data-action="click->offline-cache#remove"
                    data-offline-cache-target="removeButton"
                    <%= "hidden" unless show_offline_remove_icon %>>
              <%= icon "trash-2", class: "h-3 w-3" %>
              <span class="sr-only">Remove offline chapter</span>
            </button>
          </div>
        <% end %>
      </div>
      <% if chapter.meaningful_title? %>
        <p class="text-sm text-muted text-pretty"><%= chapter.title %></p>
      <% end %>
      <p id="<%= dom_id(chapter, :progress) %>" class="text-xs text-muted-2">
        <% if file_asset&.download_status == "downloading" && file_asset.pages_expected.present? %>
          Downloading (<%= file_asset.pages_downloaded %>/<%= file_asset.pages_expected %>)
        <% elsif file_asset&.download_status == "failed" && file_asset.download_error.present? %>
          <%= file_asset.download_error.truncate(50) %>
        <% elsif progress.present? %>
          <% if progress.status == "in_progress" && progress.page_count.to_i > 0 %>
            Page <%= progress.page_index %>/<%= progress.page_count %> · Last read <%= time_ago_in_words(progress.progressed_at) %> ago
          <% else %>
            Last read <%= time_ago_in_words(progress.progressed_at) %> ago
          <% end %>
        <% end %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <% if file_asset&.download_status == "complete" %>
        <%= render UI::ConfirmButtonComponent.new(
          label: "Remove",
          url: source_series_chapter_remove_download_path(
            source_slug: source.slug,
            series_slug: series.to_param,
            chapter_identifier: chapter_identifier(chapter)
          ),
          method: :delete,
          variant: :danger,
          confirm: "Remove download for Chapter #{chapter.chapter_number}?",
          icon: "trash-2"
        ) %>
      <% end %>
      <% if file_asset&.download_status.in?(%w[queued pending downloading]) %>
        <%= render UI::ConfirmButtonComponent.new(
          label: "Cancel",
          url: source_series_chapter_cancel_download_path(
            source_slug: source.slug,
            series_slug: series.to_param,
            chapter_identifier: chapter_identifier(chapter)
          ),
          method: :post,
          variant: :warning,
          confirm: "Cancel this download?",
          icon: "x"
        ) %>
      <% end %>
      <% if chapter.source_url.present? %>
        <% download_in_progress = file_asset&.download_status.in?(%w[queued pending downloading]) %>
        <% is_complete = file_asset&.download_status == "complete" %>
        <% unless download_in_progress %>
          <%= form_with url: source_series_chapter_download_path(
                        source_slug: source.slug,
                        series_slug: series.to_param,
                        chapter_identifier: chapter_identifier(chapter)
                      ),
                      method: :post do %>
            <%= render UI::ButtonComponent.new(
              type: "submit",
              variant: :ghost,
              class: "border-accent/40 text-accent hover:bg-accent-soft",
              data: { turbo_submits_with: "Queuing..." }
            ) do %>
              <%= is_complete ? "Re-download" : "Download" %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

    </div>
    </div>
  </div>
</li>
