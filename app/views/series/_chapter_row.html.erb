<%# locals: (chapter:, source:, series:, progress: nil) %>
<% latest_release = chapter.releases.max_by(&:created_at) %>
<% file_asset = latest_release&.file_asset %>
<li id="<%= dom_id(chapter) %>" class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="space-y-1">
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to "Chapter #{chapter.chapter_number}",
                    source_series_chapter_path(
                      source_slug: source.key.to_s.tr("_", "-"),
                      series_slug: series.friendly_id,
                      chapter_identifier: chapter.chapter_number
                    ),
                    class: "text-base font-semibold text-emerald-300" %>
        <% if progress.present? %>
          <% progress_label = if progress.status == "completed"
                                "Completed"
                              else
                                "In progress"
                              end %>
          <% progress_classes = case progress_label
                               when "Completed"
                                 "bg-emerald-500/10 text-emerald-200 border-emerald-500/30"
                               else
                                 "bg-amber-500/10 text-amber-200 border-amber-500/30"
                               end %>
          <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-semibold <%= progress_classes %>">
            <%= progress_label %>
          </span>
        <% end %>
        <% if file_asset&.download_status.present? %>
          <% label = case file_asset.download_status
                     when "downloading"
                       "Downloading"
                     when "failed"
                       "Failed"
                     when "complete"
                       "Ready"
                     else
                       "Queued"
                     end %>
          <% label_classes = case file_asset.download_status
                             when "downloading"
                               "bg-emerald-500/10 text-emerald-200 border-emerald-500/30"
                             when "failed"
                               "bg-rose-500/10 text-rose-200 border-rose-500/30"
                             when "complete"
                               "bg-sky-500/10 text-sky-200 border-sky-500/30"
                             else
                               "bg-zinc-800/60 text-zinc-200 border-zinc-700"
                             end %>
          <span id="<%= dom_id(chapter, :status) %>" class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-semibold <%= label_classes %>">
            <%= label %>
          </span>
        <% end %>
      </div>
      <% if chapter.title.present? %>
        <p class="text-sm text-zinc-400 text-pretty"><%= chapter.title %></p>
      <% end %>
      <% if file_asset&.download_status.present? %>
        <p id="<%= dom_id(chapter, :progress) %>" class="text-xs text-zinc-500">
          <% if file_asset.download_status == "downloading" && file_asset.pages_expected.present? %>
            Downloading (<%= file_asset.pages_downloaded %>/<%= file_asset.pages_expected %>)
          <% elsif file_asset.download_status == "failed" %>
            Download failed<%= ": #{file_asset.download_error.truncate(50)}" if file_asset.download_error.present? %>
          <% elsif file_asset.download_status == "complete" %>
            Ready
          <% else %>
            Queued
          <% end %>
        </p>
      <% end %>
    </div>
    <div class="flex items-center gap-2">
      <% if file_asset&.download_status == "complete" %>
        <%= button_to source_series_chapter_remove_download_path(
                        source_slug: source.key.to_s.tr("_", "-"),
                        series_slug: series.friendly_id,
                        chapter_identifier: chapter.chapter_number
                      ),
                      method: :delete,
                      class: "inline-flex items-center rounded-md border border-rose-500/40 px-3 py-1.5 text-sm font-semibold text-rose-300 hover:bg-rose-500/10",
                      data: { turbo_confirm: "Remove download for Chapter #{chapter.chapter_number}?" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          Remove
        <% end %>
      <% end %>
      <% if file_asset&.download_status.in?(%w[queued pending downloading]) %>
        <%= button_to source_series_chapter_cancel_download_path(
                        source_slug: source.key.to_s.tr("_", "-"),
                        series_slug: series.friendly_id,
                        chapter_identifier: chapter.chapter_number
                      ),
                      method: :post,
                      class: "inline-flex items-center rounded-md border border-amber-500/40 px-3 py-1.5 text-sm font-semibold text-amber-300 hover:bg-amber-500/10" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
          Cancel
        <% end %>
      <% end %>
      <% if chapter.source_url.present? %>
        <% download_in_progress = file_asset&.download_status.in?(%w[queued pending downloading]) %>
        <% is_complete = file_asset&.download_status == "complete" %>
        <% unless download_in_progress %>
          <%= button_to is_complete ? "Re-download" : "Download",
                        source_series_chapter_download_path(
                          source_slug: source.key.to_s.tr("_", "-"),
                          series_slug: series.friendly_id,
                          chapter_identifier: chapter.chapter_number
                        ),
                        method: :post,
                        class: "inline-flex items-center rounded-md border border-emerald-500/40 px-3 py-1.5 text-sm font-semibold text-emerald-300" %>
        <% end %>
      <% end %>
    </div>
  </div>
</li>
