<main class="space-y-6">
  <header class="space-y-2">
    <p class="text-sm text-zinc-400"><%= @source.name || @source.key %></p>
    <h1 class="text-3xl font-semibold text-balance">Series</h1>
    <p class="text-zinc-400 text-pretty">Browse imported series for this source.</p>
  </header>

  <% if @series.any? %>
    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @series.each do |series| %>
        <%= link_to source_series_path(
                      source_slug: @source.key.to_s.tr("_", "-"),
                      series_slug: series.to_param
                    ),
                    class: "group rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4 hover:border-emerald-500/40 transition-colors" do %>
          <div class="flex gap-4">
            <div class="h-32 w-24 shrink-0 overflow-hidden rounded-md border border-zinc-800/80 bg-zinc-950">
              <% if series.cover_image_url.present? %>
                <%= image_tag series.cover_image_url, alt: "#{series.canonical_title} cover", class: "h-full w-full object-cover", loading: "lazy" %>
              <% else %>
                <div class="flex h-full w-full items-center justify-center text-[10px] uppercase text-zinc-500">
                  No cover
                </div>
              <% end %>
            </div>
            <div class="flex flex-col min-w-0">
              <h2 class="text-lg font-semibold text-balance line-clamp-2 group-hover:text-emerald-300 transition-colors"><%= series.canonical_title %></h2>
              <% if series.display_author.present? %>
                <p class="text-sm text-zinc-400 mt-1">by <%= series.display_author %></p>
              <% end %>
              <p class="text-xs text-zinc-500 mt-auto"><%= series.chapters.count %> chapters</p>
            </div>
          </div>
        <% end %>
      <% end %>
    </section>
  <% else %>
    <section class="rounded-lg border border-dashed border-zinc-800/80 bg-zinc-900/40 p-6">
      <p class="text-zinc-400 text-pretty">No series imported yet.</p>
      <div class="mt-4">
        <%= link_to "Search this source",
                    source_search_path(source_slug: @source.key.to_s.tr("_", "-")),
                    class: "inline-flex items-center rounded-md bg-emerald-500 px-4 py-2 text-sm font-semibold text-zinc-950" %>
      </div>
    </section>
  <% end %>
</main>
