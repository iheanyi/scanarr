<div class="space-y-6">
  <%= render UI::PageHeaderComponent.new(
    title: "Series",
    description: "Browse imported series for this source.",
    breadcrumb_text: @source.name || @source.key
  ) %>

  <% if @series.any? %>
    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @series.each do |series| %>
        <%= link_to source_series_path(
                      source_slug: @source.slug,
                      series_slug: series.to_param
                    ),
                    class: "group rounded-lg border border-border/80 bg-surface/40 p-4 hover:border-accent/40 transition-colors" do %>
          <div class="flex gap-4">
            <div class="h-32 w-24 shrink-0 overflow-hidden rounded-md border border-border/80 bg-background">
              <% if series.cover_image_url.present? %>
                <%= image_tag series.cover_image_url, alt: "#{series.canonical_title} cover", class: "h-full w-full object-cover", loading: "lazy" %>
              <% else %>
                <div class="flex h-full w-full items-center justify-center text-[10px] uppercase text-muted-2">
                  No cover
                </div>
              <% end %>
            </div>
            <div class="flex flex-col min-w-0">
              <h2 class="text-lg font-semibold text-balance line-clamp-2 group-hover:text-accent transition-colors"><%= series.canonical_title %></h2>
              <% if series.display_author.present? %>
                <p class="text-sm text-muted mt-1">by <%= series.display_author %></p>
              <% end %>
              <p class="text-xs text-muted-2 mt-auto"><%= series.chapters_count %> chapters</p>
            </div>
          </div>
        <% end %>
      <% end %>
    </section>
  <% else %>
    <section class="rounded-lg border border-dashed border-border/80 bg-surface/40 p-6">
      <p class="text-muted text-pretty">No series imported yet.</p>
      <div class="mt-4">
        <%= link_to "Search this source",
                    source_search_path(source_slug: @source.slug),
                    class: "inline-flex items-center rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-foreground" %>
      </div>
    </section>
  <% end %>
</div>
