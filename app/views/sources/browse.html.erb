<div class="space-y-6">
  <%= render UI::PageHeaderComponent.new(
    title: "Browse",
    description: "Discover new series from this source.",
    breadcrumb_text: @source.name || @source.key
  ) %>

  <% if @error.present? %>
    <div class="rounded-lg border border-danger/30 bg-danger-soft px-4 py-3 text-sm text-danger">
      <%= @error %>
    </div>
  <% else %>
    <section class="rounded-lg border border-border bg-surface p-4">
      <%= form_with url: source_browse_path(source_slug: source_slug(@source)), method: :get, local: true, class: "flex flex-wrap items-end gap-3" do |form| %>
        <%= render UI::SelectComponent.new(
          form: form,
          method: :sort,
          options: @sort_options.map { |s| [s.titleize, s] },
          selected: @sort,
          label: "Sort by"
        ) %>
        <%= form.submit "Apply",
                        class: "inline-flex items-center justify-center rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-foreground" %>
      <% end %>
    </section>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold text-balance">
          <%= @sort.titleize %> Series
          <span class="text-muted-2 font-normal">(<%= @results.size %>)</span>
        </h2>
        <div class="flex items-center gap-2">
          <% if @page > 1 %>
            <%= link_to source_browse_path(source_slug: source_slug(@source), sort: @sort, page: @page - 1),
                        class: "inline-flex items-center gap-1 rounded-md border border-border px-3 py-1.5 text-sm text-foreground hover:bg-surface-2" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
              Previous
            <% end %>
          <% end %>
          <span class="text-sm text-muted-2">Page <%= @page %></span>
          <% if @results.size >= 24 %>
            <%= link_to source_browse_path(source_slug: source_slug(@source), sort: @sort, page: @page + 1),
                        class: "inline-flex items-center gap-1 rounded-md border border-border px-3 py-1.5 text-sm text-foreground hover:bg-surface-2" do %>
              Next
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            <% end %>
          <% end %>
        </div>
      </div>

      <% if @results.any? %>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
          <% @results.each do |result| %>
            <div class="group relative overflow-hidden rounded-lg border border-border bg-surface">
              <div class="aspect-[2/3] overflow-hidden bg-background">
                <% if result.cover_url.present? %>
                  <%= image_tag result.cover_url,
                                alt: "#{result.title} cover",
                                class: "h-full w-full object-cover transition-transform group-hover:scale-105",
                                loading: "lazy" %>
                <% else %>
                  <div class="flex h-full w-full items-center justify-center text-xs uppercase text-muted-2">
                    No cover
                  </div>
                <% end %>
              </div>
              <div class="p-2">
                <p class="text-sm font-medium text-foreground line-clamp-2" title="<%= result.title %>">
                  <%= result.title %>
                </p>
                <% if result.respond_to?(:author) && result.author.present? %>
                  <p class="mt-0.5 text-xs text-muted-2 truncate"><%= result.author %></p>
                <% end %>
                <% if result.respond_to?(:status) && result.status.present? %>
                  <%= render UI::StatusBadgeComponent.new(status: result.status, class: "mt-1") %>
                <% end %>
              </div>

              <%# Hover overlay with description and actions %>
              <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-background via-background/80 to-transparent opacity-0 transition-opacity group-hover:opacity-100">
                <div class="max-h-[60%] overflow-hidden p-3 space-y-2">
                  <% if result.respond_to?(:description) && result.description.present? %>
                    <p class="text-xs text-foreground line-clamp-4 leading-relaxed">
                      <%= truncate(result.description, length: 200) %>
                    </p>
                  <% end %>
                  <div class="flex gap-2">
                    <%= link_to source_preview_path(source_slug: source_slug(@source), series_url: result.url),
                                class: "flex-1 rounded-md border border-border px-2 py-1.5 text-center text-xs font-medium text-foreground hover:bg-surface-2" do %>
                      Details
                    <% end %>
                    <%= button_to "Import",
                                  source_import_path(source_slug: source_slug(@source)),
                                  method: :post,
                                  params: { series_url: result.url },
                                  class: "flex-1 rounded-md bg-accent px-2 py-1.5 text-xs font-semibold text-accent-foreground hover:bg-accent-strong",
                                  data: { turbo_submits_with: "Importing..." } %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <%# Bottom pagination %>
        <% if @results.size >= 24 || @page > 1 %>
          <div class="flex items-center justify-center gap-2 pt-4">
            <% if @page > 1 %>
              <%= link_to source_browse_path(source_slug: source_slug(@source), sort: @sort, page: @page - 1),
                          class: "inline-flex items-center gap-1 rounded-md border border-border px-4 py-2 text-sm text-foreground hover:bg-surface-2" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
                Previous
              <% end %>
            <% end %>
            <span class="px-3 py-2 text-sm text-muted">Page <%= @page %></span>
            <% if @results.size >= 24 %>
              <%= link_to source_browse_path(source_slug: source_slug(@source), sort: @sort, page: @page + 1),
                          class: "inline-flex items-center gap-1 rounded-md border border-border px-4 py-2 text-sm text-foreground hover:bg-surface-2" do %>
                Next
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="rounded-lg border border-dashed border-border p-8 text-center">
          <p class="text-muted">No series found.</p>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
