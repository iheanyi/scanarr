<div class="space-y-6">
  <section>
    <%= render UI::PageHeaderComponent.new(
      title: "Browse",
      description: "Discover new series from this source.",
      breadcrumb_text: @source.name || @source.key
    ) %>
  </section>

  <% if @error.present? %>
    <%= render UI::FlashMessageComponent.new(variant: :danger, message: @error) %>
  <% else %>
    <% has_filter_options = @browse_filter_options.values.any?(&:present?) %>
    <%= turbo_frame_tag "browse-content", class: "has-loading-overlay" do %>
      <section class="scanarr-subtle-panel rounded-lg p-4">
        <%= form_with url: source_browse_path(source_slug: source_slug(@source)),
                      method: :get,
                      data: { turbo_frame: "browse-content", turbo_action: "advance" },
                      class: "space-y-3" do |form| %>
        <%= form.hidden_field :page, value: 1 %>
        <div class="flex flex-wrap items-end gap-3">
          <div class="w-fit" data-controller="auto-submit">
            <%= render UI::SelectComponent.new(
              form: form,
              method: :sort,
              options: @sort_options.map { |s| [ s.titleize, s ] },
              selected: @sort,
              label: "Sort by",
              data: { action: "change->auto-submit#submit" }
            ) %>
          </div>
        </div>

        <% advanced_filters_active = @selected_genres.present? || @selected_statuses.present? %>
        <details class="rounded-lg border border-border/70 bg-background/50 p-3" <%= "open" if advanced_filters_active %>>
          <summary class="cursor-pointer select-none text-sm font-medium text-muted hover:text-foreground">
            Advanced filters
          </summary>
          <% if has_filter_options %>
            <div class="mt-3 grid gap-3 md:grid-cols-3">
              <% if @browse_filter_options[:genres].present? %>
                <div data-controller="auto-submit" data-auto-submit-delay-value="150" data-action="change->auto-submit#submitDebounced">
                  <%= render UI::MultiSelectComponent.new(
                    name: :genres,
                    options: @browse_filter_options[:genres],
                    selected: @selected_genres,
                    label: "Genres",
                    filter_placeholder: "Filter genres",
                    all_label: "All genres",
                    max_chips: 2
                  ) %>
                </div>
              <% end %>

              <% if @browse_filter_options[:statuses].present? %>
                <div data-controller="auto-submit" data-auto-submit-delay-value="150" data-action="change->auto-submit#submitDebounced">
                  <%= render UI::MultiSelectComponent.new(
                    name: :statuses,
                    options: @browse_filter_options[:statuses],
                    selected: @selected_statuses,
                    label: "Status",
                    filter_placeholder: "Filter status",
                    all_label: "All statuses",
                    max_chips: 2
                  ) %>
                </div>
              <% end %>

              <div class="flex items-end">
                <%= link_to "Clear advanced filters",
                            source_browse_path(source_browse_params(page: 1, genres: nil, statuses: nil)),
                            class: "inline-flex h-9 items-center rounded-md border border-border px-3 text-sm text-muted hover:text-foreground hover:border-muted" %>
              </div>
            </div>
          <% else %>
            <p class="mt-3 text-xs text-muted-2">This source does not expose genre or status filters yet.</p>
          <% end %>
        </details>
        <% end %>
      </section>

      <section class="mt-6 space-y-4">
        <% if @selected_genres.present? || @selected_statuses.present? %>
          <section class="flex flex-wrap items-center gap-2">
            <% @selected_genres.each do |genre| %>
              <%= link_to source_browse_path(source_browse_params(page: 1, genres: (@selected_genres - [ genre ]).presence)),
                          class: "inline-flex items-center gap-1 rounded-full border border-border bg-surface-2 px-2.5 py-1 text-xs text-foreground hover:border-accent/40" do %>
                <span>Genre: <%= source_filter_label(:genres, genre) %></span>
                <span aria-hidden="true">&times;</span>
              <% end %>
            <% end %>

            <% @selected_statuses.each do |status| %>
              <%= link_to source_browse_path(source_browse_params(page: 1, statuses: (@selected_statuses - [ status ]).presence)),
                          class: "inline-flex items-center gap-1 rounded-full border border-border bg-surface-2 px-2.5 py-1 text-xs text-foreground hover:border-accent/40" do %>
                <span>Status: <%= source_filter_label(:statuses, status) %></span>
                <span aria-hidden="true">&times;</span>
              <% end %>
            <% end %>

            <%= link_to "Clear all filters",
                        source_browse_path(source_browse_params(page: 1, genres: nil, statuses: nil)),
                        class: "inline-flex items-center rounded-full border border-border px-2.5 py-1 text-xs text-muted hover:text-foreground hover:border-muted" %>
          </section>
        <% end %>

        <h2 class="text-lg font-semibold text-balance">
          <%= @sort.titleize %> Series
        </h2>

        <% if @results.any? %>
          <% if @page == 1 %>
            <%# Single grid — turbo-frames use display:contents so all items flow seamlessly %>
            <div class="browse-grid grid grid-cols-2 gap-x-4 gap-y-7 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5">
              <% @results.each do |result| %>
                <%= render "browse_card", result: result %>
              <% end %>

              <% if @results.size >= @page_size %>
                <% next_page_url = source_browse_path(source_browse_params(page: @page + 1)) %>
                <%= turbo_frame_tag "browse-page-#{@page + 1}",
                    data: { controller: "lazy-frame", lazy_frame_url_value: next_page_url } do %>
                  <div class="col-span-full flex flex-col items-center gap-3 py-8" data-lazy-frame-target="sentinel">
                    <%= render UI::SpinnerComponent.new(size: :md) %>
                    <noscript>
                      <%= link_to "Load more", next_page_url, class: "text-sm text-muted hover:text-foreground" %>
                    </noscript>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <%# Subsequent pages: items + next sentinel, wrapped in turbo-frame for replacement %>
            <%= turbo_frame_tag "browse-page-#{@page}" do %>
              <% @results.each do |result| %>
                <%= render "browse_card", result: result %>
              <% end %>

              <% if @results.size >= @page_size %>
                <% next_page_url = source_browse_path(source_browse_params(page: @page + 1)) %>
                <%= turbo_frame_tag "browse-page-#{@page + 1}",
                    data: { controller: "lazy-frame", lazy_frame_url_value: next_page_url } do %>
                  <div class="col-span-full flex flex-col items-center gap-3 py-8" data-lazy-frame-target="sentinel">
                    <%= render UI::SpinnerComponent.new(size: :md) %>
                    <noscript>
                      <%= link_to "Load more", next_page_url, class: "text-sm text-muted hover:text-foreground" %>
                    </noscript>
                  </div>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% else %>
          <%= render UI::EmptyStateComponent.new(
            title: "No series found",
            description: "Try a different sort option or check back later.",
            compact: true
          ) do |empty| %>
            <% empty.with_icon do %>
              <%= icon "search", class: "h-6 w-6" %>
            <% end %>
          <% end %>
        <% end %>
      </section>
    <% end %>
  <% end %>
</div>
