<div class="space-y-6">
  <%= render UI::PageHeaderComponent.new(
    title: "Browse",
    description: "Discover new series from this source.",
    breadcrumb_text: @source.name || @source.key
  ) %>

  <% if @error.present? %>
    <%= render UI::FlashMessageComponent.new(variant: :danger, message: @error) %>
  <% else %>
    <section class="rounded-lg border border-border bg-surface p-4">
      <%= form_with url: source_browse_path(source_slug: source_slug(@source)), method: :get, local: true, class: "flex flex-wrap items-end gap-3" do |form| %>
        <%= render UI::SelectComponent.new(
          form: form,
          method: :sort,
          options: @sort_options.map { |s| [ s.titleize, s ] },
          selected: @sort,
          label: "Sort by"
        ) %>
        <%= render UI::ButtonComponent.new(variant: :primary, type: "submit") do %>
          Apply
        <% end %>
      <% end %>
    </section>

    <section class="space-y-4">
      <h2 class="text-xl font-semibold text-balance">
        <%= @sort.titleize %> Series
      </h2>

      <% if @results.any? %>
        <% if @page == 1 %>
          <%# Page 1: grid + sentinel turbo frame below it %>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
            <% @results.each do |result| %>
              <%= render "browse_card", result: result %>
            <% end %>
          </div>

          <% if @results.size >= @page_size %>
            <% next_page_url = source_browse_path(source_slug: source_slug(@source), sort: @sort, page: @page + 1) %>
            <%= turbo_frame_tag "browse-page-#{@page + 1}",
                src: next_page_url,
                loading: :lazy do %>
              <div class="flex flex-col items-center gap-3 py-8">
                <%= render UI::SpinnerComponent.new(size: :md) %>
                <noscript>
                  <%= link_to "Load more", next_page_url, class: "text-sm text-muted hover:text-foreground" %>
                </noscript>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <%# Subsequent pages: own grid inside turbo frame, with next sentinel %>
          <%= turbo_frame_tag "browse-page-#{@page}" do %>
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
              <% @results.each do |result| %>
                <%= render "browse_card", result: result %>
              <% end %>
            </div>

            <% if @results.size >= @page_size %>
              <% next_page_url = source_browse_path(source_slug: source_slug(@source), sort: @sort, page: @page + 1) %>
              <%= turbo_frame_tag "browse-page-#{@page + 1}",
                  src: next_page_url,
                  loading: :lazy do %>
                <div class="flex flex-col items-center gap-3 py-8">
                  <%= render UI::SpinnerComponent.new(size: :md) %>
                  <noscript>
                    <%= link_to "Load more", next_page_url, class: "text-sm text-muted hover:text-foreground" %>
                  </noscript>
                </div>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <%= render UI::EmptyStateComponent.new(
          title: "No series found",
          description: "Try a different sort option or check back later.",
          compact: true
        ) do |empty| %>
          <% empty.with_icon do %>
            <%= icon "search", class: "h-6 w-6" %>
          <% end %>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>
