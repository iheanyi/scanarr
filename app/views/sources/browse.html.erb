<div class="space-y-6">
  <%= render UI::PageHeaderComponent.new(
    title: "Browse",
    description: "Discover new series from this source.",
    breadcrumb_text: @source.name || @source.key
  ) %>

  <% if @error.present? %>
    <%= render UI::FlashMessageComponent.new(variant: :danger, message: @error) %>
  <% else %>
    <%= turbo_frame_tag "browse-content", class: "has-loading-overlay" do %>
      <%= form_with url: source_browse_path(source_slug: source_slug(@source)),
                    method: :get,
                    data: { turbo_frame: "browse-content", turbo_action: "advance" },
                    class: "flex flex-wrap items-end gap-3" do |form| %>
        <%= form.hidden_field :page, value: 1 %>
        <div class="w-fit" data-controller="auto-submit">
          <%= render UI::SelectComponent.new(
            form: form,
            method: :sort,
            options: @sort_options.map { |s| [ s.titleize, s ] },
            selected: @sort,
            label: "Sort by",
            data: { action: "change->auto-submit#submit" }
          ) %>
        </div>
      <% end %>

      <section class="mt-6 space-y-4">
        <h2 class="text-xl font-semibold text-balance">
          <%= @sort.titleize %> Series
        </h2>

        <% if @results.any? %>
          <% if @page == 1 %>
            <%# Single grid — turbo-frames use display:contents so all items flow seamlessly %>
            <div class="browse-grid grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5">
              <% @results.each do |result| %>
                <%= render "browse_card", result: result %>
              <% end %>

              <% if @results.size >= @page_size %>
                <% next_page_url = source_browse_path(source_slug: source_slug(@source), sort: @sort, page: @page + 1) %>
                <%= turbo_frame_tag "browse-page-#{@page + 1}",
                    data: { controller: "lazy-frame", lazy_frame_url_value: next_page_url } do %>
                  <div class="col-span-full flex flex-col items-center gap-3 py-8" data-lazy-frame-target="sentinel">
                    <%= render UI::SpinnerComponent.new(size: :md) %>
                    <noscript>
                      <%= link_to "Load more", next_page_url, class: "text-sm text-muted hover:text-foreground" %>
                    </noscript>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <%# Subsequent pages: items + next sentinel, wrapped in turbo-frame for replacement %>
            <%= turbo_frame_tag "browse-page-#{@page}" do %>
              <% @results.each do |result| %>
                <%= render "browse_card", result: result %>
              <% end %>

              <% if @results.size >= @page_size %>
                <% next_page_url = source_browse_path(source_slug: source_slug(@source), sort: @sort, page: @page + 1) %>
                <%= turbo_frame_tag "browse-page-#{@page + 1}",
                    data: { controller: "lazy-frame", lazy_frame_url_value: next_page_url } do %>
                  <div class="col-span-full flex flex-col items-center gap-3 py-8" data-lazy-frame-target="sentinel">
                    <%= render UI::SpinnerComponent.new(size: :md) %>
                    <noscript>
                      <%= link_to "Load more", next_page_url, class: "text-sm text-muted hover:text-foreground" %>
                    </noscript>
                  </div>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% else %>
          <%= render UI::EmptyStateComponent.new(
            title: "No series found",
            description: "Try a different sort option or check back later.",
            compact: true
          ) do |empty| %>
            <% empty.with_icon do %>
              <%= icon "search", class: "h-6 w-6" %>
            <% end %>
          <% end %>
        <% end %>
      </section>
    <% end %>
  <% end %>
</div>
