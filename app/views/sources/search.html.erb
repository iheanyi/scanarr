<div class="space-y-6">
  <%= render UI::PageHeaderComponent.new(
    title: "Search",
    description: "Search the source and import a series into your library.",
    breadcrumb_text: @source.name || @source.key
  ) %>

  <% has_filter_options = @search_filter_options.values.any?(&:present?) %>
  <section class="rounded-lg border border-border bg-surface p-4">
    <%= form_with url: source_search_path(source_slug: source_slug(@source)),
                  method: :get,
                  data: { turbo_frame: "source-search-results", turbo_action: "advance" },
                  class: "space-y-4" do |form| %>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
        <div class="flex-1 space-y-1" data-controller="auto-submit" data-auto-submit-delay-value="250">
          <%= form.label :q, "Series title", class: "text-sm text-foreground" %>
          <%= form.text_field :q,
                              value: @query,
                              placeholder: "One Piece",
                              class: "w-full rounded-lg border border-border bg-surface-2 px-3 py-2 text-sm text-foreground placeholder:text-muted-2 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent",
                              data: { action: "input->auto-submit#submitDebounced" } %>
        </div>
        <%= render UI::ButtonComponent.new(variant: :primary, type: "submit") do %>
          Search
        <% end %>
      </div>

      <% advanced_filters_active = @selected_genres.present? || @selected_statuses.present? %>
      <details class="rounded-lg border border-border/70 bg-surface/40 p-3" <%= "open" if advanced_filters_active %>>
        <summary class="cursor-pointer select-none text-sm font-medium text-muted hover:text-foreground">
          Advanced filters
        </summary>
        <% if has_filter_options %>
          <div class="mt-3 grid gap-3 md:grid-cols-3">
            <% if @search_filter_options[:genres].present? %>
              <div data-controller="auto-submit" data-auto-submit-delay-value="150" data-action="change->auto-submit#submitDebounced">
                <%= render UI::MultiSelectComponent.new(
                  name: :genres,
                  options: @search_filter_options[:genres],
                  selected: @selected_genres,
                  label: "Genres",
                  filter_placeholder: "Filter genres",
                  all_label: "All genres",
                  max_chips: 2
                ) %>
              </div>
            <% end %>

            <% if @search_filter_options[:statuses].present? %>
              <div data-controller="auto-submit" data-auto-submit-delay-value="150" data-action="change->auto-submit#submitDebounced">
                <%= render UI::MultiSelectComponent.new(
                  name: :statuses,
                  options: @search_filter_options[:statuses],
                  selected: @selected_statuses,
                  label: "Status",
                  filter_placeholder: "Filter status",
                  all_label: "All statuses",
                  max_chips: 2
                ) %>
              </div>
            <% end %>

            <div class="flex items-end">
              <%= link_to "Clear advanced filters",
                          source_search_path(source_search_params(genres: nil, statuses: nil)),
                          class: "inline-flex h-9 items-center rounded-md border border-border px-3 text-sm text-muted hover:text-foreground hover:border-muted" %>
            </div>
          </div>
        <% else %>
          <p class="mt-3 text-xs text-muted-2">This source does not expose genre or status filters yet.</p>
        <% end %>
      </details>
    <% end %>
  </section>

  <%= turbo_frame_tag "source-search-results", class: "has-loading-overlay space-y-6" do %>
    <%= render UI::FlashMessageComponent.new(variant: :danger, message: @error) %>

    <% if @selected_genres.present? || @selected_statuses.present? %>
      <section class="flex flex-wrap items-center gap-2">
        <% @selected_genres.each do |genre| %>
          <%= link_to source_search_path(source_search_params(genres: (@selected_genres - [ genre ]).presence)),
                      class: "inline-flex items-center gap-1 rounded-full border border-border bg-surface-2 px-2.5 py-1 text-xs text-foreground hover:border-accent/40" do %>
            <span>Genre: <%= source_filter_label(:genres, genre) %></span>
            <span aria-hidden="true">&times;</span>
          <% end %>
        <% end %>

        <% @selected_statuses.each do |status| %>
          <%= link_to source_search_path(source_search_params(statuses: (@selected_statuses - [ status ]).presence)),
                      class: "inline-flex items-center gap-1 rounded-full border border-border bg-surface-2 px-2.5 py-1 text-xs text-foreground hover:border-accent/40" do %>
            <span>Status: <%= source_filter_label(:statuses, status) %></span>
            <span aria-hidden="true">&times;</span>
          <% end %>
        <% end %>

        <%= link_to "Clear all filters",
                    source_search_path(source_search_params(genres: nil, statuses: nil)),
                    class: "inline-flex items-center rounded-full border border-border px-2.5 py-1 text-xs text-muted hover:text-foreground hover:border-muted" %>
      </section>
    <% end %>

    <% if @query.present? %>
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-balance">Results (<%= @results.size %>)</h2>
        <% if @results.any? %>
          <ul class="space-y-3">
            <% @results.each do |result| %>
              <li class="rounded-lg border border-border/80 bg-surface/40 p-4 hover:border-accent/40 transition-colors">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                  <div class="flex items-center gap-4">
                    <%= render UI::SeriesCoverComponent.new(url: source_preview_image_proxy_path(result.cover_url), alt: "#{result.title} cover", size: :md) %>
                    <div class="space-y-1">
                      <p class="text-sm text-muted">Series</p>
                      <p class="text-lg font-semibold text-balance"><%= result.title %></p>
                    </div>
                  </div>
                  <%= button_to "Import series",
                                source_import_path(source_slug: source_slug(@source)),
                                method: :post,
                                params: { series_url: result.url },
                                class: "inline-flex items-center rounded-md border border-accent/40 px-4 py-2 text-sm font-semibold text-accent",
                                data: { turbo_submits_with: "Importing..." } %>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <%= render UI::EmptyStateComponent.new(
            title: "No results",
            description: "Try a different search term or adjust your filters.",
            compact: true
          ) do |empty| %>
            <% empty.with_icon do %>
              <%= icon "search", class: "h-6 w-6" %>
            <% end %>
            <% empty.with_action do %>
              <%= link_to "Clear search term",
                          source_search_path(source_search_params(q: nil)),
                          class: "text-sm text-info hover:text-info" %>
            <% end %>
          <% end %>
        <% end %>
      </section>
    <% end %>
  <% end %>
</div>
