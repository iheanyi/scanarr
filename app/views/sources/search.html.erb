<main class="space-y-6">
  <header class="space-y-2">
    <p class="text-sm text-muted"><%= @source.name || @source.key %></p>
    <h1 class="text-3xl font-semibold text-balance">Search</h1>
    <p class="text-muted text-pretty">Search the source and import a series into your library.</p>
  </header>

  <section class="rounded-lg border border-border bg-surface p-4">
    <%= form_with url: source_search_path(source_slug: source_slug(@source)), method: :get, local: true do |form| %>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
        <div class="flex-1 space-y-1">
          <%= form.label :q, "Series title", class: "text-sm text-foreground" %>
          <%= form.text_field :q,
                              value: @query,
                              placeholder: "One Piece",
                              class: "w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-2" %>
        </div>
        <%= form.submit "Search",
                        class: "inline-flex items-center justify-center rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-foreground" %>
      </div>
    <% end %>
  </section>

  <% if @query.present? %>
    <% if @error.present? %>
      <div class="rounded-lg border border-danger/30 bg-danger-soft px-4 py-3 text-sm text-danger">
        <%= @error %>
      </div>
    <% end %>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-balance">Results (<%= @results.size %>)</h2>
      <% if @results.any? %>
        <ul class="space-y-3">
          <% @results.each do |result| %>
            <li class="rounded-lg border border-border bg-surface p-4">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-center gap-4">
                  <div class="h-24 w-16 overflow-hidden rounded-md border border-border bg-background">
                    <% if result.cover_url.present? %>
                      <%= image_tag result.cover_url, alt: "#{result.title} cover", class: "h-full w-full object-cover" %>
                    <% else %>
                      <div class="flex h-full w-full items-center justify-center text-[10px] uppercase text-muted-2">
                        No cover
                      </div>
                    <% end %>
                  </div>
                  <div class="space-y-1">
                    <p class="text-sm text-muted">Series</p>
                    <p class="text-lg font-semibold text-balance"><%= result.title %></p>
                  </div>
                </div>
                <%= button_to "Import series",
                              source_import_path(source_slug: source_slug(@source)),
                              method: :post,
                              params: { series_url: result.url },
                              class: "inline-flex items-center rounded-md border border-accent/40 px-4 py-2 text-sm font-semibold text-accent" %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-muted text-pretty">No results.</p>
      <% end %>
    </section>
  <% end %>
</main>
