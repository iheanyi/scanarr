<div class="space-y-6">
  <%= render UI::PageHeaderComponent.new(
    title: "Search",
    description: "Search the source and import a series into your library.",
    breadcrumb_text: @source.name || @source.key
  ) %>

  <section class="rounded-lg border border-border bg-surface p-4">
    <%= form_with url: source_search_path(source_slug: source_slug(@source)), method: :get, local: true do |form| %>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
        <div class="flex-1 space-y-1">
          <%= form.label :q, "Series title", class: "text-sm text-foreground" %>
          <%= form.text_field :q,
                              value: @query,
                              placeholder: "One Piece",
                              class: "w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-2" %>
        </div>
        <%= render UI::ButtonComponent.new(variant: :primary, type: "submit") do %>
          Search
        <% end %>
      </div>
    <% end %>
  </section>

  <% if @query.present? %>
    <%= render UI::FlashMessageComponent.new(variant: :danger, message: @error) %>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-balance">Results (<%= @results.size %>)</h2>
      <% if @results.any? %>
        <ul class="space-y-3">
          <% @results.each do |result| %>
            <li class="rounded-lg border border-border bg-surface p-4">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-center gap-4">
                  <%= render UI::SeriesCoverComponent.new(url: result.cover_url, alt: "#{result.title} cover", size: :md) %>
                  <div class="space-y-1">
                    <p class="text-sm text-muted">Series</p>
                    <p class="text-lg font-semibold text-balance"><%= result.title %></p>
                  </div>
                </div>
                <%= button_to "Import series",
                              source_import_path(source_slug: source_slug(@source)),
                              method: :post,
                              params: { series_url: result.url },
                              class: "inline-flex items-center rounded-md border border-accent/40 px-4 py-2 text-sm font-semibold text-accent",
                              data: { turbo_submits_with: "Importing..." } %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render UI::EmptyStateComponent.new(
          title: "No results",
          description: "Try a different search term.",
          compact: true
        ) do |empty| %>
          <% empty.with_icon do %>
            <%= icon "search", class: "h-6 w-6" %>
          <% end %>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>
