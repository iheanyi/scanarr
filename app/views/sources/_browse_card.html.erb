<div class="group relative overflow-hidden rounded-lg border border-border/80 bg-surface hover:border-accent/40 transition-colors focus-within:ring-2 focus-within:ring-accent focus-within:ring-offset-2 focus-within:ring-offset-background" data-browse-item>
  <%= render UI::SeriesCoverComponent.new(
    url: result.cover_url,
    alt: "#{result.title} cover",
    size: :full,
    aspect: "2/3",
    rounded: :none,
    image_class: "transition-transform group-hover:scale-105",
    class: "border-0"
  ) %>
  <div class="p-2">
    <p class="text-sm font-medium text-foreground line-clamp-2" title="<%= result.title %>">
      <%= result.title %>
    </p>
    <% if result.respond_to?(:author) && result.author.present? %>
      <p class="mt-0.5 text-xs text-muted-2 truncate"><%= result.author %></p>
    <% end %>
    <% if result.respond_to?(:status) && result.status.present? %>
      <%= render UI::StatusBadgeComponent.new(status: result.status, class: "mt-1") %>
    <% end %>
  </div>

  <%# Overlay — visible on hover AND focus-within for keyboard/mobile accessibility %>
  <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-background via-background/80 to-transparent opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
    <div class="max-h-[60%] overflow-hidden p-3 space-y-2">
      <% if result.respond_to?(:description) && result.description.present? %>
        <p class="text-xs text-foreground line-clamp-4 leading-relaxed">
          <%= truncate(result.description, length: 200) %>
        </p>
      <% end %>
      <div class="flex gap-2">
        <%= link_to source_preview_path(source_slug: source_slug(@source), series_url: result.url),
                    class: "flex-1 rounded-md border border-border px-2 py-1.5 text-center text-xs font-medium text-foreground hover:bg-surface-2 focus:outline-none focus:ring-2 focus:ring-accent" do %>
          Details
        <% end %>
        <%= button_to "Import",
                      source_import_path(source_slug: source_slug(@source)),
                      method: :post,
                      params: { series_url: result.url },
                      class: "flex-1 rounded-md bg-accent px-2 py-1.5 text-xs font-semibold text-accent-foreground hover:bg-accent-strong focus:outline-none focus:ring-2 focus:ring-accent-strong",
                      data: { turbo_submits_with: "Importing..." } %>
      </div>
    </div>
  </div>
</div>
