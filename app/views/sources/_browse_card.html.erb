<div class="group flex min-w-0 flex-col" data-browse-item>
  <div class="relative">
    <%= link_to source_preview_path(source_slug: source_slug(@source), series_url: result.url),
                class: "block focus:outline-none",
                data: { turbo_frame: "_top" } do %>
      <div class="relative overflow-hidden rounded-lg border border-border/80 bg-surface-2 transition-colors group-hover:border-accent/40 group-focus-within:ring-2 group-focus-within:ring-accent group-focus-within:ring-offset-2 group-focus-within:ring-offset-background">
        <%= render UI::SeriesCoverComponent.new(
          url: result.cover_url,
          alt: "#{result.title} cover",
          size: :full,
          aspect: "2/3",
          rounded: :lg,
          image_class: "transition duration-300 group-hover:scale-105",
          class: "border-0"
        ) do |cover| %>
          <% cover.with_fallback do %>
            <div class="flex h-full w-full items-center justify-center bg-surface-2/70">
              <%= icon "book-open", class: "h-12 w-12 text-muted-2", stroke_width: "1.5" %>
            </div>
          <% end %>
          <% cover.with_overlay do %>
            <% if result.respond_to?(:description) && result.description.present? %>
              <div class="pointer-events-none absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/80 via-black/40 to-transparent p-3 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100">
                <p class="text-xs leading-snug text-white/70 line-clamp-4">
                  <%= truncate(result.description, length: 220) %>
                </p>
              </div>
            <% end %>
          <% end %>
        <% end %>

      </div>
    <% end %>

    <div class="pointer-events-none visible absolute right-2 top-2 z-20 opacity-100 transition-opacity duration-200 sm:invisible sm:opacity-0 sm:group-hover:visible sm:group-hover:opacity-100 sm:group-focus-within:visible sm:group-focus-within:opacity-100">
      <%= button_to "Import",
                    source_import_path(source_slug: source_slug(@source)),
                    method: :post,
                    params: { series_url: result.url },
                    class: "pointer-events-auto inline-flex items-center justify-center rounded-md bg-accent px-2 py-1 text-[11px] font-semibold text-accent-foreground shadow-sm hover:bg-accent-strong focus:outline-none focus:ring-2 focus:ring-accent-strong",
                    form: { class: "pointer-events-auto", data: { turbo_frame: "_top" } },
                    data: { turbo_submits_with: "Importing..." } %>
    </div>

    <% if result.respond_to?(:status) && result.status.present? %>
      <div class="pointer-events-none visible absolute left-2 top-2 z-20 opacity-100 transition-opacity duration-200 sm:invisible sm:opacity-0 sm:group-hover:visible sm:group-hover:opacity-100 sm:group-focus-within:visible sm:group-focus-within:opacity-100">
        <%= render UI::StatusBadgeComponent.new(
          status: result.status,
          bordered: true,
          class: "bg-surface text-foreground border-border shadow-sm"
        ) %>
      </div>
    <% end %>
  </div>

  <div class="mt-2 min-w-0 space-y-0.5">
    <h3 class="truncate text-sm font-medium text-foreground transition-colors group-hover:text-accent" title="<%= result.title %>">
      <%= link_to result.title,
                  source_preview_path(source_slug: source_slug(@source), series_url: result.url),
                  data: { turbo_frame: "_top" },
                  class: "focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-background rounded-sm" %>
    </h3>
    <% if result.respond_to?(:author) && result.author.present? %>
      <p class="truncate text-xs text-muted-2"><%= result.author %></p>
    <% end %>
  </div>
</div>
