<div class="space-y-6">
  <%= render UI::PageHeaderComponent.new(
    title: "Sources",
    description: "Pick a source to browse or search for series.",
    breadcrumb_text: "Start here"
  ) %>

  <% if @sources.any? %>
    <section class="grid gap-4 sm:grid-cols-2">
      <% @sources.each do |source| %>
        <div class="rounded-lg border border-border bg-surface p-4">
          <div class="flex items-start justify-between gap-4">
            <div class="space-y-1">
              <h2 class="text-lg font-semibold text-balance"><%= source.name || source.key %></h2>
              <p class="text-sm text-muted text-pretty"><%= source.base_url %></p>
            </div>
            <div class="flex flex-col items-end gap-2">
              <%= render UI::ButtonComponent.new(
                variant: :primary,
                size: :sm,
                href: source_browse_path(source_slug: source.slug)
              ) do %>
                Discover
              <% end %>
              <div class="flex items-center gap-2">
                <%= render UI::ButtonComponent.new(
                  variant: :secondary,
                  size: :sm,
                  href: source_series_index_path(source_slug: source.slug)
                ) do %>
                  View Series
                <% end %>
                <%= render UI::ButtonComponent.new(
                  variant: :ghost,
                  size: :sm,
                  href: source_search_path(source_slug: source.slug)
                ) do %>
                  Search
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </section>
  <% else %>
    <%= render UI::EmptyStateComponent.new(
      title: "No sources configured yet",
      description: "Sources are automatically registered when the application starts."
    ) do |empty| %>
      <% empty.with_icon do %>
        <%= icon "globe", class: "h-6 w-6" %>
      <% end %>
    <% end %>
  <% end %>
</div>
