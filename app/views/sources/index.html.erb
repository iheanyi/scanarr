<main class="space-y-6">
  <header class="space-y-2">
    <p class="text-sm text-zinc-400">Start here</p>
    <h1 class="text-3xl font-semibold text-balance">Sources</h1>
    <p class="text-zinc-400 text-pretty">Pick a source to browse or search for series.</p>
  </header>

  <section class="grid gap-4 sm:grid-cols-2">
    <% @sources.each do |source| %>
      <div class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4">
        <div class="flex items-start justify-between gap-4">
          <div class="space-y-1">
            <p class="text-xs text-zinc-500">Key: <span class="font-medium text-zinc-400"><%= source.key %></span></p>
            <h2 class="text-lg font-semibold text-balance"><%= source.name || source.key %></h2>
            <p class="text-sm text-zinc-400 text-pretty"><%= source.base_url %></p>
          </div>
          <div class="flex flex-col items-end gap-2">
            <%= link_to "Browse",
                        source_series_index_path(source_slug: source.key.to_s.tr("_", "-")),
                        class: "inline-flex items-center rounded-md bg-emerald-500 px-3 py-1.5 text-sm font-semibold text-zinc-950" %>
            <%= link_to "Search",
                        source_search_path(source_slug: source.key.to_s.tr("_", "-")),
                        class: "inline-flex items-center rounded-md border border-emerald-500/40 px-3 py-1.5 text-sm font-semibold text-emerald-300" %>
          </div>
        </div>
      </div>
    <% end %>
  </section>
</main>
