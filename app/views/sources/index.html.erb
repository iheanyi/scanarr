<div class="space-y-6">
  <%= render UI::PageHeaderComponent.new(
    title: "Sources",
    description: "Pick a source to browse or search for series.",
    breadcrumb_text: "Start here"
  ) %>

  <% if @sources.any? %>
    <section class="grid gap-4 sm:grid-cols-2">
      <% @sources.each do |source| %>
        <div class="rounded-lg border border-border bg-surface p-4">
          <div class="flex items-start justify-between gap-4">
            <div class="space-y-1">
              <h2 class="text-lg font-semibold text-balance"><%= source.name || source.key %></h2>
              <p class="text-sm text-muted text-pretty"><%= source.base_url %></p>
            </div>
            <div class="flex flex-col items-end gap-2">
              <%= link_to "Discover",
                          source_browse_path(source_slug: source.slug),
                          class: "inline-flex items-center rounded-md bg-accent px-3 py-1.5 text-sm font-semibold text-accent-foreground" %>
              <div class="flex items-center gap-2">
                <%= link_to "View Series",
                            source_series_index_path(source_slug: source.slug),
                            class: "inline-flex items-center rounded-md border border-border-soft bg-surface-2 px-3 py-1.5 text-sm font-medium text-foreground hover:bg-surface hover:border-border" %>
                <%= link_to "Search",
                            source_search_path(source_slug: source.slug),
                            class: "inline-flex items-center rounded-md border border-accent/50 bg-accent-ghost px-3 py-1.5 text-sm font-semibold text-accent hover:bg-accent-soft" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </section>
  <% else %>
    <div class="rounded-lg border border-dashed border-border bg-surface p-6 text-center">
      <p class="text-muted text-pretty">No sources configured yet.</p>
      <p class="mt-1 text-xs text-muted-2 text-pretty">Sources are automatically registered when the application starts.</p>
    </div>
  <% end %>
</div>
