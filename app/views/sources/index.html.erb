<div class="space-y-6">
  <%= render UI::PageHeaderComponent.new(
    title: "Sources",
    description: "Pick a source to browse or search for series."
  ) %>

  <%= turbo_frame_tag "sources-content", class: "has-loading-overlay" do %>
    <div class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2 text-sm text-muted-2">
        <p><%= @sources.length %> sources</p>
        <% if @hidden_mature_count.positive? %>
          <span aria-hidden="true">·</span>
          <p><%= @hidden_mature_count %> 18+ hidden</p>
        <% end %>
      </div>
      <div class="flex items-center gap-2">
        <%= render UI::ButtonComponent.new(
          variant: @include_mature ? :secondary : :ghost,
          size: :sm,
          href: sources_path(sort_by: @sort_by, include_mature: (@include_mature ? nil : "1")),
          data: { turbo_frame: "sources-content" }
        ) do %>
          <%= icon(@include_mature ? "eye-off" : "eye", class: "h-3.5 w-3.5") %>
          <%= @include_mature ? "Hide 18+" : "Show 18+" %>
        <% end %>
        <%= render UI::DropdownComponent.new(
          label: @sort_options[@sort_by],
          turbo_frame: "sources-content",
          items: @sort_options.map { |key, label|
            {
              label: label,
              href: sources_path(sort_by: key, include_mature: (@include_mature ? "1" : nil)),
              selected: @sort_by == key
            }
          }
        ) %>
      </div>
    </div>

    <% if @sources.any? %>
      <section class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(min(100%,280px),1fr))]">
        <% @sources.each do |source| %>
          <% capabilities = @source_capabilities.fetch(source) %>
          <% library_count = @source_library_counts.fetch(source.id, 0) %>
          <article class="group min-w-0 rounded-lg border border-border/80 bg-surface/40 p-5 hover:border-accent/40 transition-colors" aria-label="<%= source.display_name %>">
            <div class="space-y-4">
              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <%= icon "globe", class: "h-4 w-4 text-accent" %>
                  <h2 class="text-lg font-semibold text-balance"><%= source.display_name %></h2>
                  <% if source.mature_content? %>
                    <%= render UI::BadgeComponent.new(label: "18+", variant: :warning, class: "px-2 py-0.5 text-[10px]") %>
                  <% end %>
                </div>
                <p class="text-sm text-muted-2 truncate"><%= source.effective_base_url %></p>
              </div>
              <% if source.dead? %>
                <%= render UI::BadgeComponent.new(label: "No longer available", variant: :warning) %>
                <p class="text-sm text-muted">Downloaded chapters remain in your library. Try another source for new chapters.</p>
              <% elsif source.broken? %>
                <%= render UI::BadgeComponent.new(label: "Currently unavailable", variant: :warning) %>
                <p class="text-sm text-muted">This source has been failing. Try another source or check back later; downloaded chapters remain in your library.</p>
              <% elsif source.degraded? %>
                <%= render UI::BadgeComponent.new(label: "Some requests failing", variant: :warning) %>
                <p class="text-sm text-muted">Results may be incomplete. You can retry or try another source.</p>
              <% end %>
              <% unless capabilities[:browse] || capabilities[:search] %>
                <p class="text-sm text-muted">Browsing and search are not supported for this source yet. Choose another source to discover new series.</p>
              <% end %>
              <div class="flex flex-wrap items-center gap-2">
                <% if capabilities[:browse] %>
                <%= render UI::ButtonComponent.new(
                  variant: :primary,
                  size: :sm,
                  href: source_browse_path(source_slug: source.slug),
                  data: { turbo_frame: "_top" }
                ) do %>
                  <%= icon "compass", class: "h-3.5 w-3.5" %>
                  Browse
                <% end %>
                <% end %>
                <% if library_count.positive? %>
                <%= render UI::ButtonComponent.new(
                  variant: :secondary,
                  size: :sm,
                  href: source_series_index_path(source_slug: source.slug),
                  data: { turbo_frame: "_top" }
                ) do %>
                  In library (<%= library_count %>)
                <% end %>
                <% end %>
                <% if capabilities[:search] %>
                <%= render UI::ButtonComponent.new(
                  variant: capabilities[:browse] ? :ghost : :primary,
                  size: :sm,
                  href: source_search_path(source_slug: source.slug),
                  data: { turbo_frame: "_top" }
                ) do %>
                  <%= icon "search", class: "h-3.5 w-3.5" %>
                  Search
                <% end %>
                <% end %>
              </div>
            </div>
          </article>
        <% end %>
      </section>
    <% else %>
      <%= render UI::EmptyStateComponent.new(
        title: "No sources configured yet",
        description: "Sources are automatically registered when the application starts."
      ) do |empty| %>
        <% empty.with_icon do %>
          <%= icon "globe", class: "h-6 w-6" %>
        <% end %>
      <% end %>
    <% end %>
    </div>
  <% end %>
</div>
