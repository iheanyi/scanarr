<% page_count = @pages.any? ? @pages.length : @source_pages.length %>
<% initial_page_index = @initial_page_index || @chapter_progress&.page_index || (page_count.positive? ? 1 : 0) %>
<% if page_count.positive? %>
  <% initial_page_index = [[initial_page_index, page_count].min, 1].max %>
<% else %>
  <% initial_page_index = 0 %>
<% end %>
<% progress_percent = page_count.positive? ? ((initial_page_index.to_f / page_count) * 100.0) : 0 %>
<% is_horizontal = @reading_style == 'left_to_right' || @reading_style == 'right_to_left' %>
<% is_rtl = @reading_style == 'right_to_left' %>
<% is_long_strip = @reading_style == 'long_strip' %>
<% next_chapter_url = @next_chapter ? source_series_chapter_path(source_slug: source_slug(@source), series_slug: @series.to_param, chapter_identifier: chapter_identifier(@next_chapter)) : nil %>
<% next_chapter_title = @next_chapter ? "Chapter #{@next_chapter.chapter_number}" : nil %>
<main data-controller="reader"
      data-reader-style-value="<%= @reading_style %>"
      data-reader-page-count-value="<%= page_count %>"
      data-reader-initial-page-index-value="<%= initial_page_index %>"
      data-reader-progress-url-value="<%= current_user ? source_series_chapter_progress_path(source_slug: source_slug(@source), series_slug: @series.to_param, chapter_identifier: chapter_identifier(@chapter)) : '' %>"
      <% if next_chapter_url %>
      data-reader-next-chapter-url-value="<%= next_chapter_url %>"
      data-reader-next-chapter-title-value="<%= next_chapter_title %>"
      <% end %>
      class="space-y-6">
  <%# Breadcrumbs %>
  <nav class="flex items-center gap-2 text-sm text-zinc-400" aria-label="Breadcrumb">
    <%= link_to @source.name, source_series_index_path(source_slug: source_slug(@source)), class: "hover:text-zinc-200" %>
    <span class="text-zinc-600">/</span>
    <%= link_to @series.canonical_title, source_series_path(source_slug: source_slug(@source), series_slug: @series.to_param), class: "hover:text-zinc-200 truncate max-w-xs" %>
    <span class="text-zinc-600">/</span>
    <span class="text-zinc-300">Ch. <%= @chapter.chapter_number %></span>
  </nav>

  <header class="space-y-3">
    <div>
      <h1 class="text-2xl font-semibold text-balance"><%= @series.canonical_title %></h1>
      <% if @series.author_name.present? || @series.artist_name.present? %>
        <p class="text-sm text-zinc-400">
          <% if @series.author_name.present? && @series.artist_name.present? && @series.author_name != @series.artist_name %>
            by <%= @series.author_name %> · Art by <%= @series.artist_name %>
          <% elsif @series.author_name.present? %>
            by <%= @series.author_name %>
          <% elsif @series.artist_name.present? %>
            by <%= @series.artist_name %>
          <% end %>
        </p>
      <% end %>
    </div>
    <div class="border-t border-zinc-800/50 pt-3">
      <h2 class="text-xl font-medium text-zinc-100">Chapter <%= @chapter.chapter_number %></h2>
      <% if @chapter.meaningful_title? %>
        <p class="text-zinc-400 text-pretty"><%= @chapter.title %></p>
      <% end %>
    </div>
  </header>

  <% if page_count.positive? %>
    <div class="sticky top-4 z-2 rounded-lg border border-zinc-800/80 bg-zinc-950/90 p-3 backdrop-blur">
      <div class="flex items-center justify-between text-xs text-zinc-300">
        <span data-reader-target="progressText">Page <%= initial_page_index %> / <%= page_count %></span>
        <span data-reader-target="progressPercent"><%= progress_percent.round %>%</span>
      </div>
      <div class="mt-2 h-1 w-full rounded-full bg-zinc-800">
        <div data-reader-target="progressBar"
             class="h-1 rounded-full bg-emerald-500 transition-[width] duration-200"
             style="width: <%= progress_percent %>%"></div>
      </div>
    </div>
  <% end %>

  <nav class="flex flex-wrap items-center gap-2">
    <% if is_horizontal %>
      <button type="button"
              class="inline-flex items-center rounded-md border border-zinc-700/70 px-3 py-1.5 text-sm font-semibold text-zinc-200"
              data-action="click->reader#toggleLightbox">
        Lightbox
      </button>
    <% end %>
    <% if @previous_chapter %>
      <%= link_to "Previous Chapter",
                  source_series_chapter_path(
                    source_slug: source_slug(@source),
                    series_slug: @series.to_param,
                    chapter_identifier: chapter_identifier(@previous_chapter)
                  ),
                  class: "inline-flex items-center rounded-md border border-zinc-800 px-3 py-1.5 text-sm font-semibold text-zinc-200" %>
    <% end %>
    <% if @next_chapter %>
      <%= link_to "Next Chapter",
                  source_series_chapter_path(
                    source_slug: source_slug(@source),
                    series_slug: @series.to_param,
                    chapter_identifier: chapter_identifier(@next_chapter)
                  ),
                  class: "inline-flex items-center rounded-md border border-zinc-800 px-3 py-1.5 text-sm font-semibold text-zinc-200" %>
    <% end %>
    <% if @chapter.source_url.present? || @release&.source_url.present? %>
      <% download_label = if @download_in_progress
                            @file_asset&.download_status == "downloading" ? "Downloading..." : "Download queued"
                          else
                            "Download this chapter"
                          end %>
      <% download_class = if @download_in_progress
                            "inline-flex items-center rounded-md bg-zinc-700 px-3 py-1.5 text-sm font-semibold text-zinc-200 cursor-not-allowed"
                          else
                            "inline-flex items-center rounded-md bg-emerald-500 px-3 py-1.5 text-sm font-semibold text-zinc-950"
                          end %>
      <%= button_to download_label,
                    source_series_chapter_download_path(
                      source_slug: source_slug(@source),
                      series_slug: @series.to_param,
                      chapter_identifier: chapter_identifier(@chapter)
                    ),
                    method: :post,
                    class: download_class,
                    disabled: @download_in_progress,
                    aria: { disabled: @download_in_progress } %>
    <% end %>
    <%= form_with url: source_series_chapter_path(
                    source_slug: source_slug(@source),
                    series_slug: @series.to_param,
                    chapter_identifier: chapter_identifier(@chapter)
                  ),
                  method: :get,
                  local: true,
                  id: "reading-style-form" do |form| %>
      <%= form.select :reading_style,
                      options_for_select(
                        [
                          [ "Left to Right", "left_to_right" ],
                          [ "Right to Left", "right_to_left" ],
                          [ "Long Strip", "long_strip" ],
                          [ "Webcomic", "webcomic" ]
                        ],
                        @reading_style
                      ),
                      {},
                      class: "rounded-md border border-zinc-800 bg-zinc-950 px-2 py-1 text-xs text-zinc-100",
                      onchange: "this.form.submit()" %>
    <% end %>
  </nav>

  <% viewport_class = if is_horizontal
                        base = 'flex overflow-x-auto snap-x snap-mandatory w-full'
                        is_rtl ? "#{base} flex-row-reverse" : base
                      elsif is_long_strip
                        # Long strip: seamless vertical scroll for webtoons - no gaps
                        'flex flex-col items-center'
                      else
                        # Webcomic: vertical scroll with small gaps between pages
                        'flex flex-col items-center gap-4'
                      end %>
  <% page_class = if is_horizontal
                    'snap-start shrink-0 w-[70vw] max-w-2xl flex items-center justify-center p-4 cursor-pointer'
                  elsif is_long_strip
                    # Long strip: full width, no extra styling - panels flow together
                    'w-full max-w-3xl cursor-pointer'
                  else
                    # Webcomic: constrained pages
                    'w-full max-w-2xl cursor-pointer'
                  end %>
  <% image_class = if is_long_strip
                     # Long strip: no height limit, images flow naturally
                     'w-full max-w-full object-contain pointer-events-none'
                   else
                     # Other modes: constrain height for page-based viewing
                     'max-h-[75vh] w-auto max-w-full object-contain rounded-md pointer-events-none'
                   end %>

  <section data-reader-target="viewport"
           class="<%= viewport_class %>"
           data-reader-rtl="<%= is_rtl %>">
    <% if @file_asset&.download_status.present? %>
      <div class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4 text-sm text-zinc-300 <%= is_horizontal ? 'shrink-0 w-screen flex items-center justify-center' : '' %>">
        <% if @file_asset.download_status == "downloading" && @file_asset.pages_expected.present? %>
          Downloading pages (<%= @file_asset.pages_downloaded %>/<%= @file_asset.pages_expected %>)
        <% elsif @file_asset.download_status == "failed" %>
          Download failed. <%= @file_asset.download_error %>
        <% elsif @file_asset.download_status == "complete" %>
          Download complete.
        <% else %>
          Download queued.
        <% end %>
      </div>
    <% end %>
    <% if @source_error.present? %>
      <div class="rounded-lg border border-rose-500/30 bg-rose-500/10 p-6 space-y-3 <%= is_horizontal ? 'shrink-0 w-screen flex flex-col items-center justify-center' : '' %>">
        <div class="flex items-center gap-2 text-rose-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
          </svg>
          <span class="font-medium">Unable to load chapter</span>
        </div>
        <p class="text-sm text-rose-200/80 text-pretty"><%= @source_error %></p>
        <div class="flex gap-2">
          <%= link_to "Back to series",
                      source_series_path(source_slug: source_slug(@source), series_slug: @series.to_param),
                      class: "inline-flex items-center rounded-md border border-rose-500/30 px-3 py-1.5 text-sm font-medium text-rose-300 hover:bg-rose-500/10" %>
          <%= link_to "Try again",
                      source_series_chapter_path(source_slug: source_slug(@source), series_slug: @series.to_param, chapter_identifier: chapter_identifier(@chapter)),
                      class: "inline-flex items-center rounded-md bg-rose-500/20 px-3 py-1.5 text-sm font-medium text-rose-200 hover:bg-rose-500/30" %>
        </div>
      </div>
    <% elsif @pages.empty? && @source_pages.empty? %>
      <div class="rounded-lg border border-dashed border-zinc-800/80 bg-zinc-900/40 p-6 space-y-2 <%= is_horizontal ? 'shrink-0 w-screen flex flex-col items-center justify-center' : '' %>">
        <p class="text-zinc-400 text-pretty">Streaming from source while download completes.</p>
        <p class="text-xs text-zinc-500">This does not store pages locally yet.</p>
      </div>
    <% end %>
    <% @pages.each do |page| %>
      <article data-reader-target="page"
               data-action="click->reader#openLightboxForPage"
               class="<%= page_class %>">
        <% if page.image.attached? %>
          <%= image_tag url_for(page.image), alt: "Page #{page.position}", class: image_class %>
        <% else %>
          <p class="text-sm text-zinc-400 text-pretty">Image unavailable.</p>
        <% end %>
      </article>
    <% end %>
    <% @source_pages.each do |page| %>
      <article data-reader-target="page"
               data-action="click->reader#openLightboxForPage"
               class="<%= page_class %>">
        <%= image_tag page.url, alt: "Source page #{page.index}", class: image_class %>
      </article>
    <% end %>
  </section>

  <%# Lightbox overlay - must be inside controller scope %>
  <div data-reader-target="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-6">
    <button type="button"
            class="absolute right-6 top-6 rounded-full border border-zinc-700/70 bg-zinc-900/80 px-3 py-2 text-sm font-semibold text-zinc-200 hover:bg-zinc-800"
            data-action="click->reader#closeLightbox">
      Close
    </button>
    <button type="button"
            class="absolute left-6 top-1/2 -translate-y-1/2 rounded-full border border-zinc-700/70 bg-zinc-900/80 px-4 py-3 text-xl text-zinc-200 hover:bg-zinc-800"
            data-action="click->reader#lightboxPrev"
            aria-label="Previous page">
      &larr;
    </button>
    <button type="button"
            class="absolute right-6 top-1/2 -translate-y-1/2 rounded-full border border-zinc-700/70 bg-zinc-900/80 px-4 py-3 text-xl text-zinc-200 hover:bg-zinc-800"
            data-action="click->reader#lightboxNext"
            aria-label="Next page">
      &rarr;
    </button>
    <img data-reader-target="lightboxImage"
         class="max-h-[90vh] w-auto max-w-[90vw] rounded-lg object-contain shadow-2xl"
         alt="Reader page" />
  </div>

  <%# Next Chapter overlay - shows when reaching end of chapter %>
  <% if @next_chapter %>
    <div data-reader-target="nextChapterOverlay"
         class="fixed inset-0 z-40 hidden items-center justify-center bg-gradient-to-t from-zinc-950 via-zinc-950/95 to-zinc-950/80 p-6">
      <div class="max-w-md w-full space-y-6 text-center">
        <div class="space-y-2">
          <p class="text-sm text-zinc-500 uppercase tracking-wider">End of Chapter</p>
          <h2 class="text-2xl font-semibold text-zinc-100">Continue Reading?</h2>
        </div>

        <div class="rounded-lg border border-zinc-800/80 bg-zinc-900/60 p-4 space-y-2">
          <p class="text-sm text-zinc-500">Up next</p>
          <p class="text-lg font-medium text-zinc-200">
            Chapter <%= @next_chapter.chapter_number %>
            <% if @next_chapter.meaningful_title? %>
              <span class="block text-sm text-zinc-400 mt-1"><%= @next_chapter.title %></span>
            <% end %>
          </p>
        </div>

        <div class="space-y-3">
          <button type="button"
                  data-action="click->reader#goToNextChapter"
                  class="w-full rounded-lg bg-emerald-500 px-6 py-3 text-sm font-semibold text-zinc-950 hover:bg-emerald-400 transition-colors">
            <span>Continue to Next Chapter</span>
            <span class="ml-2 inline-flex items-center justify-center rounded-full bg-emerald-600/50 px-2 py-0.5 text-xs">
              <span data-reader-target="nextChapterCountdown">5</span>s
            </span>
          </button>

          <button type="button"
                  data-action="click->reader#cancelNextChapter"
                  class="w-full rounded-lg border border-zinc-700 px-6 py-2.5 text-sm font-medium text-zinc-300 hover:bg-zinc-800 transition-colors">
            Stay on this chapter
          </button>

          <%= link_to source_series_path(source_slug: source_slug(@source), series_slug: @series.to_param),
                      class: "inline-block text-sm text-zinc-500 hover:text-zinc-300 transition-colors" do %>
            Back to series
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</main>
