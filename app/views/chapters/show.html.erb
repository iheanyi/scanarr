<% page_count = @pages.any? ? @pages.length : @source_pages.length %>
<% initial_page_index = @initial_page_index || @chapter_progress&.page_index || (page_count.positive? ? 1 : 0) %>
<% if page_count.positive? %>
  <% initial_page_index = [[initial_page_index, page_count].min, 1].max %>
<% else %>
  <% initial_page_index = 0 %>
<% end %>
<% progress_percent = page_count.positive? ? ((initial_page_index.to_f / page_count) * 100.0) : 0 %>
<main data-controller="reader"
      data-reader-style-value="<%= @reading_style %>"
      data-reader-page-count-value="<%= page_count %>"
      data-reader-initial-page-index-value="<%= initial_page_index %>"
      data-reader-progress-url-value="<%= current_user ? source_series_chapter_progress_path(source_slug: source_slug(@source), series_slug: @series.friendly_id, chapter_identifier: chapter_identifier(@chapter)) : '' %>"
      class="space-y-6">
  <header class="space-y-2">
    <p class="text-sm text-zinc-400"><%= @series.canonical_title %></p>
    <h1 class="text-3xl font-semibold text-balance">Chapter <%= @chapter.chapter_number %></h1>
    <p class="text-zinc-400 text-pretty"><%= @chapter.title %></p>
  </header>

  <% if page_count.positive? %>
    <div class="sticky top-4 z-2 rounded-lg border border-zinc-800/80 bg-zinc-950/90 p-3 backdrop-blur">
      <div class="flex items-center justify-between text-xs text-zinc-300">
        <span data-reader-target="progressText">Page <%= initial_page_index %> / <%= page_count %></span>
        <span data-reader-target="progressPercent"><%= progress_percent.round %>%</span>
      </div>
      <div class="mt-2 h-1 w-full rounded-full bg-zinc-800">
        <div data-reader-target="progressBar"
             class="h-1 rounded-full bg-emerald-500 transition-[width] duration-200"
             style="width: <%= progress_percent %>%"></div>
      </div>
    </div>
  <% end %>

  <nav class="flex flex-wrap items-center gap-2">
    <button type="button"
            class="inline-flex items-center rounded-md border border-zinc-700/70 px-3 py-1.5 text-sm font-semibold text-zinc-200"
            data-action="click->reader#toggleLightbox">
      Lightbox
    </button>
    <% if @previous_chapter %>
      <%= link_to "Previous Chapter",
                  source_series_chapter_path(
                    source_slug: source_slug(@source),
                    series_slug: @series.friendly_id,
                    chapter_identifier: chapter_identifier(@previous_chapter)
                  ),
                  class: "inline-flex items-center rounded-md border border-zinc-800 px-3 py-1.5 text-sm font-semibold text-zinc-200" %>
    <% end %>
    <% if @next_chapter %>
      <%= link_to "Next Chapter",
                  source_series_chapter_path(
                    source_slug: source_slug(@source),
                    series_slug: @series.friendly_id,
                    chapter_identifier: chapter_identifier(@next_chapter)
                  ),
                  class: "inline-flex items-center rounded-md border border-zinc-800 px-3 py-1.5 text-sm font-semibold text-zinc-200" %>
    <% end %>
    <% if @chapter.source_url.present? || @release&.source_url.present? %>
      <% download_label = if @download_in_progress
                            @file_asset&.download_status == "downloading" ? "Downloading..." : "Download queued"
                          else
                            "Download this chapter"
                          end %>
      <% download_class = if @download_in_progress
                            "inline-flex items-center rounded-md bg-zinc-700 px-3 py-1.5 text-sm font-semibold text-zinc-200 cursor-not-allowed"
                          else
                            "inline-flex items-center rounded-md bg-emerald-500 px-3 py-1.5 text-sm font-semibold text-zinc-950"
                          end %>
      <%= button_to download_label,
                    source_series_chapter_download_path(
                      source_slug: source_slug(@source),
                      series_slug: @series.friendly_id,
                      chapter_identifier: chapter_identifier(@chapter)
                    ),
                    method: :post,
                    class: download_class,
                    disabled: @download_in_progress,
                    aria: { disabled: @download_in_progress } %>
    <% end %>
    <%= form_with url: source_series_chapter_path(
                    source_slug: source_slug(@source),
                    series_slug: @series.friendly_id,
                    chapter_identifier: chapter_identifier(@chapter)
                  ),
                  method: :get,
                  local: true do |form| %>
      <%= form.select :reading_style,
                      options_for_select(
                        [
                          [ "Left to Right", "left_to_right" ],
                          [ "Right to Left", "right_to_left" ],
                          [ "Long Strip", "long_strip" ],
                          [ "Webcomic", "webcomic" ]
                        ],
                        @reading_style
                      ),
                      {},
                      class: "rounded-md border border-zinc-800 bg-zinc-950 px-2 py-1 text-xs text-zinc-100" %>
      <%= form.submit "Apply", class: "ml-2 rounded-md border border-zinc-800 px-2 py-1 text-xs font-semibold text-zinc-300" %>
    <% end %>
  </nav>

  <% is_horizontal = @reading_style == 'left_to_right' || @reading_style == 'right_to_left' %>
  <% viewport_class = is_horizontal ? 'flex overflow-x-auto snap-x snap-mandatory w-full' : 'flex flex-col items-center gap-2' %>
  <% page_class = is_horizontal ? 'snap-start shrink-0 w-full min-w-full flex items-center justify-center p-4 cursor-pointer' : 'w-full max-w-3xl cursor-pointer' %>
  <% image_class = is_horizontal ? 'max-h-[calc(100vh-280px)] w-auto max-w-[95vw] object-contain rounded-md pointer-events-none' : 'w-full h-auto rounded-md pointer-events-none' %>

  <section data-reader-target="viewport"
           class="<%= viewport_class %>"
           <%= @reading_style == 'right_to_left' ? 'dir="rtl"' : '' %>>
    <% if @file_asset&.download_status.present? %>
      <div class="rounded-lg border border-zinc-800/80 bg-zinc-900/40 p-4 text-sm text-zinc-300 <%= is_horizontal ? 'shrink-0 w-screen flex items-center justify-center' : '' %>">
        <% if @file_asset.download_status == "downloading" && @file_asset.pages_expected.present? %>
          Downloading pages (<%= @file_asset.pages_downloaded %>/<%= @file_asset.pages_expected %>)
        <% elsif @file_asset.download_status == "failed" %>
          Download failed. <%= @file_asset.download_error %>
        <% elsif @file_asset.download_status == "complete" %>
          Download complete.
        <% else %>
          Download queued.
        <% end %>
      </div>
    <% end %>
    <% if @pages.empty? && @source_pages.empty? %>
      <div class="rounded-lg border border-dashed border-zinc-800/80 bg-zinc-900/40 p-6 space-y-2 <%= is_horizontal ? 'shrink-0 w-screen flex flex-col items-center justify-center' : '' %>">
        <p class="text-zinc-400 text-pretty">Streaming from source while download completes.</p>
        <p class="text-xs text-zinc-500">This does not store pages locally yet.</p>
      </div>
    <% end %>
    <% @pages.each do |page| %>
      <article data-reader-target="page"
               data-action="click->reader#openLightboxForPage"
               class="<%= page_class %>">
        <% if page.image.attached? %>
          <%= image_tag url_for(page.image), alt: "Page #{page.position}", class: image_class %>
        <% else %>
          <p class="text-sm text-zinc-400 text-pretty">Image unavailable.</p>
        <% end %>
      </article>
    <% end %>
    <% @source_pages.each do |page| %>
      <article data-reader-target="page"
               data-action="click->reader#openLightboxForPage"
               class="<%= page_class %>">
        <%= image_tag page.url, alt: "Source page #{page.index}", class: image_class %>
      </article>
    <% end %>
  </section>

  <%# Lightbox overlay - must be inside controller scope %>
  <div data-reader-target="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-6">
    <button type="button"
            class="absolute right-6 top-6 rounded-full border border-zinc-700/70 bg-zinc-900/80 px-3 py-2 text-sm font-semibold text-zinc-200 hover:bg-zinc-800"
            data-action="click->reader#closeLightbox">
      Close
    </button>
    <button type="button"
            class="absolute left-6 top-1/2 -translate-y-1/2 rounded-full border border-zinc-700/70 bg-zinc-900/80 px-4 py-3 text-xl text-zinc-200 hover:bg-zinc-800"
            data-action="click->reader#lightboxPrev"
            aria-label="Previous page">
      &larr;
    </button>
    <button type="button"
            class="absolute right-6 top-1/2 -translate-y-1/2 rounded-full border border-zinc-700/70 bg-zinc-900/80 px-4 py-3 text-xl text-zinc-200 hover:bg-zinc-800"
            data-action="click->reader#lightboxNext"
            aria-label="Next page">
      &rarr;
    </button>
    <img data-reader-target="lightboxImage"
         class="max-h-[90vh] w-auto max-w-[90vw] rounded-lg object-contain shadow-2xl"
         alt="Reader page" />
  </div>
</main>
