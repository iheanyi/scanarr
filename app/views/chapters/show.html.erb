<% page_count = @pages.any? ? @pages.length : @source_pages.length %>
<% initial_page_index = @initial_page_index || @chapter_progress&.page_index || (page_count.positive? ? 1 : 0) %>
<% if page_count.positive? %>
  <% initial_page_index = [ [ initial_page_index, page_count ].min, 1 ].max %>
<% else %>
  <% initial_page_index = 0 %>
<% end %>
<% progress_percent = page_count.positive? ? ((initial_page_index.to_f / page_count) * 100.0) : 0 %>
<% is_horizontal = @reading_style == "left_to_right" || @reading_style == "right_to_left" %>
<% is_rtl = @reading_style == "right_to_left" %>
<% is_webtoon = @reading_style == "webtoon" %>
<% is_paged_vertical = @reading_style == "vertical" %>
<% next_chapter_url = @next_chapter ? source_series_chapter_path(source_slug: source_slug(@source), series_slug: @series.to_param, chapter_identifier: chapter_identifier(@next_chapter)) : nil %>
<% next_chapter_title = @next_chapter ? "Chapter #{@next_chapter.chapter_number}" : nil %>
<% offline_status = @offline_manifest_entry&.status || "unpinned" %>
<% offline_capable = local_downloads_enabled? && (@chapter.source_url.present? || @release&.source_url.present? || @file_asset&.download_status == "complete") %>
<% offline_chapter_key = "#{source_slug(@source)}:#{@series.to_param}:#{chapter_identifier(@chapter)}" %>
<% offline_available = offline_status == "complete" %>
<% show_offline_download_icon = offline_status.in?(%w[unpinned failed]) %>
<% show_offline_cancel_icon = offline_status.in?(%w[downloading pinned]) %>
<% show_offline_remove_icon = offline_status == "complete" %>
<main data-controller="<%= [ "reader", (offline_capable ? "offline-cache" : nil) ].compact.join(" ") %>"
      data-reader-style-value="<%= @reading_style %>"
      data-reader-page-count-value="<%= page_count %>"
      data-reader-initial-page-index-value="<%= initial_page_index %>"
      data-reader-progress-url-value="<%= current_user ? source_series_chapter_progress_path(source_slug: source_slug(@source), series_slug: @series.to_param, chapter_identifier: chapter_identifier(@chapter)) : "" %>"
      <% if offline_capable %>
      data-offline-cache-chapter-key-value="<%= offline_chapter_key %>"
      data-offline-cache-chapter-public-id-value="<%= @chapter.public_id %>"
      data-offline-cache-source-slug-value="<%= source_slug(@source) %>"
      data-offline-cache-series-slug-value="<%= @series.to_param %>"
      data-offline-cache-chapter-identifier-value="<%= chapter_identifier(@chapter) %>"
      data-offline-cache-pin-url-value="<%= source_series_chapter_pin_for_offline_path(source_slug: source_slug(@source), series_slug: @series.to_param, chapter_identifier: chapter_identifier(@chapter)) %>"
      data-offline-cache-unpin-url-value="<%= source_series_chapter_unpin_for_offline_path(source_slug: source_slug(@source), series_slug: @series.to_param, chapter_identifier: chapter_identifier(@chapter)) %>"
      data-offline-cache-pages-url-value="<%= source_series_chapter_offline_pages_path(source_slug: source_slug(@source), series_slug: @series.to_param, chapter_identifier: chapter_identifier(@chapter)) %>"
      <% end %>
      <% if next_chapter_url %>
      data-reader-next-chapter-url-value="<%= next_chapter_url %>"
      data-reader-next-chapter-title-value="<%= next_chapter_title %>"
      <% end %>
      class="scanarr-reader-page space-y-6">
  <div class="mx-auto w-full max-w-7xl space-y-6 px-4 py-4 lg:px-6 lg:py-8">
    <section class="scanarr-reader-stage rounded-[2rem] p-4 md:p-6">
      <div class="space-y-6">
        <%# Breadcrumbs %>
        <nav class="flex items-center gap-2 text-sm text-muted" aria-label="Breadcrumb">
          <%= link_to "Library", library_path, class: "hover:text-foreground", data: { turbo_preload: "" } %>
          <span class="text-muted-2">/</span>
          <%= link_to @series.canonical_title, library_series_path(series_slug: @series.to_param), class: "hover:text-foreground truncate max-w-xs", data: { turbo_preload: "" } %>
          <span class="text-muted-2">/</span>
          <span class="text-foreground">Ch. <%= @chapter.chapter_number %></span>
        </nav>

        <header class="space-y-3">
          <div>
            <h1 class="text-2xl font-semibold text-balance md:text-3xl"><%= @series.canonical_title %></h1>
            <% if @series.author_name.present? || @series.artist_name.present? %>
              <p class="text-sm text-muted">
                <% if @series.author_name.present? && @series.artist_name.present? && @series.author_name != @series.artist_name %>
                  by <%= @series.author_name %> · Art by <%= @series.artist_name %>
                <% elsif @series.author_name.present? %>
                  by <%= @series.author_name %>
                <% elsif @series.artist_name.present? %>
                  by <%= @series.artist_name %>
                <% end %>
              </p>
            <% end %>
          </div>
          <div class="space-y-2 border-t border-border/80 pt-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-xl font-medium text-foreground">Chapter <%= @chapter.chapter_number %></h2>
                <% if offline_capable %>
                  <span data-offline-cache-target="availableIndicator"
                        class="inline-flex h-4 w-4 items-center justify-center text-success"
                        title="Available offline"
                        aria-label="Available offline"
                        <%= "hidden" unless offline_available %>>
                    <%= icon "check", class: "h-2.5 w-2.5" %>
                    <span class="sr-only">Available offline</span>
                  </span>
                <% end %>
              </div>
              <% if offline_capable %>
                <div class="group/offline inline-flex items-center gap-1 rounded-full px-0.5 py-0.5">
                  <span class="max-w-0 overflow-hidden whitespace-nowrap px-0 text-[10px] text-muted-2 tabular-nums text-right opacity-0 transition-all duration-150 group-hover/offline:max-w-10 group-hover/offline:px-1 group-hover/offline:opacity-100 group-focus-within/offline:max-w-10 group-focus-within/offline:px-1 group-focus-within/offline:opacity-100"
                        <%= "hidden" unless show_offline_cancel_icon %>
                        data-offline-cache-target="progress"></span>
                  <button type="button"
                          class="inline-flex h-6 w-6 items-center justify-center rounded-full border border-border/50 bg-surface/40 text-muted-2 transition-colors hover:border-info/35 hover:bg-surface hover:text-info focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                          data-action="click->offline-cache#download"
                          data-offline-cache-target="downloadButton"
                          <%= "hidden" unless show_offline_download_icon %>>
                    <%= icon "download", class: "h-3.5 w-3.5" %>
                    <span class="sr-only">Download for offline</span>
                  </button>
                  <button type="button"
                          class="inline-flex h-6 w-6 items-center justify-center rounded-full border border-border/50 bg-surface/40 text-muted-2 transition-colors hover:border-warning/35 hover:bg-surface hover:text-warning focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                          data-action="click->offline-cache#cancel"
                          data-offline-cache-target="cancelButton"
                          <%= "hidden" unless show_offline_cancel_icon %>>
                    <%= icon "x", class: "h-3.5 w-3.5" %>
                    <span class="sr-only">Cancel offline download</span>
                  </button>
                  <button type="button"
                          class="inline-flex h-6 w-6 items-center justify-center rounded-full border border-border/50 bg-surface/40 text-muted-2 transition-colors hover:border-danger/35 hover:bg-surface hover:text-danger focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                          data-action="click->offline-cache#remove"
                          data-offline-cache-target="removeButton"
                          <%= "hidden" unless show_offline_remove_icon %>>
                    <%= icon "trash-2", class: "h-3.5 w-3.5" %>
                    <span class="sr-only">Remove offline chapter</span>
                  </button>
                </div>
              <% end %>
            </div>
            <% if @chapter.meaningful_title? %>
              <p class="text-muted text-pretty"><%= @chapter.title %></p>
            <% end %>
          </div>
        </header>

        <% if page_count.positive? %>
          <div class="rounded-2xl border border-border/80 bg-background/70 p-4 backdrop-blur">
            <div class="flex items-center justify-between text-xs text-foreground">
              <span data-reader-target="progressText">Page <%= initial_page_index %> / <%= page_count %></span>
              <span data-reader-target="progressPercent"><%= progress_percent.round %>%</span>
            </div>
            <div class="mt-2 h-1.5 w-full rounded-full bg-surface-2">
              <div data-reader-target="progressBar"
                   class="h-1.5 rounded-full bg-accent transition-[width] duration-200"
                   style="width: <%= progress_percent %>%"></div>
            </div>
          </div>
        <% end %>

        <nav class="flex flex-wrap items-center gap-2">
    <% if @previous_chapter || @next_chapter %>
      <div class="inline-flex items-center rounded-md border border-border bg-surface/60 p-1">
        <% if @previous_chapter %>
          <%= link_to source_series_chapter_path(
                        source_slug: source_slug(@source),
                        series_slug: @series.to_param,
                        chapter_identifier: chapter_identifier(@previous_chapter)
                      ),
                      class: "inline-flex h-7 items-center gap-1 rounded px-2 text-xs font-medium text-muted transition-colors hover:bg-surface-2 hover:text-foreground",
                      data: { turbo_preload: "" } do %>
            <%= icon "chevron-left", class: "h-3.5 w-3.5" %>
            Prev
          <% end %>
        <% end %>
        <% if @previous_chapter && @next_chapter %>
          <span class="mx-1 h-4 w-px bg-border"></span>
        <% end %>
        <% if @next_chapter %>
          <%= link_to source_series_chapter_path(
                        source_slug: source_slug(@source),
                        series_slug: @series.to_param,
                        chapter_identifier: chapter_identifier(@next_chapter)
                      ),
                      class: "inline-flex h-7 items-center gap-1 rounded px-2 text-xs font-medium text-muted transition-colors hover:bg-surface-2 hover:text-foreground",
                      data: { turbo_preload: "" } do %>
            Next
            <%= icon "chevron-right", class: "h-3.5 w-3.5" %>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <% if @chapter.source_url.present? || @release&.source_url.present? %>
      <% download_label = if @download_in_progress
                            @file_asset&.download_status == "downloading" ? "Downloading..." : "Download queued"
         else
                            "Download this chapter"
         end %>
      <%= form_with url: source_series_chapter_download_path(
                      source_slug: source_slug(@source),
                      series_slug: @series.to_param,
                      chapter_identifier: chapter_identifier(@chapter)
                    ),
                    method: :post,
                    data: { turbo_submits_with: "Queuing..." } do %>
        <%= render UI::ButtonComponent.new(
          variant: @download_in_progress ? :secondary : :primary,
          size: :sm,
          type: "submit",
          disabled: @download_in_progress
        ) do %>
          <%= download_label %>
        <% end %>
      <% end %>
    <% end %>
    <%= form_with url: source_series_chapter_path(
                    source_slug: source_slug(@source),
                    series_slug: @series.to_param,
                    chapter_identifier: chapter_identifier(@chapter)
                  ),
                  method: :get,
                  local: true,
                  id: "reading-style-form",
                  data: { turbo_submits_with: "Updating..." } do |form| %>
      <%= render UI::AutoSelectComponent.new(
        form: form,
        method: :reading_style,
        options: User::READING_STYLE_OPTIONS,
        selected: @reading_style,
        size: :sm,
        full_width: false
      ) %>
    <% end %>
        </nav>
      </div>
    </section>

  <% viewport_class = if is_horizontal
                        base = "flex overflow-x-auto snap-x snap-mandatory w-full"
                        is_rtl ? "#{base} flex-row-reverse" : base
     elsif is_webtoon
                        # Long strip: seamless vertical scroll for webtoons - no gaps
                        "flex flex-col items-center"
     elsif is_paged_vertical
                        # Paged vertical: one page per scroll-snap panel inside container viewport
                        "flex h-[82vh] flex-col items-center overflow-y-auto snap-y snap-mandatory overscroll-contain"
     else
                        # Default vertical mode
                        "flex flex-col items-center gap-4"
     end %>
  <% page_class = if is_horizontal
                    "scanarr-reader-page-frame snap-start shrink-0 w-[78vw] max-w-5xl flex items-center justify-center p-4 cursor-pointer"
     elsif is_webtoon
                    # Long strip: full width, no extra styling - panels flow together
                    "scanarr-reader-page-frame w-full max-w-4xl cursor-pointer"
     elsif is_paged_vertical
                    # Paged vertical: each page snaps as a discrete panel
                    "scanarr-reader-page-frame snap-start min-h-[82vh] w-full max-w-3xl flex items-center justify-center px-3 py-3 cursor-pointer"
     else
                    # Default vertical pages
                    "scanarr-reader-page-frame w-full max-w-3xl cursor-pointer"
     end %>
  <% image_class = if is_webtoon
                     # Long strip: no height limit, images flow naturally
                     "scanarr-reader-image w-full max-w-full object-contain pointer-events-none"
     else
                     # Other modes: constrain height for page-based viewing
                     "scanarr-reader-image max-h-[75vh] w-auto max-w-full object-contain rounded-xl pointer-events-none"
     end %>

  <section data-reader-target="viewport"
           class="scanarr-reader-stage rounded-[2rem] p-3 md:p-5 <%= viewport_class %>"
           data-reader-rtl="<%= is_rtl %>">
    <% if @file_asset&.download_status.present? %>
      <div class="rounded-lg border border-border bg-surface/40 p-4 text-sm text-foreground <%= is_horizontal ? "shrink-0 w-full flex items-center justify-center" : "" %>">
        <% if @file_asset.download_status == "downloading" && @file_asset.pages_expected.present? %>
          Downloading pages (<%= @file_asset.pages_downloaded %>/<%= @file_asset.pages_expected %>)
        <% elsif @file_asset.download_status == "failed" %>
          Download failed. <%= @file_asset.download_error %>
        <% elsif @file_asset.download_status == "complete" %>
          Download complete.
        <% else %>
          Download queued.
        <% end %>
      </div>
    <% end %>
    <% if @source_error.present? %>
      <div class="rounded-lg border border-danger/30 bg-danger-soft p-6 space-y-3 <%= is_horizontal ? "shrink-0 w-full flex flex-col items-center justify-center" : "" %>">
        <div class="flex items-center gap-2 text-danger">
          <%= icon "circle-alert", class: "h-5 w-5" %>
          <span class="font-medium">Unable to load chapter</span>
        </div>
        <p class="text-sm text-danger text-pretty"><%= @source_error %></p>
        <div class="flex gap-2">
          <%= link_to "Back to series",
                      library_series_path(series_slug: @series.to_param),
                      class: "inline-flex items-center rounded-md border border-danger/30 px-3 py-1.5 text-sm font-medium text-danger hover:bg-danger-soft" %>
          <%= link_to "Try again",
                      source_series_chapter_path(source_slug: source_slug(@source), series_slug: @series.to_param, chapter_identifier: chapter_identifier(@chapter)),
                      class: "inline-flex items-center rounded-md bg-danger-soft px-3 py-1.5 text-sm font-medium text-danger hover:bg-danger/30" %>
        </div>
      </div>
    <% elsif @pages.empty? && @source_pages.empty? %>
      <%= render UI::EmptyStateComponent.new(
        title: "Streaming from source",
        description: "This does not store pages locally yet.",
        compact: true,
        class: is_horizontal ? "shrink-0 w-full" : nil
      ) do |empty| %>
        <% empty.with_icon do %>
          <%= icon "wifi", class: "h-6 w-6" %>
        <% end %>
      <% end %>
    <% end %>
    <% @pages.each_with_index do |page, idx| %>
      <article data-reader-target="page"
               data-action="click->reader#openLightboxForPage"
               class="<%= page_class %>">
        <% if page.image.attached? %>
          <%= image_tag url_for(page.display_image), alt: "Page #{page.position}", class: image_class, loading: idx < 3 ? "eager" : "lazy", decoding: idx < 3 ? "sync" : "async", fetchpriority: idx == 0 ? "high" : nil %>
        <% else %>
          <p class="text-sm text-muted text-pretty">Image unavailable.</p>
        <% end %>
      </article>
    <% end %>
    <% @source_pages.each_with_index do |page, idx| %>
      <article data-reader-target="page"
               data-action="click->reader#openLightboxForPage"
               class="<%= page_class %>">
        <%= image_tag page.url, alt: "Source page #{page.index}", class: image_class, loading: idx < 3 ? "eager" : "lazy", decoding: idx < 3 ? "sync" : "async", fetchpriority: idx == 0 ? "high" : nil %>
      </article>
    <% end %>
  </section>
  </div>

  <%# Lightbox overlay - must be inside controller scope %>
  <div data-reader-target="lightbox"
       data-action="pointerdown->reader#lightboxPointerDown pointermove->reader#lightboxPointerMove pointerup->reader#lightboxPointerUp pointercancel->reader#lightboxPointerCancel"
       class="fixed left-0 top-0 h-dvh w-dvw z-50 hidden bg-black/95 backdrop-blur-sm opacity-0 transition-opacity duration-200 ease-out <%= is_horizontal ? "items-center justify-center p-6" : "items-stretch justify-stretch" %>">
    <button type="button"
            class="absolute right-6 top-6 rounded-full border border-border bg-surface/80 px-3 py-2 text-sm font-semibold text-foreground hover:bg-surface-2"
            data-action="click->reader#closeLightbox">
      Close
    </button>
    <div data-reader-target="lightboxProgressText"
         class="pointer-events-none absolute left-4 top-4 rounded-full border border-border bg-surface/80 px-3 py-1 text-xs font-medium text-foreground shadow-sm">
      Page <%= initial_page_index %> / <%= page_count %> (<%= progress_percent.round %>%)
    </div>
    <% if is_horizontal %>
      <button type="button"
              class="lightbox-nav-arrow absolute left-6 top-1/2 -translate-y-1/2 rounded-full border border-border bg-surface/80 px-4 py-3 text-xl text-foreground hover:bg-surface-2"
              data-action="click->reader#lightboxPrev"
              aria-label="Previous page">
        &larr;
      </button>
      <button type="button"
              class="lightbox-nav-arrow absolute right-6 top-1/2 -translate-y-1/2 rounded-full border border-border bg-surface/80 px-4 py-3 text-xl text-foreground hover:bg-surface-2"
              data-action="click->reader#lightboxNext"
              aria-label="Next page">
        &rarr;
      </button>
      <img data-reader-target="lightboxImage lightboxPanel"
           class="max-h-[90vh] w-auto max-w-[90vw] rounded-lg object-contain shadow-2xl transition-[opacity,transform] duration-200 ease-out opacity-0 scale-[0.98]"
           alt="Reader page">
    <% else %>
      <div data-reader-target="lightboxHint"
           class="pointer-events-none absolute left-1/2 top-5 -translate-x-1/2 rounded-full border border-border bg-surface/70 px-3 py-1 text-xs text-foreground transition-opacity duration-700">
        Focus mode: scroll vertically
      </div>
      <div data-reader-target="lightboxScroll lightboxPanel"
           class="h-full w-full overflow-y-auto overscroll-contain px-4 pb-10 pt-20 transition-[opacity,transform] duration-200 ease-out opacity-0 translate-y-1">
        <div data-reader-target="lightboxStrip"
             class="mx-auto flex w-full max-w-4xl flex-col gap-4">
        </div>
      </div>
    <% end %>
  </div>

  <%# Next Chapter overlay - shows when reaching end of chapter %>
  <% if @next_chapter %>
    <div data-reader-target="nextChapterOverlay"
         class="fixed inset-0 z-[60] hidden items-center justify-center bg-background/98 p-6">
      <div class="max-w-md w-full space-y-6 text-center">
        <div class="space-y-2">
          <p class="text-sm text-muted uppercase tracking-wider font-medium">End of Chapter</p>
          <h2 class="text-3xl font-semibold text-foreground">Continue Reading?</h2>
        </div>

        <div class="rounded-xl border border-border bg-surface p-5 space-y-2">
          <p class="text-sm text-muted">Up next</p>
          <p class="text-xl font-semibold text-foreground">
            Chapter <%= @next_chapter.chapter_number %>
            <% if @next_chapter.meaningful_title? %>
              <span class="block text-sm text-muted mt-1"><%= @next_chapter.title %></span>
            <% end %>
          </p>
        </div>

        <div class="space-y-3">
          <button type="button"
                  data-action="click->reader#goToNextChapter"
                  class="w-full rounded-lg bg-accent px-6 py-3.5 text-base font-semibold text-accent-foreground hover:bg-accent-strong transition-colors shadow-lg shadow-accent/20">
            <span>Continue to Next Chapter</span>
            <span class="ml-2 inline-flex items-center justify-center rounded-full bg-background/20 px-2.5 py-0.5 text-sm font-semibold">
              <span data-reader-target="nextChapterCountdown">5</span>s
            </span>
          </button>

          <button type="button"
                  data-action="click->reader#cancelNextChapter"
                  class="w-full rounded-lg border border-border bg-surface-2 px-6 py-3 text-sm font-medium text-foreground hover:bg-surface hover:border-border-soft transition-colors">
            Stay on this chapter
          </button>

          <%= link_to library_series_path(series_slug: @series.to_param),
                      class: "inline-block text-sm text-muted hover:text-foreground font-medium transition-colors" do %>
            Back to series
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</main>
