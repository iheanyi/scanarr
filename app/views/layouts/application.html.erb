<!DOCTYPE html>
<html>
  <head>
    <title>Scanarr</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="min-h-dvh bg-zinc-950 text-zinc-100 text-pretty">
    <div class="min-h-dvh">
      <header class="border-b border-zinc-800/80">
        <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-4">
          <%= link_to "Scanarr", root_path, class: "text-lg font-semibold text-balance" %>
          <nav class="flex items-center gap-4 text-sm text-zinc-300">
            <%= link_to "Library", library_path, class: "hover:text-zinc-100" %>
            <%= link_to "Calendar", calendar_path, class: "hover:text-zinc-100" %>
            <%= link_to "Sources", root_path, class: "hover:text-zinc-100" %>
            <%= link_to "Search", search_path, class: "hover:text-zinc-100" %>
            <%= link_to "Downloads", admin_downloads_path, class: "hover:text-zinc-100" %>
            <%= link_to "Jobs", "/admin/jobs", class: "hover:text-zinc-100" %>
            <%= link_to "Admin", admin_scrapers_path, class: "hover:text-zinc-100" %>
            <% if user_signed_in? %>
              <div class="relative" data-controller="dropdown">
                <button type="button" data-action="click->dropdown#toggle" class="relative flex items-center gap-1 hover:text-zinc-100">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                  </svg>
                  <% if unread_notification_count > 0 %>
                    <span class="absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-emerald-500 text-[10px] font-bold text-white"><%= unread_notification_count > 9 ? "9+" : unread_notification_count %></span>
                  <% end %>
                </button>
                <div data-dropdown-target="menu" class="hidden absolute right-0 top-full mt-2 w-80 rounded-lg border border-zinc-800 bg-zinc-900 shadow-xl z-50">
                  <div class="flex items-center justify-between border-b border-zinc-800 px-4 py-2">
                    <span class="text-sm font-semibold text-zinc-100">Notifications</span>
                    <% if unread_notification_count > 0 %>
                      <%= button_to mark_all_read_notifications_path, method: :post, class: "text-xs text-emerald-400 hover:text-emerald-300" do %>
                        Mark all read
                      <% end %>
                    <% end %>
                  </div>
                  <div class="max-h-80 overflow-y-auto">
                    <% if current_notifications.any? %>
                      <% current_notifications.each do |notification| %>
                        <div class="flex items-start gap-3 border-b border-zinc-800/50 px-4 py-3 hover:bg-zinc-800/30">
                          <div class="flex-1 min-w-0">
                            <p class="text-sm text-zinc-100 truncate"><%= notification.chapter.series.canonical_title %></p>
                            <p class="text-xs text-zinc-400">Chapter <%= notification.chapter.chapter_number %></p>
                          </div>
                          <%= button_to mark_read_notification_path(notification), method: :post, class: "shrink-0 text-zinc-500 hover:text-zinc-300" do %>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                          <% end %>
                        </div>
                      <% end %>
                    <% else %>
                      <div class="px-4 py-6 text-center text-sm text-zinc-500">
                        No new notifications
                      </div>
                    <% end %>
                  </div>
                  <div class="border-t border-zinc-800 px-4 py-2">
                    <%= link_to "View all", notifications_path, class: "text-xs text-zinc-400 hover:text-zinc-200" %>
                  </div>
                </div>
              </div>
            <% end %>
          </nav>
        </div>
      </header>
      <% if flash[:notice].present? || flash[:alert].present? %>
        <div class="mx-auto w-full max-w-6xl px-4 pt-4">
          <% if flash[:notice].present? %>
            <div class="rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200">
              <%= flash[:notice] %>
            </div>
          <% end %>
          <% if flash[:alert].present? %>
            <div class="rounded-lg border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200">
              <%= flash[:alert] %>
            </div>
          <% end %>
        </div>
      <% end %>
      <main class="mx-auto w-full max-w-6xl px-4 py-8">
      <%= yield %>
      </main>
    </div>
  </body>
</html>
