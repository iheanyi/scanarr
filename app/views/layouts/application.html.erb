<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Scanarr</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Geist - Modern typeface by Vercel, designed for dark interfaces %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
  </head>
  <body class="min-h-dvh bg-background text-foreground text-pretty">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-accent-foreground">Skip to content</a>
    <div data-controller="drawer" class="min-h-dvh lg:grid lg:grid-cols-[240px_minmax(0,1fr)]">
      <header class="flex items-center gap-3 border-b border-border px-4 py-3 lg:hidden">
        <button type="button"
                class="inline-flex items-center justify-center rounded-md border border-border bg-surface-2 p-2 text-foreground hover:bg-surface-2/80"
                data-action="click->drawer#open"
                aria-label="Open navigation">
          <%= icon "menu", class: "h-5 w-5", aria: { hidden: true } %>
        </button>
        <%= link_to "Scanarr", root_path, class: "text-lg font-semibold text-balance" %>
      </header>

      <aside class="hidden border-r border-border bg-surface px-4 py-6 lg:sticky lg:top-0 lg:flex lg:min-h-dvh lg:flex-col">
        <%= link_to "Scanarr", root_path, class: "text-lg font-semibold text-balance text-foreground" %>
        <div class="mt-6 flex-1">
          <%= render "shared/sidebar_nav" %>
        </div>
      </aside>

      <div class="min-h-dvh">
        <% if flash[:notice].present? || flash[:alert].present? %>
          <div class="mx-auto w-full max-w-6xl px-4 pt-4 space-y-2">
            <%= render UI::FlashMessageComponent.new(variant: :success, message: flash[:notice], dismissible: true) %>
            <%= render UI::FlashMessageComponent.new(variant: :danger, message: flash[:alert], dismissible: true) %>
          </div>
        <% end %>
        <main id="main-content" class="mx-auto w-full max-w-6xl px-4 py-8">
          <%= yield %>
        </main>
      </div>

      <%# Real-time notification count updates %>
      <% if user_signed_in? %>
        <%= turbo_stream_from current_user, :notifications %>
      <% end %>

      <%# Toast container for Turbo Stream notifications %>
      <div id="toast-container" data-turbo-permanent class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 w-80 max-w-[calc(100vw-2rem)]"></div>

      <dialog data-drawer-target="dialog"
              data-action="click->drawer#closeOnBackdrop"
              class="m-0 h-dvh w-80 max-w-full border-r border-border bg-surface p-4 text-foreground backdrop:bg-background/80">
        <div class="flex items-center justify-between border-b border-border pb-4">
          <%= link_to "Scanarr", root_path, class: "text-lg font-semibold text-balance" %>
          <button type="button"
                  class="inline-flex items-center justify-center rounded-md border border-border bg-surface-2 p-2 text-foreground hover:bg-surface-2/80"
                  data-action="drawer#close"
                  aria-label="Close navigation">
            <%= icon "x", class: "h-5 w-5", aria: { hidden: true } %>
          </button>
        </div>
        <div class="mt-4 h-full pb-6">
          <%= render "shared/sidebar_nav" %>
        </div>
      </dialog>
    </div>
  </body>
</html>
