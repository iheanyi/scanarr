<!DOCTYPE html>
<html>
  <head>
    <title>Scanarr</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="min-h-dvh bg-zinc-950 text-zinc-100 text-pretty">
    <div class="min-h-dvh">
      <header class="border-b border-zinc-800/80">
        <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-4">
          <%= link_to "Scanarr", root_path, class: "text-lg font-semibold text-balance" %>
          <nav class="flex items-center gap-4 text-sm text-zinc-300">
            <%= link_to "Sources", root_path, class: "hover:text-zinc-100" %>
            <%= link_to "Search", search_path, class: "hover:text-zinc-100" %>
            <%= link_to "Downloads", admin_downloads_path, class: "hover:text-zinc-100" %>
            <%= link_to "Admin", admin_scrapers_path, class: "hover:text-zinc-100" %>
          </nav>
        </div>
      </header>
      <main class="mx-auto w-full max-w-6xl px-4 py-8">
      <%= yield %>
      </main>
    </div>
  </body>
</html>
