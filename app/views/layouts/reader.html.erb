<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Scanarr Reader</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#0b0f14">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Scanarr">
    <link rel="manifest" href="<%= pwa_manifest_path %>">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon-192.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= yield :head %>
  </head>
  <body class="min-h-dvh bg-background text-foreground">
    <% if flash[:notice].present? || flash[:alert].present? %>
      <div class="mx-auto w-full max-w-6xl px-4 pt-4 space-y-2">
        <%= render UI::FlashMessageComponent.new(variant: :success, message: flash[:notice], dismissible: true) %>
        <%= render UI::FlashMessageComponent.new(variant: :danger, message: flash[:alert], dismissible: true) %>
      </div>
    <% end %>
    <main id="main-content" class="mx-auto w-full max-w-6xl px-4 py-6">
      <%= yield %>
    </main>
    <div id="toast-container" data-turbo-permanent class="fixed right-4 z-50 flex w-80 max-w-[calc(100vw-2rem)] flex-col gap-2 bottom-[calc(env(safe-area-inset-bottom)+1rem)]"></div>
  </body>
</html>
