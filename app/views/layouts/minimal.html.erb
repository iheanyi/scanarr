<!DOCTYPE html>
<html lang="en">
  <head>
    <% app_theme = ScanarrThemes.normalize(current_user&.effective_theme) %>
    <title>Scanarr</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="<%= ScanarrThemes.meta_color(app_theme) %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body data-scanarr-theme="<%= app_theme %>" class="min-h-dvh bg-background text-foreground">
    <%= yield %>
  </body>
</html>
