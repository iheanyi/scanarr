<div class="space-y-6">
  <%= render UI::PageHeaderComponent.new(
    title: "Release Calendar",
    description: "New chapters from your followed series."
  ) %>

  <div class="flex flex-wrap items-center gap-4">
    <%# View Type Toggle %>
    <div class="flex rounded-lg overflow-hidden border border-border">
      <% %w[week month recent].each do |view| %>
        <%= link_to view.titleize,
              calendar_path(view: view, source: @source_filter),
              class: "px-4 py-2 text-sm #{@view_type == view ? 'bg-accent text-accent-foreground' : 'bg-surface-2 hover:bg-surface'}" %>
      <% end %>
    </div>

    <%# Source Filter %>
    <%= render UI::RedirectSelectComponent.new(
      options: [["All Sources", calendar_path(view: @view_type)]] +
               @sources.map { |s| [s.name, calendar_path(view: @view_type, source: s.slug)] },
      selected: @source_filter.present? ? calendar_path(view: @view_type, source: @source_filter) : calendar_path(view: @view_type)
    ) %>

    <% if @view_type == "week" %>
      <div class="flex items-center gap-2 ml-auto">
        <%= link_to calendar_path(view: "week", source: @source_filter, week_offset: @week_offset - 1),
                    class: "inline-flex items-center gap-1 rounded-md border border-border px-3 py-1.5 text-sm text-foreground hover:bg-surface-2" do %>
          <%= icon "chevron-left", class: "h-4 w-4" %>
          Prev
        <% end %>
        <% if @week_offset != 0 %>
          <%= link_to "This Week", calendar_path(view: "week", source: @source_filter),
                      class: "rounded-md border border-border px-3 py-1.5 text-sm text-foreground hover:bg-surface-2" %>
        <% end %>
        <%= link_to calendar_path(view: "week", source: @source_filter, week_offset: @week_offset + 1),
                    class: "inline-flex items-center gap-1 rounded-md border border-border px-3 py-1.5 text-sm text-foreground hover:bg-surface-2" do %>
          Next
          <%= icon "chevron-right", class: "h-4 w-4" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @chapters_by_date.empty? %>
    <div class="text-center py-12 text-muted">
      <p class="text-lg mb-2">No new chapters in this period</p>
      <p class="text-sm">
        <% if current_user.user_series_follows.empty? %>
          <%= link_to "Follow some series", library_path, class: "text-accent hover:underline" %>
          to see releases here.
        <% else %>
          Check back later for new releases from your followed series.
        <% end %>
      </p>
    </div>
  <% else %>
    <div class="space-y-6">
      <% (@start_date..@end_date).to_a.reverse.each do |date| %>
        <% chapters = @chapters_by_date[date] || [] %>
        <% next if chapters.empty? %>

        <div class="bg-surface-2 rounded-lg overflow-hidden">
          <div class="px-4 py-3 bg-surface border-b border-border">
            <h2 class="font-semibold">
              <%= date.strftime("%A, %B %d, %Y") %>
              <% if date == Date.current %>
                <span class="text-xs bg-accent text-accent-foreground px-2 py-1 rounded ml-2">Today</span>
              <% end %>
            </h2>
          </div>

          <div class="divide-y divide-border">
            <% chapters.each do |chapter| %>
              <div class="px-4 py-3 flex items-center justify-between hover:bg-surface">
                <div class="flex items-center gap-4">
                  <%= render UI::SeriesCoverComponent.new(url: chapter.series.cover_image_url, alt: chapter.series.canonical_title, size: :sm, rounded: :sm) %>

                  <div>
                    <h3 class="font-medium">
                      <%= link_to chapter.series.canonical_title,
                                  source_series_path(chapter.source.slug, chapter.series.to_param),
                                  class: "hover:text-accent" %>
                    </h3>
                    <p class="text-sm text-muted">
                      <%= link_to "Chapter #{chapter.chapter_number}",
                                  source_series_chapter_path(chapter.source.slug, chapter.series.to_param, chapter.chapter_number),
                                  class: "hover:text-accent" %>
                      <% if chapter.title.present? && chapter.title != "Chapter #{chapter.chapter_number}" %>
                        - <%= chapter.title %>
                      <% end %>
                    </p>
                    <p class="text-xs text-muted-2">
                      <%= chapter.source.name %> &middot; <%= chapter.created_at.strftime("%l:%M %p") %>
                    </p>
                  </div>
                </div>

                <div class="flex gap-2">
                  <%= link_to "Read",
                              source_series_chapter_path(chapter.source.slug, chapter.series.to_param, chapter.chapter_number),
                              class: "px-3 py-1 bg-accent hover:bg-accent-strong rounded text-sm text-accent-foreground" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
