<div class="space-y-6">
  <%= render UI::PageHeaderComponent.new(
    title: "Release Calendar",
    description: "New chapters from your followed series."
  ) %>

  <div class="flex flex-wrap items-center gap-4">
    <%# View Type Toggle %>
    <%= render UI::FilterTabsComponent.new(items: %w[week month recent].map { |view|
      { label: view.titleize, href: calendar_path(view: view, source: @source_filter), active: @view_type == view, variant: :primary }
    }) %>

    <%# Source Filter %>
    <%= render UI::RedirectSelectComponent.new(
      options: [ [ "All Sources", calendar_path(view: @view_type) ] ] +
               @sources.map { |s| [ s.name, calendar_path(view: @view_type, source: s.slug) ] },
      selected: @source_filter.present? ? calendar_path(view: @view_type, source: @source_filter) : calendar_path(view: @view_type)
    ) %>

    <% if @view_type == "week" %>
      <div class="flex items-center gap-2 ml-auto">
        <%= link_to calendar_path(view: "week", source: @source_filter, week_offset: @week_offset - 1),
                    class: "inline-flex items-center gap-1 rounded-md border border-border px-3 py-1.5 text-sm text-foreground hover:bg-surface-2" do %>
          <%= icon "chevron-left", class: "h-4 w-4" %>
          Prev
        <% end %>
        <% if @week_offset != 0 %>
          <%= link_to "This Week", calendar_path(view: "week", source: @source_filter),
                      class: "rounded-md border border-border px-3 py-1.5 text-sm text-foreground hover:bg-surface-2" %>
        <% end %>
        <%= link_to calendar_path(view: "week", source: @source_filter, week_offset: @week_offset + 1),
                    class: "inline-flex items-center gap-1 rounded-md border border-border px-3 py-1.5 text-sm text-foreground hover:bg-surface-2" do %>
          Next
          <%= icon "chevron-right", class: "h-4 w-4" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @chapters_by_date.empty? %>
    <%= render UI::EmptyStateComponent.new(
      title: "No new chapters in this period",
      description: current_user.user_series_follows.empty? ? nil : "Check back later for new releases from your followed series.",
      compact: true
    ) do |empty| %>
      <% empty.with_icon do %>
        <%= icon "calendar", class: "h-6 w-6" %>
      <% end %>
      <% empty.with_action do %>
        <% if current_user.user_series_follows.empty? %>
          <%= link_to "Follow some series", library_path, class: "text-sm text-info hover:text-info" %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <div class="space-y-6">
      <% (@start_date..@end_date).to_a.reverse.each do |date| %>
        <% chapters = @chapters_by_date[date] || [] %>
        <% next if chapters.empty? %>

        <div class="bg-surface-2 rounded-lg overflow-hidden">
          <div class="px-4 py-3 bg-surface border-b border-border">
            <h2 class="font-semibold">
              <%= date.strftime("%A, %B %d, %Y") %>
              <% if date == Date.current %>
                <span class="text-xs bg-accent text-accent-foreground px-2 py-1 rounded ml-2">Today</span>
              <% end %>
            </h2>
          </div>

          <div class="divide-y divide-border">
            <% chapters.each do |chapter| %>
              <div class="px-4 py-3 flex items-center justify-between hover:bg-surface transition-colors">
                <div class="flex items-center gap-4">
                  <%= render UI::SeriesCoverComponent.new(url: chapter.series.cover_image_url, alt: chapter.series.canonical_title, size: :sm, rounded: :sm) %>

                  <div>
                    <h3 class="font-medium flex items-center gap-2">
                      <%= link_to chapter.series.canonical_title,
                                  library_series_path(series_slug: chapter.series.to_param),
                                  class: "hover:text-accent" %>
                      <% if @unread_chapter_ids.include?(chapter.id) %>
                        <span class="rounded-full bg-accent-soft px-2 py-0.5 text-[10px] font-semibold text-accent">New</span>
                      <% end %>
                    </h3>
                    <p class="text-sm text-muted">
                      <%= link_to "Chapter #{chapter.chapter_number}",
                                  source_series_chapter_path(chapter.source.slug, chapter.series.to_param, chapter.chapter_number),
                                  class: "hover:text-accent" %>
                      <% if chapter.title.present? && chapter.title != "Chapter #{chapter.chapter_number}" %>
                        - <%= chapter.title %>
                      <% end %>
                    </p>
                    <p class="text-xs text-muted-2">
                      <%= chapter.source.name %> &middot; <%= chapter.created_at.strftime("%l:%M %p") %>
                    </p>
                  </div>
                </div>

                <div class="flex items-center gap-2">
                  <% latest_release = @latest_release_map[chapter.id] %>
                  <% file_asset = latest_release&.file_asset %>
                  <% if file_asset&.download_status == "complete" %>
                    <%= render UI::StatusBadgeComponent.new(status: "complete", label: "Downloaded") %>
                  <% elsif file_asset&.download_status.in?(%w[queued pending downloading]) %>
                    <% dl_label = file_asset.download_status == "downloading" ? "Downloading" : "Queued" %>
                    <%= render UI::StatusBadgeComponent.new(status: file_asset.download_status, label: dl_label) %>
                  <% elsif chapter.source_url.present? %>
                    <%= button_to source_series_chapter_download_path(
                          source_slug: chapter.source.slug,
                          series_slug: chapter.series.to_param,
                          chapter_identifier: chapter.chapter_number
                        ),
                        method: :post,
                        class: "inline-flex items-center gap-1 rounded-md border border-accent/40 px-2 py-1 text-xs font-semibold text-accent hover:bg-accent-soft",
                        data: { turbo_submits_with: "Queuing..." } do %>
                      <%= icon "download", class: "h-3 w-3" %>
                      Download
                    <% end %>
                  <% end %>
                  <%= render UI::ButtonComponent.new(
                    variant: :primary,
                    size: :sm,
                    href: source_series_chapter_path(chapter.source.slug, chapter.series.to_param, chapter.chapter_number)
                  ) do %>
                    Read
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
