<div class="space-y-6">
  <%= render UI::PageHeaderComponent.new(
    title: "Search",
    description: "Search across multiple sources and import series into your library."
  ) %>

  <section class="rounded-lg border border-border bg-surface p-4">
    <%= form_with url: search_path, method: :get, local: true do |form| %>
      <div class="space-y-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
          <div class="flex-1 space-y-1">
            <%= form.label :q, "Series title", class: "text-sm text-muted" %>
            <%= form.text_field :q,
                                value: @query,
                                placeholder: "One Piece",
                                autofocus: true,
                                class: "w-full rounded-lg border border-border bg-surface-2 px-3 py-2 text-sm text-foreground placeholder:text-muted-2 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
          </div>
          <%= form.submit "Search",
                          class: "inline-flex items-center justify-center rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-accent-foreground hover:bg-accent-strong" %>
        </div>

        <%= render UI::MultiSelectComponent.new(
          name: "sources",
          label: "Sources",
          options: @sources.map { |source| [source.name || source.key, source.id.to_s] },
          selected: @selected_source_ids,
          filter_placeholder: "Filter sources",
          all_label: "All sources"
        ) %>
      </div>
    <% end %>
  </section>

  <% if @query.present? %>
    <% if @errors.any? %>
      <div class="rounded-lg border border-warning-soft bg-warning-soft px-4 py-3 text-sm text-warning">
        <p class="font-medium text-pretty">Some sources couldn't be searched:</p>
        <ul class="mt-1 text-xs text-warning/80 space-y-0.5">
          <% @errors.each do |error| %>
            <li><%= error[:source].name || error[:source].key %>: <%= error[:message] %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <section class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-semibold text-balance text-foreground">Results</h2>
        <span class="text-sm text-muted tabular-nums"><%= @results.size %> matches</span>
      </div>
      <% if @results.any? %>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <% @results.each do |item| %>
            <% source = item[:source] %>
            <% result = item[:result] %>
            <div class="flex flex-col rounded-lg border border-border bg-surface p-4">
              <div class="flex flex-1 gap-4">
                <div class="h-32 w-24 shrink-0 overflow-hidden rounded-md border border-border bg-surface-2">
                  <% if result.cover_url.present? %>
                    <%= image_tag result.cover_url, alt: "#{result.title} cover", class: "h-full w-full object-cover", loading: "lazy" %>
                  <% else %>
                    <div class="flex h-full w-full items-center justify-center text-[10px] uppercase text-muted-2">
                      No cover
                    </div>
                  <% end %>
                </div>
                <div class="flex min-w-0 flex-1 flex-col">
                  <span class="mb-1 inline-flex w-fit items-center rounded-full bg-accent-soft px-2 py-0.5 text-[10px] font-medium text-accent-strong">
                    <%= source.name || source.key %>
                  </span>
                  <p class="line-clamp-2 font-semibold text-balance text-foreground"><%= result.title %></p>
                  <% if result.respond_to?(:author) && result.author.present? %>
                    <p class="mt-1 text-sm text-muted text-pretty">by <%= result.author %></p>
                  <% end %>
                </div>
              </div>
              <div class="mt-3 border-t border-border pt-3">
                <%= button_to "Import",
                              source_import_path(source_slug: source_slug(source)),
                              method: :post,
                              params: { series_url: result.url },
                              class: "inline-flex w-full items-center justify-center rounded-lg border border-accent/40 px-3 py-1.5 text-sm font-semibold text-accent-strong hover:bg-accent-ghost",
                              data: { turbo_submits_with: "Importing..." } %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-lg border border-dashed border-border bg-surface p-6 text-center">
          <p class="text-sm text-muted text-pretty">No results found for "<%= @query %>".</p>
          <p class="mt-1 text-xs text-muted-2 text-pretty">Try a different title or adjust your sources.</p>
          <%= link_to "Clear search", search_path, class: "mt-4 inline-flex text-sm text-info hover:text-info" %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
