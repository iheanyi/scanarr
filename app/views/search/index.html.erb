<div class="space-y-6">
  <%= render UI::PageHeaderComponent.new(
    title: "Search",
    description: "Find a series, preview it, and add it to your library."
  ) %>

  <section class="rounded-lg border border-border bg-surface p-4">
    <%= form_with url: search_path, method: :get, local: true do |form| %>
      <div class="space-y-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
          <div class="flex-1 space-y-1">
            <%= form.label :q, "Series title", class: "text-sm text-muted" %>
            <%= form.text_field :q,
                                value: @query,
                                placeholder: "One Piece",
                                autofocus: true,
                                class: "w-full rounded-lg border border-border bg-surface-2 px-3 py-2 text-sm text-foreground placeholder:text-muted-2 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
          </div>
          <%= render UI::ButtonComponent.new(variant: :primary, type: "submit") do %>
            Search
          <% end %>
        </div>

        <%= render UI::MultiSelectComponent.new(
          name: "sources",
          label: "Sources",
          options: @sources.map { |source| [ source.display_name_with_content_rating, source.id.to_s ] },
          selected: @selected_source_ids,
          filter_placeholder: "Filter sources",
          all_label: "All sources"
        ) %>

        <div class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-border/70 bg-surface-2/40 px-3 py-2">
          <label class="inline-flex items-center gap-2 text-xs text-muted">
            <%= form.check_box :include_mature,
                               { checked: @include_mature, class: "rounded border-border bg-surface-2 text-accent focus:ring-accent" },
                               "1",
                               "0" %>
            Show 18+ sources
          </label>
          <% if @hidden_mature_count.positive? %>
            <span class="text-xs text-muted-2"><%= @hidden_mature_count %> 18+ sources hidden</span>
          <% end %>
        </div>

        <% advanced_filters_active = @genres.present? || @status.present? %>
        <details class="rounded-lg border border-border/70 bg-surface/40 p-3" <%= "open" if advanced_filters_active %>>
          <summary class="cursor-pointer select-none text-sm font-medium text-muted hover:text-foreground">
            Filter matches in your library
          </summary>
          <div class="mt-3 grid gap-3 md:grid-cols-3">
            <%= render UI::MultiSelectComponent.new(
              name: :genres,
              options: @genre_options.map { |genre| [ genre.tr("_-", "  ").squish.titleize, genre ] },
              selected: @genres,
              label: "Genres",
              filter_placeholder: "Filter genres",
              all_label: "All genres",
              max_chips: 2
            ) %>

            <%= render UI::SelectComponent.new(
              form: form,
              method: :status,
              options: @status_options,
              selected: @status,
              label: "Reading status"
            ) %>

            <div class="flex items-end">
              <%= link_to "Clear advanced filters",
                          search_path(current_search_params(genres: nil, status: nil)),
                          class: "inline-flex h-9 items-center rounded-md border border-border px-3 text-sm text-muted hover:text-foreground hover:border-muted" %>
            </div>
          </div>
          <p class="mt-3 text-xs text-muted-2">
            These filters only show series already in your library. Leave them clear to discover new titles.
          </p>
        </details>
      </div>
    <% end %>
  </section>

  <% if @query.present? %>
    <% sources_by_id = @sources.index_by { |source| source.id.to_s } %>
    <% source_filter_active = @selected_source_ids.size < @sources.size %>
    <% if source_filter_active || @genres.present? || @status.present? %>
      <section class="flex flex-wrap items-center gap-2">
        <% if source_filter_active %>
          <% @selected_source_ids.each do |source_id| %>
            <% source = sources_by_id[source_id] %>
            <% next unless source %>
            <%= link_to search_path(current_search_params(sources: (@selected_source_ids - [ source_id ]).presence)),
                        class: "inline-flex items-center gap-1 rounded-full border border-border bg-surface-2 px-2.5 py-1 text-xs text-foreground hover:border-accent/40" do %>
              <span>Source: <%= source.display_name_with_content_rating %></span>
              <span aria-hidden="true">&times;</span>
            <% end %>
          <% end %>
        <% end %>

        <% @genres.each do |genre| %>
          <%= link_to search_path(current_search_params(genres: (@genres - [ genre ]).presence)),
                      class: "inline-flex items-center gap-1 rounded-full border border-border bg-surface-2 px-2.5 py-1 text-xs text-foreground hover:border-accent/40" do %>
            <span>Genre: <%= genre.tr("_-", "  ").squish.titleize %></span>
            <span aria-hidden="true">&times;</span>
          <% end %>
        <% end %>

        <% if @status.present? %>
          <%= link_to search_path(current_search_params(status: nil)),
                      class: "inline-flex items-center gap-1 rounded-full border border-border bg-surface-2 px-2.5 py-1 text-xs text-foreground hover:border-accent/40" do %>
            <span>Status: <%= status_label_for(@status) %></span>
            <span aria-hidden="true">&times;</span>
          <% end %>
        <% end %>

        <%= link_to "Clear all filters",
                    search_path(@include_mature ? { include_mature: "1" } : {}),
                    class: "inline-flex items-center rounded-full border border-border px-2.5 py-1 text-xs text-muted hover:text-foreground hover:border-muted" %>
      </section>
    <% end %>

    <% if @errors.any? %>
      <%= render UI::FlashMessageComponent.new(variant: :warning) do %>
        <p class="font-medium text-pretty">Some sources couldn't be searched:</p>
        <ul class="mt-1 text-xs text-warning/80 space-y-0.5">
          <% @errors.each do |error| %>
            <li><%= error[:source].name || error[:source].key %>: <%= error[:message] %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <section class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-semibold text-balance text-foreground">Results</h2>
        <span class="text-sm text-muted tabular-nums"><%= @results.size %> matches</span>
      </div>
      <% if @results.any? %>
        <% if @results.any? { |item| item[:library_series].nil? } %>
          <p class="text-xs text-muted">
            Adding a series follows it for updates.
            <% if current_user.effective_download_policy == "auto_download" %>
              New follows automatically download all chapters to your server.
            <% else %>
              New follows notify you about updates. Chapters download when you choose.
            <% end %>
            Existing follows keep their download setting.
          </p>
        <% end %>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <% @results.each do |item| %>
            <% source = item[:source] %>
            <% result = item[:result] %>
            <% imported_series = item[:library_series] %>
            <% preview_path = source_preview_path(source_slug: source_slug(source), series_url: result.url) %>
            <div class="flex flex-col rounded-lg border border-border/80 bg-surface/40 p-4 hover:border-accent/40 transition-colors">
              <div class="flex flex-1 gap-4">
                <%= link_to preview_path, class: "shrink-0 rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent", aria: { label: "Preview #{result.title}" } do %>
                  <%= render UI::SeriesCoverComponent.new(url: result.cover_url, alt: "", size: :lg) %>
                <% end %>
                <div class="flex min-w-0 flex-1 flex-col">
                  <span class="mb-1 inline-flex w-fit items-center rounded-full bg-accent-soft px-2 py-0.5 text-[10px] font-medium text-accent-strong">
                    <%= source.name || source.key %>
                  </span>
                  <%= link_to result.title, preview_path, class: "line-clamp-2 font-semibold text-balance text-foreground hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent" %>
                  <% if imported_series %>
                    <p class="mt-1 text-xs font-medium text-success">In your library</p>
                  <% end %>
                  <p class="mt-1 text-xs text-muted tabular-nums">
                    <% if result.respond_to?(:chapter_count) && result.chapter_count.present? %>
                      <%= result.chapter_count %> <%= "chapter".pluralize(result.chapter_count) %>
                    <% else %>
                      Chapter count unavailable
                    <% end %>
                  </p>
                  <% if result.respond_to?(:author) && result.author.present? %>
                    <p class="mt-1 text-sm text-muted text-pretty">by <%= result.author %></p>
                  <% end %>
                </div>
              </div>
              <div class="mt-3 border-t border-border pt-3">
                <% if imported_series %>
                  <%= render UI::ButtonComponent.new(variant: :primary, href: library_series_path(series_slug: imported_series.to_param), class: "w-full") do %>
                    Open in library
                  <% end %>
                <% else %>
                  <%= button_to "Add to library",
                              source_import_path(source_slug: source_slug(source)),
                              method: :post,
                              params: { series_url: result.url },
                              class: "inline-flex w-full items-center justify-center rounded-lg border border-accent/40 px-3 py-1.5 text-sm font-semibold text-accent-strong hover:bg-accent-ghost",
                              data: { turbo_submits_with: "Adding..." } %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <%= render UI::EmptyStateComponent.new(
          title: "No results found",
          description: "No results for \"#{@query}\". Try a different title or adjust your sources.",
          compact: true
        ) do |empty| %>
          <% empty.with_icon do %>
            <%= icon "search", class: "h-6 w-6" %>
          <% end %>
          <% empty.with_action do %>
            <%= link_to "Clear search",
                        search_path(@include_mature ? { include_mature: "1" } : {}),
                        class: "text-sm text-info hover:text-info" %>
          <% end %>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>
