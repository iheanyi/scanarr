#!/usr/bin/env sh

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

# Default to port 3000 if not specified
export PORT="${PORT:-3000}"

export REDIS_URL="${REDIS_URL:-redis://127.0.0.1:6379/0}"
export SIDEKIQ_REDIS_URL="${SIDEKIQ_REDIS_URL:-redis://127.0.0.1:6379/1}"
export REDIS_CACHE_NAMESPACE="${REDIS_CACHE_NAMESPACE:-scanarr:cache:development}"

SIDEKIQ_PIDFILE="tmp/pids/sidekiq.pid"
mkdir -p tmp/pids

if [ -f "${SIDEKIQ_PIDFILE}" ]; then
  SIDEKIQ_PID="$(cat "${SIDEKIQ_PIDFILE}" 2>/dev/null)"

  if [ -n "${SIDEKIQ_PID}" ] && kill -0 "${SIDEKIQ_PID}" 2>/dev/null; then
    echo "Sidekiq is already running (pid ${SIDEKIQ_PID})."
    echo "Stop the existing worker or remove tmp/pids/sidekiq.pid."
    exit 1
  fi

  rm -f "${SIDEKIQ_PIDFILE}"
fi

if ! bundle exec ruby -rredis -e "Redis.new(url: ENV.fetch('SIDEKIQ_REDIS_URL')).ping" >/dev/null 2>&1; then
  echo "Redis is not reachable at SIDEKIQ_REDIS_URL=${SIDEKIQ_REDIS_URL}."
  echo "Start Redis first (e.g. brew services start redis or docker run -p 6379:6379 valkey/valkey:8)."
  exit 1
fi

# Let the debug gem allow remote connections,
# but avoid loading until `debugger` is called
export RUBY_DEBUG_OPEN="true"
export RUBY_DEBUG_LAZY="true"

exec foreman start -f Procfile.dev "$@"
