# Scanarr Docker Compose Configuration
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env

# ── Required ─────────────────────────────────────────────────────────────────

# Rails secret for session/cookie signing.
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Optional: only set this if you intentionally deploy with Rails encrypted credentials.
# Most self-hosters should leave it blank and use SECRET_KEY_BASE above.
RAILS_MASTER_KEY=

# PostgreSQL password for the scanarr user.
# Change this before exposing Scanarr beyond localhost.
SCANARR_DATABASE_PASSWORD=scanarr

# ── Optional ─────────────────────────────────────────────────────────────────

# Port to expose the web UI on (default: 3000).
# PORT=3000

# Local image tag used by docker compose build (defaults: scanarr:local).
# SCANARR_IMAGE=scanarr
# SCANARR_VERSION=local

# Public or internal URL used for generated links, host authorization, and
# Action Cable origins. Set this when serving through Caddy, Kamal proxy,
# Cloudflare Tunnel, Tailscale Funnel, or another reverse proxy.
# APP_URL=https://manga.example.com
#
# Optional overrides when you do not want to use APP_URL.
# APP_HOST=manga.example.com
# APP_PROTOCOL=https
# APP_PORT=443
#
# Comma- or space-separated hostnames/IPs accepted by Rails host authorization.
# Include every public domain, internal DNS name, and LAN IP users will browse.
# RAILS_HOSTS=manga.example.com,scanarr.home.arpa,192.168.1.50
#
# Set both to true when HTTPS is terminated by Caddy, Kamal proxy, Cloudflare,
# Traefik, nginx, or another trusted reverse proxy.
# RAILS_ASSUME_SSL=true
# RAILS_FORCE_SSL=true
#
# Optional explicit Action Cable websocket origins. Defaults to APP_URL when set.
# ACTION_CABLE_ALLOWED_REQUEST_ORIGINS=https://manga.example.com

# Optional Caddy profile. Start with: docker compose --profile caddy up -d
# CADDY_DOMAIN=manga.example.com
# HTTP_PORT=80
# HTTPS_PORT=443

# Number of Puma worker processes (default: 1).
# WEB_CONCURRENCY=1

# Number of threads per Puma worker (default: 5).
# RAILS_MAX_THREADS=5

# Number of Sidekiq threads (default: 5).
# SIDEKIQ_CONCURRENCY=5

# Redis URLs (defaults point at the docker-compose redis service).
# REDIS_URL=redis://redis:6379/0
# SIDEKIQ_REDIS_URL=redis://redis:6379/1
# ACTION_CABLE_REDIS_URL=redis://redis:6379/2

# Redis cache namespace.
# REDIS_CACHE_NAMESPACE=scanarr:cache:production

# Store downloaded pages, covers, and generated archives on local disk by default.
# Set ACTIVE_STORAGE_SERVICE=s3 for AWS S3, Cloudflare R2, MinIO, or another
# S3-compatible service.
# ACTIVE_STORAGE_SERVICE=local
# ACTIVE_STORAGE_LOCAL_ROOT=/rails/storage
#
# S3/R2/MinIO settings. For Cloudflare R2, use S3_REGION=auto and set
# S3_ENDPOINT to your account endpoint, for example:
# https://<account-id>.r2.cloudflarestorage.com
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true

# Log level: debug, info, warn, error, fatal (default: info).
# RAILS_LOG_LEVEL=info

# Disable authentication entirely (for single-user setups behind a VPN).
# SCANARR_DISABLE_AUTH=true
