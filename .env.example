# Scanarr Docker Compose Configuration
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env

# ── Required ─────────────────────────────────────────────────────────────────

# Rails secret for session/cookie signing.
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Optional: only set this if you intentionally deploy with Rails encrypted credentials.
# Most self-hosters should leave it blank and use SECRET_KEY_BASE above.
RAILS_MASTER_KEY=

# PostgreSQL password for the scanarr user.
# Change this before exposing Scanarr beyond localhost.
SCANARR_DATABASE_PASSWORD=scanarr

# ── Optional ─────────────────────────────────────────────────────────────────

# Port to expose the web UI on (default: 3000).
# PORT=3000

# Number of Puma worker processes (default: 1).
# WEB_CONCURRENCY=1

# Number of threads per Puma worker (default: 5).
# RAILS_MAX_THREADS=5

# Number of Sidekiq threads (default: 5).
# SIDEKIQ_CONCURRENCY=5

# Redis URLs (defaults point at the docker-compose redis service).
# REDIS_URL=redis://redis:6379/0
# SIDEKIQ_REDIS_URL=redis://redis:6379/1
# ACTION_CABLE_REDIS_URL=redis://redis:6379/2

# Redis cache namespace.
# REDIS_CACHE_NAMESPACE=scanarr:cache:production

# Log level: debug, info, warn, error, fatal (default: info).
# RAILS_LOG_LEVEL=info

# Disable authentication entirely (for single-user setups behind a VPN).
# SCANARR_DISABLE_AUTH=true
